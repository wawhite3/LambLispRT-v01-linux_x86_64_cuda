;;; rxrs-tests.scm -- R7RS section-by-section conformance tests.
;;; Evaluates representative expressions from each R7RS section and VERIFIES each
;;; result against its expected value (no longer a bare load-only smoke test).
;;; Copyright 2026 by Frobenius Norm LLC 2026-06-23 00:00:00
;;; Free for non-commercial use. Commercial use requires a license.
;;;
;;; Exposes top-level counters  rxrs-pass / rxrs-fail  for conform-runner.scm.
;;;
;;; chk: (chk id expected expr) -- evaluates expr (guarded), compares with equal?,
;;; bumps rxrs-pass / rxrs-fail, and on failure prints "  FAIL id: expected E got G".
;;; chk~: tolerant numeric compare for inexact results.
;;; cwv: collects a multiple-values result into a list for comparison.
;;;
;;; A handful of checks below encode the R7RS-correct value for cases where this
;;; build currently DIVERGES (assoc/comparator, exact rationalize, complex nan?/
;;; integer?, non-ASCII digit-value).  They are left to FAIL VISIBLY and are tracked
;;; in proposal_bug_registry_P88.md -- per policy, never skipped or marked xfail.

(define rxrs-pass 0)
(define rxrs-fail 0)
;; No known nonconformances here -- rxrs failures are real bugs (registered), never exceptions.
(define rxrs-exception 0)
(define rxrs-exception-expected 0)

;; FAIL lines carry the CHALLENGE form in the harness-parseable shape shared with the other
;; suites ("FAIL <id> | expr <form> | expected <e> | got <g>"), so the report's failures table can
;; show the expression that was evaluated rather than just an id.  The form has to be threaded in
;; from the `chk` macro: rxrs-check only ever sees a thunk.
(define (rxrs-fail! id expected got form)
  (set! rxrs-fail (+ rxrs-fail 1))
  (display "  FAIL ") (display id) (display " | expr ") (write form)
  (display " | expected ") (write expected)
  (display " | got ") (write got) (newline))

(define (rxrs-check id expected thunk30 form)
  (guard (e (#t (rxrs-fail! id expected 'exception form)))
    (let ((got (thunk30)))
      (if (equal? got expected)
          (set! rxrs-pass (+ rxrs-pass 1))
          (rxrs-fail! id expected got form)))))

(define-syntax chk
  (syntax-rules () ((chk id expected expr) (rxrs-check id expected (lambda () expr) (quote expr)))))

;; tolerant inexact compare (|got-expected| < tol)
(define (rxrs-check~ id expected tol thunk31 form)
  (guard (e (#t (rxrs-fail! id expected 'exception form)))
    (let ((got (thunk31)))
      (if (and (number? got) (< (abs (- got expected)) tol))
          (set! rxrs-pass (+ rxrs-pass 1))
          (rxrs-fail! id expected got form)))))
(define-syntax chk~
  (syntax-rules ()
    ((chk~ id expected tol expr) (rxrs-check~ id expected tol (lambda () expr) (quote expr)))))

;; collect a multiple-values producer into a list
(define-syntax cwv
  (syntax-rules () ((cwv expr) (call-with-values (lambda () expr) list))))

;; write-to-string: capture (write x) output -- exercises the PRINTER directly.
;; Several conformance bugs lived only in written form (invisible to value=value
;; checks): vector "#vector(...)" , bytevector "#bytevector(...)" , inexact reals
;; printed with no decimal point, and control chars as #\xNN instead of R7RS names.
(define (w->s x) (let ((p (open-output-string))) (write x p) (get-output-string p)))

