(chk "6.9-ref" 8 (bytevector-u8-ref (bytevector 1 1 2 3 5 8 13 21) 5))
(chk "6.9-set" (bytevector 1 3 3 4) (let ((bv (bytevector 1 2 3 4))) (bytevector-u8-set! bv 1 3) bv))
(chk "6.9-copy" (bytevector 3 4) (bytevector-copy (bytevector 1 2 3 4 5) 2 4))
(define bva (bytevector 1 2 3 4 5))
(define bvb (bytevector 10 20 30 40 50))
(bytevector-copy! bvb 1 bva 0 2)
(chk "6.9-copy!" (bytevector 10 1 2 40 50) bvb)
(chk "6.9-append" (bytevector 0 1 2 3 4 5) (bytevector-append (bytevector 0 1 2) (bytevector 3 4 5)))
(chk "6.9-utf8->s" "A" (utf8->string (bytevector #x41)))
(chk "6.9-s->utf8" (bytevector 206 187) (string->utf8 "\x03BB;"))
;;; bytevector WRITE form -- was "#bytevector(...)"; must be R7RS "#u8(...)"
(chk "6.9-w-bv"    "#u8(0 10 255)" (w->s (bytevector 0 10 255)))
(chk "6.9-w-empty" "#u8()"         (w->s (make-bytevector 0)))

(news ";;;6.10 Control features\n")
(chk "6.10-proc-car" #t (procedure? car))
(chk "6.10-proc-qcar" #f (procedure? 'car))
(chk "6.10-proc-lam" #t (procedure? (lambda (x) (* x x))))
(chk "6.10-proc-qlam" #f (procedure? '(lambda (x) (* x x))))
(chk "6.10-apply" 7 (apply + (list 3 4)))
(define compose (lambda (f g) (lambda args (f (apply g args)))))
(chk "6.10-compose" 30 ((compose sqrt *) 12 75))
(chk "6.10-map-cadr" '(b e h) (map cadr '((a b) (d e) (g h))))
(chk "6.10-map-expt" '(1 4 27 256 3125) (map (lambda (n) (expt n n)) '(1 2 3 4 5)))
;;; R7RS 6.10: map/for-each terminate at the SHORTEST list (was: error on unequal lengths)
(chk "6.10-map-uneq"  '(11 22) (map + '(1 2 3) '(10 20)))
(chk "6.10-map-uneq2" '(11 22) (map + '(1 2) '(10 20 30)))
(chk "6.10-map-3lst"  '(111 222) (map + '(1 2) '(10 20 30) '(100 200 300 400)))
(chk "6.10-fe-uneq"   3 (let ((n 0)) (for-each (lambda (a b) (set! n (+ n a))) '(1 2 3) '(10 20)) n))
(chk "6.10-map-count" '(1 2)
  (let ((count 0)) (map (lambda (ignored) (set! count (+ count 1)) count) '(a b))))
(chk "6.10-smap-fold" "abdegh" (string-map char-foldcase "AbdEgH"))
(chk "6.10-smap-incr" "IBM"
  (string-map (lambda (c) (integer->char (+ 1 (char->integer c)))) "HAL"))
(chk "6.10-smap-2" "StUdLyCaPs"
  (string-map (lambda (c k) ((if (eqv? k #\u) char-upcase char-downcase) c)) "studlycaps xxx" "ululululul"))
(chk "6.10-vmap-cadr" '#(b e h) (vector-map cadr '#((a b) (d e) (g h))))
(chk "6.10-vmap-expt" '#(1 4 27 256 3125) (vector-map (lambda (n) (expt n n)) '#(1 2 3 4 5)))
(chk "6.10-vmap-add" '#(5 7 9) (vector-map + '#(1 2 3) '#(4 5 6 7)))
(chk "6.10-vmap-count" '#(1 2)
  (let ((count 0)) (vector-map (lambda (ignored) (set! count (+ count 1)) count) '#(a b))))
(chk "6.10-for-each" '#(0 1 4 9 16)
  (let ((v (make-vector 5))) (for-each (lambda (i) (vector-set! v i (* i i))) '(0 1 2 3 4)) v))
(chk "6.10-sfor-each" '(101 100 99 98 97)
  (let ((v '())) (string-for-each (lambda (c) (set! v (cons (char->integer c) v))) "abcde") v))
(chk "6.10-vfor-each" '(0 1 4 9 16)
  (let ((v (make-list 5))) (vector-for-each (lambda (i) (list-set! v i (* i i))) '#(0 1 2 3 4)) v))

(display "rxrs-tests: ") (display rxrs-pass) (display " pass, ")
(display rxrs-fail) (display " fail\n")

