;;; UTF-8 / character-vs-byte indexing.  Every one of these passed while the string procedures
;;; were byte-indexed IF you only ever fed them ASCII -- which is why the defect survived three
;;; filings (B27, B47, B146).  The multi-byte cases are the ones that discriminate, and the
;;; WIDTH-CHANGING mutations below are the ones no other suite reaches: replacing a 1-byte
;;; character with a 3-byte one changes the string's byte length, so it exercises the in-place
;;; grow/shrink path (and, for a long string, the reallocate-and-repoint path) rather than a
;;; plain overwrite.
(chk "6.7-u8-length"   4 (string-length "\x03B1;\x03B2;\x03B3;\x03B4;"))
(chk "6.7-u8-ref"      #\x03B3 (string-ref "\x03B1;\x03B2;\x03B3;\x03B4;" 2))
(chk "6.7-u8-substr"   "\x03B2;\x03B3;" (substring "\x03B1;\x03B2;\x03B3;\x03B4;" 1 3))
(chk "6.7-u8-s2l"      (list #\x03B1 #\x03B2) (string->list "\x03B1;\x03B2;"))
(chk "6.7-u8-s2l-rng"  (list #\x03B2 #\x03B3) (string->list "\x03B1;\x03B2;\x03B3;\x03B4;" 1 3))
(chk "6.7-u8-scopy-rng" "\x03B2;\x03B3;" (string-copy "\x03B1;\x03B2;\x03B3;\x03B4;" 1 3))
(chk "6.7-u8-l2s"      "\x03B1;\x03B2;" (list->string (list #\x03B1 #\x03B2)))
(chk "6.7-u8-string"   "\x03B1;\x03B2;" (string #\x03B1 #\x03B2))
(chk "6.7-u8-mkstring" "\x03BB;\x03BB;\x03BB;" (make-string 3 #\x03BB))
(chk "6.7-u8-append"   "\x03B1;\x03B2;" (string-append "\x03B1;" "\x03B2;"))
(chk "6.7-u8-s2v"      (vector #\x03B1 #\x03B2) (string->vector "\x03B1;\x03B2;"))
(chk "6.7-u8-v2s"      "\x03B1;\x03B2;" (vector->string (vector #\x03B1 #\x03B2)))
(chk "6.7-u8-s2utf8"   4 (bytevector-length (string->utf8 "\x03B1;\x03B2;\x03B3;\x03B4;" 0 2)))
(chk "6.7-u8-roundtrip" "\x03B1;\x03B2;" (utf8->string (string->utf8 "\x03B1;\x03B2;")))
;; set!: 1 byte -> 2 bytes on a HEAP string (grows, reallocates), then back down (shrinks in place)
(define u8h (string-copy "abcdefghijklmnop"))
(string-set! u8h 0 #\x03BB)
(chk "6.7-u8-set-grow"    "\x03BB;bcdefghijklmnop" u8h)
(chk "6.7-u8-set-grow-len" 16 (string-length u8h))
(string-set! u8h 0 #\Z)
(chk "6.7-u8-set-shrink"  "Zbcdefghijklmnop" u8h)
;; set! on a short IMMEDIATE string, where growth is bounded by the cell's own capacity
(define u8i (string-copy "ab"))
(string-set! u8i 0 #\x03BB)
(chk "6.7-u8-set-imm"     "\x03BB;b" u8i)
;; set! that pushes an IMMEDIATE string PAST the cell's inline capacity, forcing the in-situ
;; T_STR_IMM -> T_STR_HEAP promotion.  The capacity is sizeof(Cell)-3, which differs by target
;; (9 bytes on the 12-byte ESP32 cell, 21 on a 64-bit host), so both lengths are exercised: each
;; target promotes on one of them and merely grows inline on the other, and the ANSWER must be
;! identical either way.  A bad promotion shows up here as a truncated or garbage string.
(define u8p9 (string-copy "abcdefghi"))
(string-set! u8p9 0 #\x03BB)
(chk "6.7-u8-promote-9"    "\x03BB;bcdefghi" u8p9)
(chk "6.7-u8-promote-9-len" 9 (string-length u8p9))
(define u8p21 (string-copy "abcdefghijklmnopqrstu"))
(string-set! u8p21 20 #\x03BB)
(chk "6.7-u8-promote-21"   "abcdefghijklmnopqrst\x03BB;" u8p21)
(chk "6.7-u8-promote-21-len" 21 (string-length u8p21))
;; and the promoted cell must still behave as a normal mutable string afterwards
(string-set! u8p9 0 #\A)
(chk "6.7-u8-promote-reuse" "Abcdefghi" u8p9)
;; fill! with a wider character, then a narrower one
(define u8f (string-copy "abcdefghij"))
(string-fill! u8f #\x03BB 2 5)
(chk "6.7-u8-fill-grow"   "ab\x03BB;\x03BB;\x03BB;fghij" u8f)
(string-fill! u8f #\z 2 5)
(chk "6.7-u8-fill-shrink" "abzzzfghij" u8f)
;; copy! where source and destination characters differ in byte width
(define u8t (string-copy "abcdefghij"))
(string-copy! u8t 1 "\x03BB;\x03BC;" 0 2)
(chk "6.7-u8-copy-grow"   "a\x03BB;\x03BC;defghij" u8t)
(chk "6.7-u8-copy-len"    10 (string-length u8t))
;; copy! from a string INTO ITSELF: the widening path frees the old buffer, so the source span
;; has to be snapshotted first or it dangles.
(define u8s (string-copy "abcdefgh"))
(string-copy! u8s 0 u8s 2 5)
(chk "6.7-u8-copy-self"   "cdedefgh" u8s)

