(define when
  (syntax-rules ()
    ((when test)
     (if #f #f))
    ((when test body ...)
     (if test (begin body ...) (if #f #f)))))
(define unless
  (syntax-rules ()
    ((unless test)
     (if #f #f))
    ((unless test body ...)
     (if (not test) (begin body ...) (if #f #f)))))
(define case
  (syntax-rules (else =>)
    ((case key)
     (if #f #f))
    ((case key (else => proc))
     (proc key))
    ((case key (else expr ...))
     (begin expr ...))
    ((case key ((datum ...) => proc) rest ...)
     (if (memv key (quote (datum ...)))
       (proc key)
       (case key rest ...)))
    ((case key ((datum ...) expr ...) rest ...)
     (if (memv key (quote (datum ...)))
       (begin expr ...)
       (case key rest ...)))))
(define letrec
  (syntax-rules ()
    ((letrec (binding ...))
     (error "letrec: empty body -- a letrec body needs at least one expression (R7RS 4.2.2)"))
    ((letrec () body ...)
     (let () body ...))
    ((letrec ((var init) ...) body ...)
     (let ((var #f) ...)
       (set! var init) ...
       body ...))))
(define letrec*
  (syntax-rules ()
    ((letrec* (binding ...))
     (error "letrec*: empty body -- a letrec* body needs at least one expression (R7RS 4.2.2)"))
    ((letrec* () body ...)
     (let () body ...))
    ((letrec* ((var init) ...) body ...)
     (let* ((var #f) ...)
       (set! var init) ...
       body ...))))
(define let-values
  (syntax-rules ()
    ((let-values () body ...)
     (begin body ...))
    ((let-values ((formals expr) rest ...) body ...)
     (call-with-values (lambda () expr)
       (lambda formals (let-values (rest ...) body ...))))))
(define let*-values
  (syntax-rules ()
    ((let*-values () body ...)
     (begin body ...))
    ((let*-values ((formals expr) rest ...) body ...)
     (call-with-values (lambda () expr)
       (lambda formals (let*-values (rest ...) body ...))))))
