(chk "6.7-u8-set-grow-len" 16 (string-length u8h))
(string-set! u8h 0 #\Z)
(chk "6.7-u8-set-shrink"  "Zbcdefghijklmnop" u8h)
(define u8i (string-copy "ab"))
(string-set! u8i 0 #\x03BB)
(chk "6.7-u8-set-imm"     "\x03BB;b" u8i)
