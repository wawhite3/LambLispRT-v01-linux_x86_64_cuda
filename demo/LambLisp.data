(define (bench-proc-list)
  (map (lambda (e) (cons (car e) (eval (cdr e) (interaction-environment)))) bench-table))
(define (ncg-native-count)
  (let loop ((fs (bench-proc-list)) (n 0) (total 0))
    (if (null? fs)
      (cons n total)
      (let ((sz (ncg-code-size (cdr (car fs)))))
        (loop (cdr fs) (if (and sz (> sz 0)) (+ n 1) n) (+ total 1))))))
(define (run-suite label)
  (if (not bench-registration-ok) (run-suite/refused label) (run-suite/go label)))
(define (run-suite/refused label)
  (display "=== ") (display label)
  (display " REFUSED: bench registration incomplete -- see BENCH-UNREGISTERED above ===\n"))
(define (run-suite/go label)
  (display "=== ") (display label) (display " ===\n")
  (when (defined? 'execution-modes)
    (display "EXEC-MODES ") (display label) (display " ") (display (execution-modes)) (newline))
  (when (string=? label "NCG")
    (let* ((nt (ncg-native-count)) (n (car nt)))
      (display "NCG-NATIVE-PROCS ") (display n) (display " of ") (display (cdr nt))
      (when (= n 0)
        (display "  *** NCG TIER DID NOT RUN -- these timings are the fallback tier, not native code ***"))
        (newline)
      (when (< n (cdr nt))
        (display "NCG-NOT-NATIVE ")
        (let loop ((fs (bench-proc-list)))
          (if (not (null? fs))
            (begin
              (let ((sz (ncg-code-size (cdr (car fs)))))
                (if (or (not sz) (= sz 0))
                  (begin (display (car (car fs))) (display " "))))
              (loop (cdr fs)))))
        (newline)))
      (when (defined? 'ncg-exec-pool-tiers)
        (display "NCG-POOL-TIERS ") (display (ncg-exec-pool-tiers)) (newline)))
  (when (and (string=? label "NCG") (defined? 'ncg-code-size))
    (for-each
      (lambda (r)
        (for-each
          (lambda (sym)
            (let* ((pr (eval sym (interaction-environment)))
                   (sz (ncg-code-size pr)))
              (display "NCG-ROW-CODE ") (display (row-name r))
              (display " ") (display sym)
              (display " ") (display (if sz sz 0)) (newline)))
          (row-procs r)))
      bench-rows))
  (for-each (lambda (r) (bench-timed/v (car r) (car (cdr r)) (car (cdr (cdr r))))) bench-rows))
(define (print-size-report)
  (define bench-fns (bench-proc-list))
  (define cell-sz (lamb-cell-size))
  (define (pad-num n width)
    (let* ((s (number->string n))
           (pad (max 1 (- width (string-length s)))))
      (string-append (make-string pad #\space) s)))
  (define (display-col val width)
    (if val
      (display (pad-num val width))
      (display (make-string width #\-))))
  (define (ratio-str num denom)
    (if (and num denom (> denom 0))
      (let* ((r   (round (/ (* num 100) denom)))
             (int (quotient  r 100))
             (fra (remainder r 100))
             (fstr (if (< fra 10)
                     (string-append "0" (number->string fra))
                     (number->string fra))))
        (string-append (number->string int) "." fstr))
      "-"))
  (display "=== Size Report (bytes) ===\n")
  (display "function          interp-B  bc-B  nc-B  bc/in  nc/in\n")
  (display "----------------- --------  ----  ----  -----  -----\n")
  (for-each
    (lambda (entry)
      (let* ((name  (car entry))
             (proc  (cdr entry))
             (a-ent (assoc name bench-ast-counts))
             (ast   (if a-ent (cdr a-ent) #f))
             (in-b  (if ast (* ast cell-sz) #f))
             (bc    (bc-opcode-count proc))
             (nc    (ncg-code-size   proc)))
        (let* ((bc-r (ratio-str bc in-b))
               (nc-r (ratio-str nc in-b)))
          (display name) (display "  ")
          (display-col in-b 8)  (display "  ")
          (display-col bc   4)  (display "  ")
          (display-col nc   4)  (display "  ")
          (display (string-append (make-string (max 0 (- 5 (string-length bc-r))) #\space) bc-r))
          (display "  ")
          (display (string-append (make-string (max 0 (- 5 (string-length nc-r))) #\space) nc-r))
          (newline))))
    bench-fns)
  (newline))
