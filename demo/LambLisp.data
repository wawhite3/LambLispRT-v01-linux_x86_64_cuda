(syslog "free stack is ~a\n" (Platform.free-stack))
(if (or (< x 1) (< y 1)) 1
(+ (hofq2 (- x (hofq2 (sub1 x) y)) y)
(hofq2 x (- y (hofq2 x (sub1 y))))
)
)
)

