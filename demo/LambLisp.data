(define (current-ms) 0)
(define (bench name thunk11 expected)
  (let* ((t0     (current-ms))
         (result (thunk11))
         (dt     (- (current-ms) t0)))
    (display name) (display ":  ")
    (display result)
    (display (if (or (not expected) (equal? result expected)) "  OK" "  FAIL"))
    (display "  ")
    (display dt) (display " ms")
    (newline)
    (or (not expected) (equal? result expected))))
(define (fib n)
  (if (< n 2) n
      (+ (fib (- n 1)) (fib (- n 2)))))
(define (fib-iter n)
  (let loop ((i n) (a 0) (b 1))
    (if (= i 0) a
        (loop (- i 1) b (+ a b)))))
(define (fib-iter-bench reps)
  (let loop ((k reps))
    (if (= k 0) (fib-iter 92)
        (begin (fib-iter 92) (loop (- k 1))))))
(define (tak x y z)
  (if (not (< y x)) z
      (tak (tak (- x 1) y z)
           (tak (- y 1) z x)
           (tak (- z 1) x y))))
(define (list-prepend-bench n)
  (let loop ((i 0) (acc (list)))
    (if (= i n)
        (length acc)
        (loop (+ i 1) (cons i acc)))))
(define (make-iota-vec n)
  (let ((v (make-vector n)))
    (let loop ((i 0))
      (if (< i n)
          (begin
            (vector-set! v i (+ i 1))
            (loop (+ i 1)))))
    v))
(define (qsort-vec! v)
  (let qsort-h! ((lo 0) (hi (- (vector-length v) 1)))
    (if (< lo hi)
      (let ((pivot (vector-ref v (quotient (+ lo hi) 2))))
        (let part ((i lo) (j hi))
          (let lp-i ((i i))
            (if (and (<= i hi) (< (vector-ref v i) pivot)) (lp-i (+ i 1))
                (let lp-j ((j j))
                  (if (and (>= j lo) (> (vector-ref v j) pivot)) (lp-j (- j 1))
                      (if (<= i j)
                          (begin
                            (let ((t (vector-ref v i)))
                              (vector-set! v i (vector-ref v j))
                              (vector-set! v j t))
                            (part (+ i 1) (- j 1)))
                          (begin
                            (qsort-h! lo j)
                            (qsort-h! i hi)))))))))))
  v)
(define (vector-sum v)
  (let ((n (vector-length v)))
    (let loop ((i 0) (acc 0))
      (if (= i n) acc
          (loop (+ i 1) (+ acc (vector-ref v i)))))))
(define (vector-sorted? v)
  (let ((n (vector-length v)))
    (let loop ((i 1))
      (if (>= i n) #t
          (if (> (vector-ref v (- i 1)) (vector-ref v i)) #f
              (loop (+ i 1)))))))
(define (make-adder n) (lambda (x) (+ x n)))
(define (closure-bench n)
  (let loop ((i n) (acc 0))
    (if (= i 0) acc
        (loop (- i 1) ((make-adder i) acc)))))
(define (ackermann m n)
  (cond ((= m 0) (+ n 1))
        ((= n 0) (ackermann (- m 1) 1))
        (else    (ackermann (- m 1) (ackermann m (- n 1))))))
