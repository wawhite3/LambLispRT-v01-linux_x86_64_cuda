(check "case/else"        'c  (case 9 ((1) 'a) ((2) 'b) (else 'c)))
(check "case/multi-datum" 'ab (case 2 ((1 3) 'odd) ((2 4) 'ab) (else 'other)))
(check "case/char"        'y  (case #\b ((#\a) 'x) ((#\b) 'y) (else 'z)))
(check "case/multi-body"  3   (case 1 ((1) 1 2 3) (else 0)))
