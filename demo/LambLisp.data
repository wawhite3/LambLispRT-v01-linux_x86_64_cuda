(define cvs-reps 5)
(define cvs-iters 2000)
(define cvs-cpp-env (scheme-report-environment 5))
(define (cvs-time-one form env iters)
  (let ((t0 (millis)))
    (let loop ((i iters))
      (if (> i 0) (begin (eval form env) (loop (- i 1))) #f))
    (- (millis) t0)))
(define (cvs-best form env)
  (let loop ((n cvs-reps) (best -1))
    (if (= n 0) best
        (let ((ms (cvs-time-one form env cvs-iters)))
          (loop (- n 1) (if (or (< best 0) (< ms best)) ms best))))))
(define (cvs-row name form inlined?)
  (let* ((scm (cvs-best form (interaction-environment)))
         (cpp (cvs-best form cvs-cpp-env)))
    (display "CVS ") (display name)
    (display " scheme=") (display scm) (display "ms")
    (display " cpp=")    (display cpp) (display "ms")
    (display " inlined-when-scheme=") (display (if inlined? "yes" "no"))
    (display " faster=")
    (display (cond ((and (> scm 0) (> cpp 0) (< scm cpp)) "SCHEME")
                   ((and (> scm 0) (> cpp 0) (> scm cpp)) "CPP")
                   (else "level-or-unresolved")))
    (newline)
    (list name scm cpp inlined?)))
(define cvs-control (cvs-row "if[CONTROL-not-shadowed]" '(if #t 1 2) #f))
(define cvs-floor
  (let ((a (cadr cvs-control)) (b (caddr cvs-control)))
    (if (and (> a 0) (> b 0)) (abs (- a b)) -1)))
(display "CVS floor: the unshadowed control differs by ") (display cvs-floor)
(display "ms -- env shape plus eval harness.  No row below this is attributable.")
(newline)
(define cvs-inlined
  (list (cvs-row "when"    '(when #t 1)                    #t)
        (cvs-row "unless"  '(unless #f 1)                  #t)
        (cvs-row "case"    '(case 2 ((1) 1) ((2) 2) (else 3)) #t)
        (cvs-row "letrec"  '(letrec ((x 1)) x)             #t)))
(define cvs-plain
  (list (cvs-row "quasiquote"   '(quasiquote (1 2 3))      #f)
        (cvs-row "let-values"   '(let-values (((a) (values 1))) a) #f)
        (cvs-row "letrec*"      '(letrec* ((x 1)) x)       #f)
        (cvs-row "let*-values"  '(let*-values (((a) (values 1))) a) #f)))
(define (cvs-count pred rows)
  (let loop ((r rows) (n 0))
    (if (null? r) n (loop (cdr r) (if (pred (car r)) (+ n 1) n)))))
(define (cvs-scheme-wins? row)
  (let ((scm (cadr row)) (cpp (caddr row)))
    (and (> scm 0) (> cpp 0) (< scm cpp) (> (abs (- scm cpp)) cvs-floor))))
(define cvs-inlined-scheme-wins (cvs-count cvs-scheme-wins? cvs-inlined))
(if (< cvs-floor 0)
    (begin (display "SKIP cpp-vs-scheme: the control did not produce two usable times, so no row")
           (display " here separates implementation from environment") (newline))
    (begin
      (if (>= cvs-inlined-scheme-wins 3)
          (begin (display "PASS cpp-vs-scheme: Scheme wins ")
                 (display cvs-inlined-scheme-wins)
                 (display " of 4 compiler-inlined forms -- the inline path is being taken")
                 (newline))
          (begin (display "FAIL cpp-vs-scheme: Scheme wins only ")
                 (display cvs-inlined-scheme-wins)
                 (display " of 4 compiler-inlined forms.  READ THIS AS A COMPILER FINDING, NOT AS A")
                 (display " WIN FOR C++: when/unless/case/letrec are supposed to expand at compile")
                 (display " time and leave no call, so a C++ mop3 call beating them means the")
                 (display " inline path is not being taken.  Check macroexpand1 reaches these names")
                 (display " and that the reader is not substituting the base-env cell first.")
                 (newline)))
      (display "CVS summary: inlined-four scheme-wins=") (display cvs-inlined-scheme-wins)
      (display "/4  non-inlined scheme-wins=")
      (display (cvs-count cvs-scheme-wins? cvs-plain)) (display "/")
      (display (length cvs-plain))
      (display "  (a non-inlined row favouring Scheme is the one worth explaining)")
      (newline)))
