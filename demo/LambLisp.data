(define ps-ident1 1)
(define ps-ident2 2)
(define ps-ident3 3)
(define (ps-record ptr discr enum intval str) (list ptr discr enum intval str))
(define (ps-ptr r)   (car r))
(define (ps-discr r) (cadr r))
(define (ps-enum r)  (caddr r))
(define (ps-int r)   (cadddr r))
(define (ps-func1 c1 c2) (if (eqv? c1 c2) ps-ident1 ps-ident2))
(define (ps-func2 s1 s2)
  (if (string=? s1 s2) 1 0))
(define (ps-func3 e) (if (eqv? e ps-ident3) 1 0))
(define (ps-proc7 a b) (+ a b 2))
(define (ps-proc6 e)
  (cond ((eqv? e ps-ident1) ps-ident2)
        ((eqv? e ps-ident2) ps-ident3)
        (else ps-ident1)))
(define (ps-proc4 bool) (if bool ps-ident1 ps-ident2))
(define (ps-proc5) ps-ident1)
(define (ps-proc8 arr1 arr2 idx val)
  (let ((i (+ idx 1)))
    (vector-set! arr1 i val)
    (vector-set! arr2 i (+ val 1))
    (+ (vector-ref arr1 i) (vector-ref arr2 i))))
(define (ps-proc1 r)
  (ps-record (ps-ptr r) (ps-discr r) (ps-proc6 (ps-enum r)) (+ (ps-int r) 1) "PROC1"))
(define (psv-record ptr discr enum intval str)
  (let ((v (make-vector 5)))
    (vector-set! v 0 ptr) (vector-set! v 1 discr) (vector-set! v 2 enum)
    (vector-set! v 3 intval) (vector-set! v 4 str)
    v))
(define (psv-ptr r)   (vector-ref r 0))
(define (psv-discr r) (vector-ref r 1))
(define (psv-enum r)  (vector-ref r 2))
(define (psv-int r)   (vector-ref r 3))
(define (psv-proc1 r)
  (psv-record (psv-ptr r) (psv-discr r) (ps-proc6 (psv-enum r)) (+ (psv-int r) 1) "PROC1"))
(define (pystone-vec n)
  (let ((arr1 (make-vector 8 0))
        (arr2 (make-vector 8 0))
        (acc  0))
    (let loop ((i 0) (enum ps-ident1) (acc acc))
      (if (= i n)
          acc
          (let* ((r1   (psv-record (list) 0 enum i "PYSTONE"))
                 (r2   (psv-proc1 r1))
                 (e2   (ps-proc6 (psv-enum r2)))
                 (f1   (ps-func1 (psv-int r2) i))
                 (f2   (ps-func2 "PYSTONE" "PYSTONE"))
                 (f3   (ps-func3 e2))
                 (p7   (ps-proc7 f1 f2))
                 (p8   (ps-proc8 arr1 arr2 (modulo i 7) i))
                 (p4   (ps-proc4 (= f2 1)))
                 (p5   (ps-proc5)))
            (loop (+ i 1) e2
                  (+ acc f1 f2 f3 p7 p8 p4 p5 (psv-int r2))))))))
(define (pystone n)
  (let ((arr1 (make-vector 8 0))
        (arr2 (make-vector 8 0))
        (acc  0))
    (let loop ((i 0) (enum ps-ident1) (acc acc))
      (if (= i n)
          acc
          (let* ((r1   (ps-record (list) 0 enum i "PYSTONE"))
                 (r2   (ps-proc1 r1))
                 (e2   (ps-proc6 (ps-enum r2)))
                 (f1   (ps-func1 (ps-int r2) i))
                 (f2   (ps-func2 "PYSTONE" "PYSTONE"))
                 (f3   (ps-func3 e2))
                 (p7   (ps-proc7 f1 f2))
                 (p8   (ps-proc8 arr1 arr2 (modulo i 7) i))
                 (p4   (ps-proc4 (= f2 1)))
                 (p5   (ps-proc5)))
            (loop (+ i 1) e2
                  (+ acc f1 f2 f3 p7 p8 p4 p5 (ps-int r2))))))))
(define hx-neighbours
  '((0 1 2 3 4 5 6)
    (1 0 2 6)
    (2 0 1 3)
    (3 0 2 4)
    (4 0 3 5)
    (5 0 4 6)
    (6 0 1 5)))
(define (hx-nbrs i)
  (let loop ((l hx-neighbours))
    (cond ((null? l) (list))
          ((= (caar l) i) (cdar l))
          (else (loop (cdr l))))))
(define (hx-count board i)
  (let loop ((ns (hx-nbrs i)) (n 0))
    (if (null? ns)
        n
        (loop (cdr ns) (if (vector-ref board (car ns)) (+ n 1) n)))))
(define (hx-ok? board full?)
  (let loop ((i 0))
    (cond ((= i 7) #t)
          ((not (vector-ref board i)) (loop (+ i 1)))
          (else
           (let ((want (vector-ref board i))
                 (have (hx-count board i)))
             (if full?
                 (if (= want have) (loop (+ i 1)) #f)
                 (if (<= have want) (loop (+ i 1)) #f)))))))
(define (hx-search board tiles idx)
  (cond ((null? tiles) (if (hx-ok? board #t) 1 0))
        ((= idx 7) 0)
        (else
         (let ((here
                (if (vector-ref board idx)
                    0
                    (begin
                      (vector-set! board idx (car tiles))
                      (let ((sub (if (hx-ok? board #f)
                                     (hx-search board (cdr tiles) 0)
                                     0)))
                        (vector-set! board idx #f)
                        sub)))))
           (+ here (hx-search board tiles (+ idx 1)))))))
(define (hexiom tiles)
  (hx-search (make-vector 7 #f) tiles 0))
