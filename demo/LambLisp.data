(check "ncg list-sum nil"       0   (ncg-list-sum '()))
(check "ncg list-sum 1..5"     15   (ncg-list-sum '(1 2 3 4 5)))
(printf "--- 13. idempotency ---\n")
(define ncg-double (ncg-compile-lambda (lambda (x) (* x 2))))
(ncg-compile ncg-double)
