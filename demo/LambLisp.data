(ncg-compile f)
(define was (ncg-compiled? f))
(define sz  (ncg-code-size f))
(display "compiled-after-compile=") (display was) (display " size=") (display sz) (newline)
(define rel (ncg-demote! f))
(display "demote-returned=") (display rel) (newline)
(display "compiled-after-demote=") (display (ncg-compiled? f)) (newline)
(display "still-runs=") (display (f 41)) (newline)
(define again (ncg-demote! f))
(display "second-demote=") (display again) (newline)
(if (and was (not (ncg-compiled? f)) (eqv? rel sz) (= (f 41) 42) (eq? again #f))
    (begin (display "PASS ncg-demote! released ") (display rel)
           (display " bytes, the proc still runs, and a second demote reports #f") (newline))
    (begin (display "FAIL ncg-demote!: was=") (display was) (display " rel=") (display rel)
           (display " sz=") (display sz) (display " again=") (display again) (newline)))
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-11
(define ncgdiff-total 0)
(define ncgdiff-fails 0)
(define (ncg-diff name make-lam . args)
  (set! ncgdiff-total (+ ncgdiff-total 1))
  (let* ((interp (apply (make-lam) args))
         (byte   (apply (procedure->bytecode (make-lam)) args))
         (native (apply (ncg-compile (procedure->bytecode (make-lam))) args)))
    (if (and (equal? interp byte) (equal? interp native))
        (printf "PASS ~a\n" name)
        (begin
          (set! ncgdiff-fails (+ ncgdiff-fails 1))
          (printf "FAIL ~a  interp=~a  bytecode=~a  native=~a\n"
                  name interp byte native)))))
(printf "--- NCG differential: interpreter vs bytecode vs native ---\n")
(ncg-diff "integer? exact"      (lambda () (lambda (v) (integer? v))) 7)
(ncg-diff "integer? int64"      (lambda () (lambda (v) (integer? v))) 4294967296)
(ncg-diff "integer? bignum"     (lambda () (lambda (v) (integer? v))) (* 99999999999 99999999999))
(ncg-diff "integer? 2.0"        (lambda () (lambda (v) (integer? v))) 2.0)
(ncg-diff "integer? 0.0"        (lambda () (lambda (v) (integer? v))) 0.0)
(ncg-diff "integer? -4.0"       (lambda () (lambda (v) (integer? v))) -4.0)
(ncg-diff "integer? 2.5"        (lambda () (lambda (v) (integer? v))) 2.5)
(ncg-diff "zero? float"         (lambda () (lambda (v) (zero? v))) 0.0)
(ncg-diff "negative? -0.0"      (lambda () (lambda (v) (negative? v))) -0.0)
(ncg-diff "boolean? #f"         (lambda () (lambda (v) (boolean? v))) #f)
(ncg-diff "add overflow"        (lambda () (lambda (a b) (+ a b))) 2147483647 1)
(ncg-diff "add underflow"       (lambda () (lambda (a b) (+ a b))) -2147483648 -1)
(ncg-diff "sub underflow"       (lambda () (lambda (a b) (- a b))) -2147483648 1)
(ncg-diff "mul overflow"        (lambda () (lambda (a b) (* a b))) 65536 65536)
(ncg-diff "mul max*max"         (lambda () (lambda (a b) (* a b))) 2147483647 2147483647)
(ncg-diff "mul min*-1"          (lambda () (lambda (a b) (* a b))) -2147483648 -1)
(ncg-diff "cache low edge"      (lambda () (lambda (a b) (+ a b))) -2049 0)
(ncg-diff "cache high edge"     (lambda () (lambda (a b) (+ a b))) 4096 1)
(ncg-diff "cache mid"           (lambda () (lambda (a b) (- a b))) 0 2048)
(ncg-diff "modulo -7 3"         (lambda () (lambda (a b) (modulo a b))) -7 3)
(ncg-diff "modulo 7 -3"         (lambda () (lambda (a b) (modulo a b))) 7 -3)
(ncg-diff "quotient -7 3"       (lambda () (lambda (a b) (quotient a b))) -7 3)
(ncg-diff "< int float"         (lambda () (lambda (a b) (< a b))) 1 1.5)
(ncg-diff "eqv? 0.0 -0.0"       (lambda () (lambda (a b) (eqv? a b))) 0.0 -0.0)
(ncg-diff "= 1 1.0"             (lambda () (lambda (a b) (= a b))) 1 1.0)
(ncg-diff "cadr"                (lambda () (lambda (l) (cadr l))) (list 1 2 3))
(ncg-diff "vector-ref"          (lambda () (lambda (v i) (vector-ref v i))) (vector 1 2 3) 2)
(ncg-diff "named let sum"       (lambda () (lambda (n) (let loop ((i 0) (a 0)) (if (>= i n) a (loop (+ i 1) (+ a i)))))) 1000)
(ncg-diff "loop to bignum"      (lambda () (lambda (n) (let loop ((i 0) (a 1)) (if (>= i n) a (loop (+ i 1) (* a 3)))))) 40)
(ncg-diff "recursive fib"       (lambda () (lambda (n) (let f ((n n)) (if (< n 2) n (+ (f (- n 1)) (f (- n 2))))))) 18)
(ncg-diff "cond else"           (lambda () (lambda (x) (cond ((< x 0) 'neg) ((= x 0) 'zero) (else 'pos)))) 0)
(ncg-diff "mul 46340^2 fits"    (lambda () (lambda (a b) (* a b))) 46340 46340)
(ncg-diff "mul 46341^2 ovf"     (lambda () (lambda (a b) (* a b))) 46341 46341)
(ncg-diff "mul -46340^2 fits"   (lambda () (lambda (a b) (* a b))) -46340 46340)
(ncg-diff "mul -46341^2 ovf"    (lambda () (lambda (a b) (* a b))) -46341 46341)
(ncg-diff "mul int32max*1"      (lambda () (lambda (a b) (* a b))) 2147483647 1)
(ncg-diff "mul int32min*1"      (lambda () (lambda (a b) (* a b))) -2147483648 1)
(ncg-diff "mul 65535*65537 ovf" (lambda () (lambda (a b) (* a b))) 65535 65537)
(ncg-diff "mul 64*64 = 4096 in"  (lambda () (lambda (a b) (* a b))) 64 64)
(ncg-diff "mul 64*65 = 4160 out" (lambda () (lambda (a b) (* a b))) 64 65)
(ncg-diff "mul -32*64 = -2048 in"  (lambda () (lambda (a b) (* a b))) -32 64)
(ncg-diff "mul -3*683 = -2049 out" (lambda () (lambda (a b) (* a b))) -3 683)
(ncg-diff "mul 3*4"             (lambda () (lambda (a b) (* a b))) 3 4)
(ncg-diff "mul -3*4"            (lambda () (lambda (a b) (* a b))) -3 4)
(ncg-diff "mul 3*-4"            (lambda () (lambda (a b) (* a b))) 3 -4)
(ncg-diff "mul -3*-4"           (lambda () (lambda (a b) (* a b))) -3 -4)
(ncg-diff "mul by 1"            (lambda () (lambda (a b) (* a b))) 3 1)
(ncg-diff "mul by 0"            (lambda () (lambda (a b) (* a b))) 12345 0)
(ncg-diff "mul 0*0"             (lambda () (lambda (a b) (* a b))) 0 0)
(ncg-diff "mul-loop in cache"   (lambda () (lambda (n) (let loop ((i 1) (a 0)) (if (> i n) a (loop (+ i 1) (* i 2)))))) 500)
(ncg-diff "mul-loop crossing"   (lambda () (lambda (n) (let loop ((i 1) (a 0)) (if (> i n) a (loop (+ i 1) (* i i)))))) 500)
(printf "NCG-DIFFERENTIAL: ~a cases, ~a divergent\n" ncgdiff-total ncgdiff-fails)
;;; Copyright 2026 by Frobenius Norm LLC 2026-08-30 17:00:00
(define ab-esc (string (integer->char #x1b)))
(define (ab-news fmt . args)
  (apply syslog (string-append ab-esc "[32m" fmt ab-esc "[97m") args))
(define (ab-warn fmt . args)
  (apply syslog (string-append ab-esc "[33m" fmt ab-esc "[97m") args))
(define (ab-us thunk21)
  (let ((t0 (micros)))
    (thunk21)
    (- (micros) t0)))
(define (ab-min3 thunk22)
  (let* ((a (ab-us thunk22)) (b (ab-us thunk22)) (c (ab-us thunk22)))
    (if (< a b) (if (< a c) a c) (if (< b c) b c))))
(define (ab-compile! name src fuse?)
  (let ((prev (ncg-fuse! fuse?))
        (env  (interaction-environment)))
    (eval src env)
    (eval (list 'define name (list 'ncg-compile (list 'procedure->bytecode name))) env)
    (ncg-fuse! prev)
    (ncg-compiled? (eval name env))))
(define ab-rows 0)
(define ab-bad  0)
(define (ab-run name src call expect)
  (let* ((env      (interaction-environment))
         (thunk23    (lambda () (eval call env)))
         (ok-off   (ab-compile! name src #f))
         (val-off  (eval call env))
         (us-off   (ab-min3 thunk23))
         (ok-on    (ab-compile! name src #t))
         (val-on   (eval call env))
         (us-on    (ab-min3 thunk23)))
    (set! ab-rows (+ ab-rows 1))
    (cond
      ((not (equal? val-off expect))
       (set! ab-bad (+ ab-bad 1))
       (ab-warn "BAD ~a fusion OFF gave ~a, expected ~a\n" name val-off expect))
      ((not (equal? val-on expect))
       (set! ab-bad (+ ab-bad 1))
       (ab-warn "BAD ~a fusion ON gave ~a, expected ~a\n" name val-on expect))
      (else
        (ab-news "~a  OFF ~a us   ON ~a us   delta ~a%~a\n"
                 name us-off us-on
                 (if (= us-off 0) 0 (quotient (* 100 (- us-on us-off)) us-off))
                 (if (and ok-off ok-on) "" "   [WARNING: not NCG-compiled -- timing is not a fusion A/B]"))))))
(ab-news "\n=== P165 NCG fusion A/B (min of 3, one binary) ===\n")
(ab-run 'ab-fib
        '(define (ab-fib n) (if (< n 2) n (+ (ab-fib (- n 1)) (ab-fib (- n 2)))))
        '(ab-fib 33)
        3524578)
(ab-run 'ab-tak
        '(define (ab-tak x y z)
           (if (not (< y x)) z
               (ab-tak (ab-tak (- x 1) y z) (ab-tak (- y 1) z x) (ab-tak (- z 1) x y))))
        '(ab-tak 24 16 8)
        9)
(ab-run 'ab-ack
        '(define (ab-ack m n)
           (cond ((= m 0) (+ n 1))
                 ((= n 0) (ab-ack (- m 1) 1))
                 (else    (ab-ack (- m 1) (ab-ack m (- n 1))))))
        '(ab-ack 3 7)
        1021)
(if (= ab-bad 0)
  (ab-news "~a benchmarks, all results identical OFF vs ON\n" ab-rows)
  (ab-warn "~a benchmarks, ~a produced a WRONG result -- fusion is not correctness-neutral\n"
           ab-rows ab-bad))
(ab-news "--- ncg-fusion-ab done ---\n")
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-21
(define f4g-was-quiet (quiet))
(define (f4g-n2s x) (if x (number->string x) "NIL"))
(define (f4g-callee x) (* x 2))
(define (f4g-mk) (lambda (n) (+ (f4g-callee n) (f4g-callee n) (f4g-callee n) (f4g-callee n))))
(define (f4g-tail-mk) (lambda (n) (f4g-callee n)))
(define (f4g-one mk fuse args)
  (let ((prev (ncg-fuse! fuse)))
    (let ((p (ncg-compile (procedure->bytecode (mk)))))
      (ncg-fuse! prev)
      (list (ncg-code-size p) (apply p args) (ncg-compiled? p)))))
(define (f4g-report label mk want . rest)
  (define args (if (null? rest) (list 5) (car rest)))
  (let* ((off (f4g-one mk #f args))
         (on  (f4g-one mk #t args))
         (so (car off)) (sn (car on)))
    (display label)
    (display " off=") (display (f4g-n2s so))
    (display " on=")  (display (f4g-n2s sn))
    (display " vals=") (display (f4g-n2s (cadr off))) (display "/") (display (f4g-n2s (cadr on)))
    (display " native=") (display (if (caddr off) "Y" "N")) (display (if (caddr on) "Y" "N"))
    (display " -> ")
    (cond
     ((not (and (caddr off) (caddr on)))
      (display "NOT-NATIVE (no NCG on this build/target, or finalize refused: nothing measured)"))
     ((not (and (equal? (cadr off) want) (equal? (cadr on) want)))
      (display "WRONG-ANSWER (fusion is not correctness-neutral -- this outranks any size win)"))
     ((and so sn (< sn so)) (display "FIRED, saved ") (display (- so sn)) (display " bytes"))
     (else (display "NOT-FIRED (this backend has no F4 emitter -- correct verdict, not a flake)")))
    (newline)))
(define (f3g-mk) (lambda (a b) (if (< a b) (if (> a b) 1 2) 3)))
(f4g-report "F3-cmpbr" f3g-mk 2 (list 3 7))
(f4g-report "F4-call"  f4g-mk 40)
(f4g-report "F4-tail"  f4g-tail-mk 10)
(display "--- ncg-fusion-gate done ---")
(newline)
(quiet f4g-was-quiet)
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-01 14:30:00
(define probe-fails 0)
(define probe-runs  0)
(define (probe-compile form fuse)
  (let ((prev (ncg-fuse! fuse))
        (env  (interaction-environment)))
    (let* ((p0 (eval form env))
           (p  (ncg-compile (procedure->bytecode p0))))
      (ncg-fuse! prev)
      p)))
(define (probe name form . args)
  (set! probe-runs (+ probe-runs 1))
  (let* ((p-off (probe-compile form #f))
         (p-on  (probe-compile form #t))
         (r-off (apply p-off args))
         (r-on  (apply p-on  args))
         (nat   (ncg-compiled? p-on))
         (same  (equal? r-off r-on)))
    (if (and same nat)
        (syslog "  ok   ~a => ~a~%" name r-on)
        (begin
          (set! probe-fails (+ probe-fails 1))
          (cond
           ((not same)
            (syslog "  FAIL ~a  MISMATCH off=~a on=~a~%" name r-off r-on))
           (else
            (syslog "  FAIL ~a  NOT-NCG-COMPILED with fusion on (answer ~a is right but native code was DISCARDED)~%"
                    name r-on)))))))
