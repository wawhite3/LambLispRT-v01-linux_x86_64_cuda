(news ";;;6.1 Equivalence predicates\n")
(chk "6.1-eqv-fg" #f
  (letrec ((f (lambda () (if (eqv? f g) 'f 'both))) (g (lambda () (if (eqv? f g) 'g 'both)))) (eqv? f g)))
(chk "6.1-eqv-aa" #t (eqv? 'a 'a))
(chk "6.1-eqv-ab" #f (eqv? 'a 'b))
(chk "6.1-eqv-22" #t (eqv? 2 2))
(chk "6.1-eqv-2-2.0" #f (eqv? 2 2.0))
(chk "6.1-eqv-nil" #t (eqv? '() '()))
(chk "6.1-eqv-big" #t (eqv? 100000000 100000000))
(chk "6.1-eqv-cons" #f (eqv? (cons 1 2) (cons 1 2)))
(chk "6.1-eqv-lam12" #f (eqv? (lambda () 1) (lambda () 2)))
(chk "6.1-eqv-pp" #t (let ((p (lambda (x) x))) (eqv? p p)))
(chk "6.1-eqv-f-nil" #f (eqv? #f 'nil))
(chk "6.1-eqv-estr" #f (eqv? "" ""))            ; impl-defined (R7RS unspecified)
(chk "6.1-eqv-evec" #f (eqv? '#() '#()))        ; impl-defined
(chk "6.1-eqv-lamx" #f (eqv? (lambda (x) x) (lambda (x) x)))
(chk "6.1-eqv-lamxy" #f (eqv? (lambda (x) x) (lambda (y) y)))
(define gen-counter (lambda () (let ((n 0)) (lambda () (set! n (+ n 1)) n))))
(chk "6.1-eqv-gc-self" #t (let ((g (gen-counter))) (eqv? g g)))
(chk "6.1-eqv-gc-2" #f (eqv? (gen-counter) (gen-counter)))
(define gen-loser (lambda () (let ((n 0)) (lambda () (set! n (+ n 1)) 27))))
(chk "6.1-eqv-gl-self" #t (let ((g (gen-loser))) (eqv? g g)))
(chk "6.1-eqv-gl-2" #f (eqv? (gen-loser) (gen-loser)))  ; impl-defined
(chk "6.1-eqv-a-list" #f (eqv? '(a) '(a)))      ; impl-defined
(chk "6.1-eqv-a-str" #f (eqv? "a" "a"))         ; impl-defined
(chk "6.1-eqv-cdr" #f (eqv? '(b) (cdr '(a b)))) ; impl-defined
(chk "6.1-eqv-xx" #t (let ((x '(a))) (eqv? x x)))
(chk "6.1-eq-aa" #t (eq? 'a 'a))
(chk "6.1-eq-alist" #f (eq? '(a) '(a)))         ; impl-defined
(chk "6.1-eq-lista" #f (eq? (list 'a) (list 'a)))
(chk "6.1-eq-astr" #f (eq? "a" "a"))            ; impl-defined
(chk "6.1-eq-estr" #f (eq? "" ""))              ; impl-defined
(chk "6.1-eq-nil" #t (eq? '() '()))
(chk "6.1-eq-22" #t (eq? 2 2))                  ; impl-defined (int eq? by value)
(chk "6.1-eq-AA" #t (eq? #\A #\A))              ; impl-defined
(chk "6.1-eq-car" #t (eq? car car))
(chk "6.1-eq-nn" #t (let ((n (+ 2 3))) (eq? n n)))
(chk "6.1-eq-xx" #t (let ((x '(a))) (eq? x x)))
(chk "6.1-eq-vv" #t (let ((x '#())) (eq? x x)))
(chk "6.1-eq-pp" #t (let ((p (lambda (x) x))) (eq? p p)))
(chk "6.1-equal-aa" #t (equal? 'a 'a))
(chk "6.1-equal-list" #t (equal? '(a) '(a)))
(chk "6.1-equal-nest" #t (equal? '(a (b) c) '(a (b) c)))
(chk "6.1-equal-str" #t (equal? "abc" "abc"))
(chk "6.1-equal-22" #t (equal? 2 2))
(chk "6.1-equal-vec" #t (equal? (make-vector 5 'a) (make-vector 5 'a)))
;;; circular equal? '#1=(a b . #1#) -- DEBT (datum labels / cyclic equal? not exercised)
(chk "6.1-equal-lam" #f (equal? (lambda (x) x) (lambda (y) y)))

(news ";;;6.2.6 Numerical operations\n")
(chk "6.2-complex-i" #t (complex? 3+4i))
(chk "6.2-complex-3" #t (complex? 3))
(chk "6.2-real-3" #t (real? 3))
(chk "6.2-real-2.5+0i" #t (real? -2.5+0i))
