  (let loop ((i 0) (acc 0))
    (if (= i n) acc (loop (+ i 1) (+ acc (count-atoms (deriv deriv-expr)))))))
(define dderiv-table
  (list (cons (quote +) (lambda (a) (cons (quote +) (map dderiv a))))
        (cons (quote -) (lambda (a) (cons (quote -) (map dderiv a))))
        (cons (quote *) (lambda (a)
                          (list (quote *) (cons (quote *) a)
                                (cons (quote +) (map (lambda (t) (list (quote /) (dderiv t) t)) a)))))
        (cons (quote /) (lambda (a)
                          (list (quote -) (list (quote /) (dderiv (car a)) (cadr a))
                                (list (quote /) (car a)
