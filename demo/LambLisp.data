           ((probe-compile '(lambda (n) (+ 1 (p4-no-such-procedure n))) #t) 1))))
  (if (eq? r 'raised)
      (syslog "  ok   f4-unbound => raised~%")
      (begin (set! probe-fails (+ probe-fails 1))
             (syslog "  FAIL f4-unbound  expected a raise, got ~a~%" r))))
(define (probe-fires name form)
  (set! probe-runs (+ probe-runs 1))
  (let ((off (ncg-code-size (probe-compile form #f)))
        (on  (ncg-code-size (probe-compile form #t))))
    (cond
     ((or (eq? off #f) (eq? on #f))
      (set! probe-fails (+ probe-fails 1))
      (syslog "  FAIL ~a  not NCG-compiled, so nothing was measured~%" name))
     ((< on off)
      (syslog "  ok   ~a  ~a -> ~a bytes (~a saved)~%" name off on (- off on)))
     (else
      (set! probe-fails (+ probe-fails 1))
      (syslog "  FAIL ~a  ~a -> ~a bytes: the peephole never fired~%" name off on)))))
(define (probe-not-fires name form)
  (set! probe-runs (+ probe-runs 1))
  (let ((off (ncg-code-size (probe-compile form #f)))
        (on  (ncg-code-size (probe-compile form #t))))
    (cond
     ((or (eq? off #f) (eq? on #f))
      (set! probe-fails (+ probe-fails 1))
      (syslog "  FAIL ~a  not NCG-compiled, so nothing was measured~%" name))
     ((= on off)
      (syslog "  ok   ~a  ~a bytes either way, as it must be~%" name off))
     (else
      (set! probe-fails (+ probe-fails 1))
      (syslog "  FAIL ~a  ~a -> ~a bytes: a fusion fired on a shape that has no fusible pair~%"
              name off on)))))
(syslog "-- fusion FIRES (code size must shrink) --~%")
(probe-fires 'fires-f1 '(lambda (n) (+ (car (list n)) 7)))
(probe-fires 'fires-f2 '(lambda (n) (+ (* n 3) (- n 1))))
(probe-fires 'fires-f3 '(lambda (a b) (if (< a b) (if (> a b) 1 2) 3)))
(probe-fires 'fires-f4 '(lambda (n) (+ (p4-double n) (p4-double n) (p4-double n) (p4-double n))))
(probe-fires 'fires-f4t '(lambda (n) (p4-double n)))
(probe-not-fires 'fires-none '(lambda (n) (car (cons n (cdr (cons n n))))))
(syslog "~%probe: ~a run, ~a failed~%" probe-runs probe-fails)
(syslog "VERDICT ~a~%" (if (= probe-fails 0) "PASS" "FAIL"))
(syslog "--- ncg-fusion-probe done ---~%")
