(chk "6.4-cdr2" 2 (cdr '(1 . 2)))
(chk "6.4-cdr-nil" #f (guard (exn (#t #f)) (cdr '())))
(chk "6.4-listp1" #t (list? '(a b c)))
(chk "6.4-list-nil" '(()) (list '()))
(chk "6.4-listp2" #f (list? '(a . b)))
(chk "6.4-list-cyc2" #f (let ((x (list 'a))) (set-cdr! x x) (list? x)))
(chk "6.4-list3" '(a 7 c) (list 'a (+ 3 4) 'c))
(chk "6.4-list0" '() (list))
