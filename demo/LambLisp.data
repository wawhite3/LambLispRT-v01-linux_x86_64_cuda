    (cond
      ((null? chars) (values))
      ((and (char=? (car chars) #\~)
            (pair? (cdr chars))
            (char=? (cadr chars) #\a))
       (display (if (null? args) "?" (car args)))
       (loop (cddr chars) (if (null? args) '() (cdr args))))
      (else
       (display (string (car chars)))
       (loop (cdr chars) args))))
  (when color (display "\x1b;[0m")))
