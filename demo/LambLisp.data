(bench       "guard/else"         'handled
  (guard (e (else 'handled))
    (error "anything")))
(bench-true  "input-port?"        (input-port? (open-input-string "x")))
(bench-true  "output-port?"       (output-port? (open-output-string)))
(bench       "read/list"          '(1 2 3)
