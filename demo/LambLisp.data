        (delay-force macro) (force bytecode) (make-promise bytecode))
      (map (lambda (p) (list (car p) (b864-kind (cdr p))))
           (list (cons 'when when) (cons 'unless unless) (cons 'case case)
                 (cons 'letrec letrec) (cons 'letrec* letrec*)
                 (cons 'let-values let-values) (cons 'let*-values let*-values)
                 (cons 'quasiquote quasiquote) (cons 'delay delay)
                 (cons 'delay-force delay-force) (cons 'force force)
                 (cons 'make-promise make-promise))))
