(info "Loading Behaviors\n")
(define (while-do pred action)
  (lambda ()
    (if (pred) (begin (action) #f) #t)))
(define (until-do pred action)
  (while-do (lambda () (not (pred))) action))
(define (once action)
  (lambda () (action) #t))
(define (behavior-hold)
  (lambda () #f))
(define (for-ms ms action)
  (let ((t-end #f))
    (while-do
     (lambda ()
       (unless t-end (set! t-end (+ (millis) ms)))
       (< (millis) t-end))
     action)))
(define (once-for ms action)
  (let ((t-end #f) (fired #f))
    (while-do
     (lambda ()
       (unless t-end (set! t-end (+ (millis) ms)))
       (< (millis) t-end))
     (lambda ()
       (unless fired (action) (set! fired #t))))))
(define (after-ms ms action)
  (let ((t-end #f))
    (lambda ()
      (unless t-end (set! t-end (+ (millis) ms)))
      (if (< (millis) t-end)
          #f
          (begin (action) #t)))))
(define (wait-ms ms)
  (after-ms ms (lambda () #f)))
(define (wait ms)
  (let ((end #f))
    (lambda ()
      (unless end (set! end (+ (millis) ms)))
      (>= (millis) end))))
(define (forever action)
  (while-do (lambda () #t) action))
(define (cycle . phases)
  (let ((ps '()) (t-end #f))
    (lambda ()
      (when (or (not t-end) (>= (millis) t-end))
        (when (null? ps) (set! ps phases))
        (let ((ph (car ps)))
          ((cadr ph))
          (set! t-end (+ (millis) (car ph)))
          (set! ps (cdr ps))))
      #f)))
(define (seq . tasks)
  (let ((ts tasks))
    (lambda ()
      (if (null? ts)
          #t
          (begin
            (when ((car ts)) (set! ts (cdr ts)))
            (null? ts))))))
(define (make-behavior-queue)
  (let ((q (Queue))
        (current #f)
        (n 0))
    (lambda (msg . args)
      (case msg
        ((push) (q (car args)) (set! n (+ n 1)))
        ((tick)
         (when (or current (> n 0))
           (unless current (set! current (q)) (set! n (- n 1)))
           (when (and current (current))
             (if (> n 0)
                 (begin (set! current (q)) (set! n (- n 1)))
                 (set! current #f)))))
        ((abort)
         (set! current #f)
         (let drain () (when (> n 0) (q) (set! n (- n 1)) (drain))))
        ((idle?) (and (not current) (= n 0)))
        (else (error "behavior-queue: unknown message" msg))))))
(define (behavior-queue-seq bq . tasks)
  (for-each (lambda (tk) (bq 'push tk)) tasks))
;;; Copyright 2026 by Frobenius Norm LLC 2026-06-03 16:30:00
(syslog "Loading Buzzer\n")
(define have-Buzzer-pin (dict-ref? Pins 'pin-buzzer))
(define have-Buzzer have-Buzzer-pin)
(syslog "Buzzer pin ~a\n" have-Buzzer-pin)
(unless have-Buzzer
  )
(define Buzzer.pin (if have-Buzzer (cdr have-Buzzer-pin) #f))
(define Buzzer.tone tone)
(define Buzzer.bq (make-behavior-queue))
(define Buzzer.enabled (positive? (setting 'buzzer 1)))
(define (Buzzer.on freq)
  (when Buzzer.enabled (Buzzer.tone Buzzer.pin (floor freq))))
(define (Buzzer.off) (Buzzer.tone Buzzer.pin 0))
(define Buzzer.max-on-ms (setting 'buzzer_max_on_ms 10))
(define (Buzzer.cap-ms ms)
  (cond ((not (number? ms)) 0)
        ((< ms 0)                  0)
        ((> ms Buzzer.max-on-ms)   Buzzer.max-on-ms)
        (else                      ms)))
(define Buzzer.click-hz (setting 'buzzer_click_hz 400))
(define Buzzer.tick-gap-ms (setting 'buzzer_tick_gap_ms 120))
(define Buzzer.click-ms (setting 'buzzer_click_ms 5))
(define (Buzzer.click)
  (Buzzer.bq 'push
    (lambda ()
      (Buzzer.on Buzzer.click-hz)
      (delay-ms (Buzzer.cap-ms Buzzer.click-ms))
      (Buzzer.off)
      #t)))
(define (Buzzer.onoff freq on-time off-time)
  (when (> on-time 0)  (Buzzer.bq 'push (once-for (floor (Buzzer.cap-ms on-time))  (lambda () (Buzzer.on freq)))))
  (when (> off-time 0) (Buzzer.bq 'push (once-for (floor off-time) Buzzer.off)))
  )
(define (Buzzer.offon freq off-time on-time)
  (when (> off-time 0) (Buzzer.bq 'push (once-for (floor off-time) Buzzer.off)))
  (when (> on-time 0)  (Buzzer.bq 'push (once-for (floor (Buzzer.cap-ms on-time)) (lambda () (Buzzer.on freq)))))
  )
(if have-Buzzer
  (define (Buzzer.chirp from to nsteps interval_ms)
    (letrec* ((f_range   (- to from 0.0))
	   (f_quantum (/ f_range nsteps))
	   (t_quantum (/ interval_ms nsteps))
	   (queue-step (lambda (freq) (Buzzer.onoff freq t_quantum 0)))
	   (queue-all  (lambda (n)
			 (let ((f (+ from (* n f_quantum))))
			   (when (<= f to)
			     (queue-step f)
			     (queue-all (+ 1 n))))))
	   )
      (queue-all 0)
      (Buzzer.bq 'push (once-for 1 (lambda () (Buzzer.off))))
      nil))
  (define (Buzzer.chirp . ignord) nil))
(define (Buzzer.beep1)
  (Buzzer.bq 'push
    (lambda ()
      (Buzzer.on Buzzer.click-hz)
      (delay-ms (Buzzer.cap-ms Buzzer.click-ms))
      (Buzzer.off)
      #t)))
(define (Buzzer.arf-sweep) (Buzzer.chirp 60 4000 100 1000))
(define (Buzzer.arf) (Buzzer.click))
(define (Buzzer.loop)
  (Buzzer.bq 'tick)
  )
(news "Buzzer loaded (no click here -- setup.scm clicks once the board is ready)\n")
(when have-Buzzer (register-safe-state! Buzzer.off))
(news "Buzzer loaded\n")
