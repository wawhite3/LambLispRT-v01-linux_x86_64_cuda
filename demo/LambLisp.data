(define (listn n) (if (= n 0) (list) (cons n (listn (- n 1)))))
(define (shorterp x y)
  (and (not (null? y)) (or (null? x) (shorterp (cdr x) (cdr y)))))
(define (mas x y z)
  (if (not (shorterp y x)) z
