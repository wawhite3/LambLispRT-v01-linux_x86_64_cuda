(check "cond/multi-expr"  3   (cond (#t 1 2 3)))
(check "cond/=>"          8   (cond (4 => (lambda (x) (* x 2)))))
(check "cond/=>-false"    'b  (cond (#f => (lambda (x) 'a)) (else 'b)))
(check "cond/value"       5   (cond (5)))
