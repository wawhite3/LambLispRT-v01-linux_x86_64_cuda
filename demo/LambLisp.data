                                               (setting 'llip_token #f)))
      (syslog "LLIP/TCP listening on ~a\n" (setting 'llip_port 8080))
      (set! loop
        (let ((inner loop))
          (lambda ()
            (inner)
            (guard (e (#t #f)) (llip-server-poll llip-net-srv)))))))
(if linux? #f
    (set! loop
      (let ((inner loop))
        (lambda ()
          (guard (e (#t (run-safe-state!) (raise e)))
            (inner))))))
(if (defined? 'ota-boot-ok!) (ota-boot-ok!) #f)
(if (> noop-boot-left 0)
    (begin
      (if (<= noop-boot-left 1)
          (begin
            (if (file-exists? "noop-cycles") (delete-file "noop-cycles") #f)
            (syslog "B58 no-op cycle: last one -- file removed, this board is back to normal\n"))
          (let ((p (open-output-file "noop-cycles")))
            (write (- noop-boot-left 1) p)
            (close-output-port p)
            (syslog "B58 no-op cycle: ~a remaining after this boot\n" (- noop-boot-left 1))))
      (if (<= noop-boot-left 1)
          #f
          (begin
            (let ((wait (setting 'noop_boot_delay_ms 5000)))
              (syslog "B58 no-op cycle: rebooting in ~a ms -- reach me now if you want it stopped\n"
                      wait)
              (delay-ms wait))
            (if (defined? 'Platform.reboot) (Platform.reboot) #f))))
    #f)
; Copyright 2026 by Frobenius Norm LLC 2026-04-18 00:00:00
(define tf-error-sentinel (list 'tf-error))
(define-syntax tf-try
  (syntax-rules ()
    ((_ expr)
     (with-exception-handler
       (lambda (e)
         (cons (car tf-error-sentinel)
               (if (and (pair? e) (eq? (car e) 'error-object))
                 (cadr e)
                 "error")))
       (lambda () expr)))))
(define (tf-error? v)
  (and (pair? v) (eq? (car v) 'tf-error)))
(define tf-pass  0)
(define tf-fail  0)
(define tf-skip  0)
(define tf-quiet #f)
(define (tf-reset!)
  (set! tf-pass 0)
  (set! tf-fail 0)
  (set! tf-skip 0))
(define-syntax test
  (syntax-rules ()
    ((_ label expr expected)
     (let* ((e expected)
            (a (tf-try expr)))
       (if (equal? e a)
         (begin
           (set! tf-pass (+ tf-pass 1))
           (unless tf-quiet
             (display "PASS ") (display label) (newline)))
         (begin
           (set! tf-fail (+ tf-fail 1))
           (display "FAIL ") (display label)
           (display "\n      expected: ") (write e)
           (display "\n      got:      ") (write a)
           (newline)))))))
(define-syntax test-error
  (syntax-rules ()
    ((_ label expr)
     (let ((threw? (tf-error? (tf-try expr))))
       (if threw?
         (begin
           (set! tf-pass (+ tf-pass 1))
           (unless tf-quiet
             (display "PASS ") (display label) (display " (error expected)") (newline)))
         (begin
           (set! tf-fail (+ tf-fail 1))
           (display "FAIL ") (display label)
           (display " -- expected error but none raised") (newline)))))))
(define-syntax test-true
  (syntax-rules ()
    ((_ label expr)
     (test label (if expr #t #f) #t))))
(define-syntax test-false
  (syntax-rules ()
    ((_ label expr)
     (test label (if expr #t #f) #f))))
(define (check name expected actual)
  (if (equal? expected actual)
    (begin
      (set! tf-pass (+ tf-pass 1))
      (unless tf-quiet
        (display "PASS ") (display name) (newline)))
    (begin
      (set! tf-fail (+ tf-fail 1))
      (display "FAIL ") (display name)
      (display "\n      expected: ") (write expected)
      (display "\n      got:      ") (write actual)
      (newline))))
(define-syntax test-suite
  (syntax-rules ()
    ((_ name body ...)
     (let ((p0 tf-pass) (f0 tf-fail))
       (display "--- ") (display name) (display " ---") (newline)
       body ...
       (let ((dp (- tf-pass p0))
             (df (- tf-fail f0)))
         (display name) (display ": ")
         (display dp) (display " passed")
         (when (> df 0)
           (display ", ") (display df) (display " FAILED"))
         (newline))))))
(define-syntax test-skip
  (syntax-rules ()
    ((_ label reason)
     (begin
       (set! tf-skip (+ tf-skip 1))
       (unless tf-quiet
         (display "SKIP ") (display label)
         (display " -- ") (display reason) (newline))))))
(define (test-report)
  (display "=== ")
  (display tf-pass) (display " passed")
  (when (> tf-fail 0)
    (display ", ") (display tf-fail) (display " FAILED"))
  (when (> tf-skip 0)
    (display ", ") (display tf-skip) (display " skipped"))
  (display " ===") (newline)
  (= tf-fail 0))
(define-syntax time
  (syntax-rules ()
    ((_ expr)
     (let* ((t0 (micros))
            (v  expr)
            (dt (- (micros) t0)))
       (display dt) (display " us")
       (when (>= dt 1000)
         (display " (")
         (display (/ dt 1000))
         (display " ms)"))
       (newline)
       v))))
(define-syntax time-n
  (syntax-rules ()
    ((_ n expr)
     (let* ((t0  (micros))
            (cnt n))
       (let loop ((i 0))
         (when (< i cnt) expr (loop (+ i 1))))
       (let ((dt (- (micros) t0)))
         (display cnt) (display "x: ")
         (display dt) (display " us total, ")
         (display (quotient dt cnt)) (display " us/call")
         (newline))))))
