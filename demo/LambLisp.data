(chk "6.1-B831-assv"  'hit     (cadr (assv (expt 2 72) (list (list (expt 2 72) 'hit)))))
(chk "6.1-B831-case"  'matched (case (expt 2 72) ((4722366482869645213696) 'matched) (else 'missed)))
