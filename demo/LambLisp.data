(define (llip-eval-stream conn next-expr window)
  (let ((port (llip-port conn)))
    (define (drain-one)
      (let ((resp (llip-recv-raw port)))
        (if (and (pair? resp) (eq? (car resp) 'error))
            (error "llip remote error" (if (pair? (cdr resp)) (cadr resp) resp))
            #t)))
    (let loop ((inflight 0) (done 0))
      (let ((e (if (< inflight window) (next-expr) #f)))
        (cond
          (e (llip-send-raw port (list 'eval e))
             (loop (+ inflight 1) done))
          ((> inflight 0) (drain-one) (loop (- inflight 1) (+ done 1)))
          (else done))))))
(define (llip-make-remote-async conn proc-name on-result)
