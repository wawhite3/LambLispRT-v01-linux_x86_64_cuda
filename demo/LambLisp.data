(chk "6.7-u8-s2v"      (vector #\x03B1 #\x03B2) (string->vector "\x03B1;\x03B2;"))
(chk "6.7-u8-v2s"      "\x03B1;\x03B2;" (vector->string (vector #\x03B1 #\x03B2)))
(chk "6.7-u8-s2utf8"   4 (bytevector-length (string->utf8 "\x03B1;\x03B2;\x03B3;\x03B4;" 0 2)))
(chk "6.7-u8-roundtrip" "\x03B1;\x03B2;" (utf8->string (string->utf8 "\x03B1;\x03B2;")))
