(check "env-compiled b"  20  (ncg-env-test-b 10))
(check "env-compiled c"   9  (ncg-env-test-c 10))
(let ((n (ncg-compile-environment! (interaction-environment))))
  (check-true "ncg-compile-environment! returned integer"  (integer? n)))
