(define (nq-safe? c row cols d1 d2)
  (and (not (memv c cols))
       (not (memv (- row c) d1))
       (not (memv (+ row c) d2))))
(define (nq n row cols d1 d2)
  (if (= row n) 1
      (let loop ((c 0) (acc 0))
        (if (= c n) acc
