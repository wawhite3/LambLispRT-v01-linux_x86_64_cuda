(chk "6.7-u8-ref"      #\x03B3 (string-ref "\x03B1;\x03B2;\x03B3;\x03B4;" 2))
(chk "6.7-u8-substr"   "\x03B2;\x03B3;" (substring "\x03B1;\x03B2;\x03B3;\x03B4;" 1 3))
(chk "6.7-u8-s2l"      (list #\x03B1 #\x03B2) (string->list "\x03B1;\x03B2;"))
(chk "6.7-u8-s2l-rng"  (list #\x03B2 #\x03B3) (string->list "\x03B1;\x03B2;\x03B3;\x03B4;" 1 3))
(chk "6.7-u8-scopy-rng" "\x03B2;\x03B3;" (string-copy "\x03B1;\x03B2;\x03B3;\x03B4;" 1 3))
(chk "6.7-u8-l2s"      "\x03B1;\x03B2;" (list->string (list #\x03B1 #\x03B2)))
