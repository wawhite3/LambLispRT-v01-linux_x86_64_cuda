(define (integer? x)  (and (%cpx:integer? (%cpx-r x)) (= (%cpx-i x) 0)))
(define (exact?   x)  (if (%cpx? x)
                        (and (%cpx:exact? (%cpx-r x)) (%cpx:exact? (%cpx-i x)))
                        (%cpx:exact? x)))
(define (inexact? x)  (if (%cpx? x)
