        (loop (cdr l) (f acc (car l))))))
(define (make-tree depth)
  (if (= depth 0) 1
      (cons (make-tree (- depth 1))
            (make-tree (- depth 1)))))
(define (tree-sum t)
  (if (pair? t)
      (+ (tree-sum (car t)) (tree-sum (cdr t)))
