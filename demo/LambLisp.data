  (let loop ((i n) (acc 128))
    (if (= i 0) acc
        (let* ((s (modulo i 256))
               (r (+ acc s))
               (c (if (> r 255) 255 r)))
          (loop (- i 1) c)))))
(define (minmax-bench n)
  (let loop ((i n) (lo 255) (hi 0))
    (if (= i 0) (+ lo hi)
        (let ((v (modulo i 256)))
          (loop (- i 1)
                (if (< v lo) v lo)
                (if (> v hi) v hi))))))
(define (run-sint-bench label)
  (define (current-us) (micros))
