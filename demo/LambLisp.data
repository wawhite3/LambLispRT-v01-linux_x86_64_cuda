(syslog "Defining quasiquote & helpers\n")
(define (qq-do-depth tmpl depth)
  (cond
    ((not (pair? tmpl))
     (list 'quote tmpl))
    ((and (eq? (car tmpl) 'unquote) (= depth 1))
     (cadr tmpl))
    ((eq? (car tmpl) 'unquote)
     (list 'list (list 'quote 'unquote)
                 (qq-do-depth (cadr tmpl) (- depth 1))))
    ((eq? (car tmpl) 'quasiquote)
     (list 'list (list 'quote 'quasiquote)
                 (qq-do-depth (cadr tmpl) (+ depth 1))))
    ((and (pair? (car tmpl))
          (eq? (caar tmpl) 'unquote-splicing)
          (= depth 1))
     (list 'append (car (cdr (car tmpl)))
                   (qq-do-depth (cdr tmpl) depth)))
    ((and (pair? (car tmpl))
          (eq? (caar tmpl) 'unquote-splicing))
     (list 'cons (list 'list (list 'quote 'unquote-splicing)
                             (qq-do-depth (car (cdr (car tmpl))) (- depth 1)))
                 (qq-do-depth (cdr tmpl) depth)))
    (else
     (list 'cons (qq-do-depth (car tmpl) depth)
                 (qq-do-depth (cdr tmpl) depth)))))
(define (qq-do tmpl)
  (qq-do-depth tmpl 1))
(define quasiquote
  (macro use-form
    (qq-do-depth (car use-form) 1)))
(define qq
  (macro use-form
    (qq-do-depth (car use-form) 1)))
(syslog "Done defining quasiquote & helpers\n")
(define (sr-literal? sym literals)
  (and (symbol? sym) (memq sym literals) #t))
(define (sr-pvar? sym literals)
  (and (symbol? sym)
       (not (eq? sym '_))
       (not (eq? sym '...))
       (not (sr-literal? sym literals))))
(define (sr-ellipsis-next? lst)
  (and (pair? lst) (pair? (cdr lst)) (eq? (cadr lst) '...)))
(define (sr-pvars-in pat literals)
  (cond
    ((sr-pvar? pat literals) (list pat))
    ((pair? pat) (append (sr-pvars-in (car pat) literals)
                         (sr-pvars-in (cdr pat) literals)))
    (else (list))))
(define (sr-lookup sym bindings)
  (cond
    ((null? bindings) #f)
    ((eq? (caar bindings) sym) (car bindings))
    (else (sr-lookup sym (cdr bindings)))))
(define (sr-merge b1 b2)
  (and b1 b2 (append b1 b2)))
(define (sr-list-len lst)
  (letrec ((count (lambda (l n)
                    (cond ((null? l) n)
                          ((pair? l) (count (cdr l) (+ n 1)))
                          (else -1)))))
    (count lst 0)))
(define (sr-list-head lst k)
  (if (= k 0) (list)
      (cons (car lst) (sr-list-head (cdr lst) (- k 1)))))
(define (sr-filter pred lst)
  (letrec ((loop (lambda (l acc)
                   (if (null? l)
                       (reverse acc)
                       (loop (cdr l) (if (pred (car l)) (cons (car l) acc) acc))))))
    (loop lst (list))))
(define (sr-match-each sub lst literals)
  (letrec ((loop (lambda (rest acc)
                   (if (null? rest)
                       (reverse acc)
                       (let ((b (sr-match-one sub (car rest) literals)))
                         (if b (loop (cdr rest) (cons b acc)) #f))))))
    (loop lst (list))))
(define (sr-zip-ell pvars each-binds)
  (map (lambda (pvar)
         (cons pvar (map (lambda (b)
                           (let ((p (sr-lookup pvar b)))
                             (if p (cdr p) #f)))
                         each-binds)))
       pvars))
(define (sr-match-one pat inp literals)
  (cond
    ((eq? pat '_) (list))
    ((sr-literal? pat literals) (if (and (symbol? inp) (eq? pat inp)) (list) #f))
    ((sr-pvar? pat literals) (list (cons pat inp)))
    ((and (null? pat) (null? inp)) (list))
    ((and (pair? pat) (pair? inp)) (sr-match-list pat inp literals))
    ((not (pair? pat)) (if (equal? pat inp) (list) #f))
    (else #f)))
(define (sr-match-list pat-tail inp-tail literals)
  (cond
    ((and (null? pat-tail) (null? inp-tail)) (list))
    ((null? pat-tail) #f)
    ((null? inp-tail)
     (if (not (sr-ellipsis-next? pat-tail))
         #f
         (let* ((sub    (car pat-tail))
                (rest-p (cddr pat-tail))
                (pvars  (sr-pvars-in sub literals))
                (zero-b (map (lambda (v) (cons v (list))) pvars))
                (rest-b (sr-match-list rest-p (list) literals)))
           (sr-merge zero-b rest-b))))
    ((sr-ellipsis-next? pat-tail)
     (let* ((sub    (car pat-tail))
            (rest-p (cddr pat-tail))
            (pvars  (sr-pvars-in sub literals))
            (n-rest (sr-list-len rest-p))
            (n-inp  (if (list? inp-tail) (length inp-tail) -1)))
       (if (< n-inp n-rest)
           #f
           (letrec ((scan (lambda (k)
                            (if (< k 0)
                                #f
                                (let* ((elems    (sr-list-head inp-tail k))
                                       (rest-inp (list-tail inp-tail k))
                                       (each-b   (sr-match-each sub elems literals))
                                       (rest-b   (and each-b (sr-match-list rest-p rest-inp literals))))
                                  (if (and each-b rest-b)
                                      (sr-merge (sr-zip-ell pvars each-b) rest-b)
                                      (scan (- k 1))))))))
             (scan (- n-inp n-rest))))))
    ((not (pair? pat-tail)) (sr-match-one pat-tail inp-tail literals))
    (else (sr-merge (sr-match-one  (car pat-tail) (car inp-tail) literals)
                    (sr-match-list (cdr pat-tail) (cdr inp-tail) literals)))))
(define (sr-match pattern input literals)
  (sr-match-list (cdr pattern) (cdr input) literals))
(define (sr-expand-has-ell? lst)
  (and (pair? lst) (pair? (cdr lst)) (eq? (cadr lst) '...)))
(define (sr-expand-pvars-in t bindings)
  (cond
    ((and (symbol? t) (sr-lookup t bindings)) (list t))
    ((pair? t) (append (sr-expand-pvars-in (car t) bindings)
                       (sr-expand-pvars-in (cdr t) bindings)))
    (else (list))))
(define (sr-expand-evars-in sub bindings)
  (sr-filter (lambda (v)
               (let ((p (sr-lookup v bindings)))
                 (and p (list? (cdr p)))))
             (sr-expand-pvars-in sub bindings)))
(define (sr-expand-one t bindings)
  (cond
    ((and (symbol? t) (sr-lookup t bindings)) (cdr (sr-lookup t bindings)))
    ((not (pair? t)) t)
    ((sr-expand-has-ell? t)
     (let* ((sub   (car t))
            (rest  (cddr t))
            (evars (sr-expand-evars-in sub bindings))
            (n     (if (null? evars) 0 (length (cdr (sr-lookup (car evars) bindings)))))
            (iter-b (lambda (idx)
                      (map (lambda (b)
                             (if (memq (car b) evars)
                                 (cons (car b) (list-ref (cdr b) idx))
                                 b))
                           bindings)))
            (reps  (sr-expand-reps sub iter-b n 0)))
       (append reps (sr-expand-one rest bindings))))
    (else (cons (sr-expand-one (car t) bindings)
                (sr-expand-one (cdr t) bindings)))))
(define (sr-expand-reps sub iter-b n idx)
  (if (= idx n)
      (list)
      (cons (sr-expand-one sub (iter-b idx))
            (sr-expand-reps sub iter-b n (+ idx 1)))))
(define (sr-expand tmpl bindings)
  (sr-expand-one tmpl bindings))
(define (sr-append-map f lst)
  (letrec ((loop (lambda (l acc)
                   (if (null? l)
                       (reverse acc)
                       (letrec ((inner (lambda (items a)
                                         (if (null? items) a
                                             (inner (cdr items) (cons (car items) a))))))
                         (loop (cdr l) (inner (f (car l)) acc)))))))
    (loop lst (list))))
(define (sr-in-pvars? sym pvars)
  (and (symbol? sym) (memq sym pvars) #t))
(define (hy-subst sym subst pvars)
  (if (sr-in-pvars? sym pvars)
      sym
      (let ((p (assq sym subst)))
        (if p (cdr p) sym))))
(define (hy-make-subst syms pvars)
  (map (lambda (s) (cons s (gensym)))
       (sr-filter (lambda (s) (not (sr-in-pvars? s pvars))) syms)))
(define (hy-flatten formals)
  (cond
    ((null? formals)        (list))
    ((eq? formals '...)     (list))
    ((symbol? formals)      (list formals))
    ((pair? formals)        (if (eq? (car formals) '...)
                                (hy-flatten (cdr formals))
                                (append (hy-flatten (car formals))
                                        (hy-flatten (cdr formals)))))
    (else (list))))
(define (hy-formals formals subst pvars)
  (cond
    ((null? formals)    (list))
    ((eq? formals '...) '...)
    ((symbol? formals)  (hy-subst formals subst pvars))
    ((pair? formals)    (cons (hy-subst (car formals) subst pvars)
                              (hy-formals (cdr formals) subst pvars)))
    (else formals)))
(define (hy-body body subst pvars)
  (map (lambda (e) (hy-walk e subst pvars)) body))
(define (hy-bindings binds new-vars init-subst pvars)
  (map (lambda (b)
         (if (not (pair? b)) b
             (list (hy-subst (car b) new-vars pvars)
                   (hy-walk (cadr b) init-subst pvars))))
       binds))
(define (hy-walk tmpl subst pvars)
  (cond
    ((symbol? tmpl) (hy-subst tmpl subst pvars))
    ((not (pair? tmpl)) tmpl)
    ((and (eq? (car tmpl) 'let) (pair? (cdr tmpl)) (pair? (cadr tmpl)))
     (let* ((binds    (cadr tmpl))
            (body     (cddr tmpl))
            (new-vars (hy-make-subst (map car (sr-filter pair? binds)) pvars))
            (new-s    (append new-vars subst)))
       (cons 'let (cons (hy-bindings binds new-vars subst pvars)
                        (hy-body body new-s pvars)))))
    ((and (eq? (car tmpl) 'let) (pair? (cdr tmpl)) (symbol? (cadr tmpl)))
     (let* ((name     (cadr tmpl))
            (binds    (caddr tmpl))
            (body     (cdddr tmpl))
            (new-name (if (sr-in-pvars? name pvars) name (gensym)))
            (new-vars (hy-make-subst (map car (sr-filter pair? binds)) pvars))
            (new-s    (append (list (cons name new-name)) new-vars subst)))
       (cons 'let (cons new-name (cons (hy-bindings binds new-vars subst pvars)
                                       (hy-body body new-s pvars))))))
    ((eq? (car tmpl) 'let*)
     (let* ((binds     (cadr tmpl))
            (body      (cddr tmpl))
            (new-vars  (hy-make-subst (map car (sr-filter pair? binds)) pvars))
            (new-s     (append new-vars subst))
            (new-binds (letrec ((build (lambda (bs cur-s acc)
                                         (if (null? bs)
                                             (reverse acc)
                                             (let ((b (car bs)))
                                               (if (not (pair? b))
                                                   (build (cdr bs) cur-s (cons b acc))
                                                   (let* ((nv (cdr (assq (car b) new-vars)))
                                                          (ns (cons (cons (car b) nv) cur-s))
                                                          (ni (hy-walk (cadr b) cur-s pvars)))
                                                     (build (cdr bs) ns (cons (list nv ni) acc)))))))))
                          (build binds subst (list)))))
       (cons 'let* (cons new-binds (hy-body body new-s pvars)))))
    ((or (eq? (car tmpl) 'letrec) (eq? (car tmpl) 'letrec*))
     (let* ((kw       (car tmpl))
            (binds    (cadr tmpl))
            (body     (cddr tmpl))
            (new-vars (hy-make-subst (map car (sr-filter pair? binds)) pvars))
            (new-s    (append new-vars subst)))
       (cons kw (cons (hy-bindings binds new-vars new-s pvars)
                      (hy-body body new-s pvars)))))
    ((eq? (car tmpl) 'lambda)
     (let* ((formals  (cadr tmpl))
            (body     (cddr tmpl))
            (new-vars (hy-make-subst (hy-flatten formals) pvars))
            (new-s    (append new-vars subst)))
       (cons 'lambda (cons (hy-formals formals new-vars pvars)
                           (hy-body body new-s pvars)))))
    ((and (eq? (car tmpl) 'define) (pair? (cdr tmpl)) (pair? (cadr tmpl)))
     (let* ((head     (cadr tmpl))
            (params   (cdr head))
            (body     (cddr tmpl))
            (new-vars (hy-make-subst (hy-flatten params) pvars))
            (new-s    (append new-vars subst)))
       (cons 'define (cons (cons (car head) (hy-formals params new-vars pvars))
                           (hy-body body new-s pvars)))))
    ((eq? (car tmpl) 'define)
     (list 'define (cadr tmpl) (hy-walk (caddr tmpl) subst pvars)))
    (else (cons (hy-walk (car tmpl) subst pvars)
                (hy-walk (cdr tmpl) subst pvars)))))
(define (sr-hygienize tmpl pvars)
  (hy-walk tmpl (list) pvars))
(define syntax-rules
  (nlambda use-form
    (let* ((literals    (car use-form))
           (rules       (cdr use-form))
           (all-pvars   (sr-append-map (lambda (r) (sr-pvars-in (car r) literals)) rules))
           (clean-rules (map (lambda (r) (cons (car r) (sr-hygienize (cadr r) all-pvars))) rules)))
      (macro use-form
        (let ((input (cons '_ use-form)))
          (letrec ((try (lambda (rs)
                          (if (null? rs)
                              (error "syntax-rules: no matching pattern" input)
                              (let ((bindings (sr-match (caar rs) input literals)))
                                (if bindings
                                    (sr-expand (cdar rs) bindings)
                                    (try (cdr rs))))))))
            (try clean-rules)))))))
(define (char-foldcase c) (char-downcase c))
(define (string-foldcase s) (string-downcase s))
(define-syntax let-values
  (syntax-rules ()
    ((let-values () body ...)
     (begin body ...))
    ((let-values (((var ...) expr) rest ...) body ...)
     (call-with-values (lambda () expr)
       (lambda (var ...) (let-values (rest ...) body ...))))))
(define-syntax let*-values
  (syntax-rules ()
    ((let*-values () body ...)
     (begin body ...))
    ((let*-values (((var ...) expr) rest ...) body ...)
     (call-with-values (lambda () expr)
       (lambda (var ...) (let*-values (rest ...) body ...))))))
(define (map proc . list-of-lists)
  (letrec
    ((list-cars (lambda (lol)
                  (letrec ((fn (lambda (lol cars)
                                 (if (null? lol) (reverse! cars)
                                   (let ((l (car lol)))
                                     (if (null? l) (list)
                                       (fn (cdr lol) (cons (car l) cars))))))))
                    (fn lol (list)))))
     (list-cdrs (lambda (lol)
                  (letrec ((fn (lambda (lol cdrs)
                                 (if (null? lol) (reverse! cdrs)
                                   (let ((l (car lol)))
                                     (if (null? l) (list)
                                       (fn (cdr lol) (cons (cdr l) cdrs))))))))
                    (fn lol (list)))))
     (map-apply (lambda (lol res)
                  (if (null? lol) (reverse! res)
                    (let ((cars (list-cars lol)))
                      (if (null? cars) (reverse! res)
                        (map-apply (list-cdrs lol) (cons (apply proc cars) res))))))))
    (map-apply list-of-lists (list))))
(define (for-each proc . lists)
  (apply map (cons proc lists))
  *undefined*)
(define (make-promise done? proc) (list (cons done? proc)))
(define promise-done? (lambda (x) (caar x)))
(define promise-value (lambda (x) (cdar x)))
(define (promise-update! new old)
  (set-car! (car old) (promise-done? new))
  (set-cdr! (car old) (promise-value new))
  (set-car! new (car old)))
(define-syntax delay-force
  (syntax-rules ()
    ((delay-force expression)
     (make-promise #f (lambda () expression)))))
(define-syntax delay
  (syntax-rules ()
    ((delay expression)
     (delay-force (make-promise #t expression)))))
(define (force promise)
  (if (promise-done? promise)
    (promise-value promise)
    (let ((promise* ((promise-value promise))))
      (unless (promise-done? promise) (promise-update! promise* promise))
      (force promise))))
;;; Copyright 2026 by Frobenius Norm LLC 2026-10-08 21:05:00
(if (not (defined? 'sd-recorder-open!))
    (load "sd-recorder.scm" 0))
(define sdcost-n 30)
(define (sdcost-ready?)
  (and (defined? 'sd-info)
       (defined? 'sd-append)
       (defined? 'sd-mount)
       (begin (guard (e (#t #f)) (sd-mount)) #t)
       (let ((info (sd-info)))
         (and (pair? info) (car info)))))
(define (sdcost-contact-stable? n)
  (if (not (sdcost-ready?))
      #f
      (let ((first (sd-info)))
        (let loop ((i 1))
          (cond ((>= i n) #t)
                ((not (equal? (sd-info) first)) #f)
                (else (loop (+ i 1))))))))
(define (sdcost-arm n)
  (let ((t0 (micros)))
    (let loop ((i 0) (ok 0) (bad 0))
      (if (>= i n)
          (let ((us (- (micros) t0)))
            (list n ok bad us (if (> ok 0) (quotient us ok) 0)))
          (if (sd-recorder-log! "sdcost record with a little padding")
              (loop (+ i 1) (+ ok 1) bad)
              (loop (+ i 1) ok (+ bad 1)))))))
(define (sdcost-bare n)
  (let ((t0 (micros)))
    (let loop ((i 0) (ok 0) (bad 0))
      (if (>= i n)
          (let ((us (- (micros) t0)))
            (list n ok bad us (if (> ok 0) (quotient us ok) 0)))
          (if (sd-append "sdcost-bare.txt" "y")
              (loop (+ i 1) (+ ok 1) bad)
              (loop (+ i 1) ok (+ bad 1)))))))
(define (sdcost-run)
  (if (not (sdcost-ready?))
      (begin
        (display "SDCOST-SKIP ")
        (display (if (defined? 'sd-info)
                     "(sd-mount) was called and the card still did NOT mount -- absent, badly seated, dead, or not FAT"
                     "no SD in this build"))
        (newline))
      (if (not (sdcost-contact-stable? 3))
          (begin
            (display "SDCOST-SKIP card mounts but its identity CHANGES across reads -- contact is")
            (display " intermittent, so any cost figure here would be socket noise")
            (newline))
      (begin
        (display "SDCOST-OPEN ") (display (sd-recorder-open! "sdcost" 8192 3)) (newline)
        (display "SDCOST-RECORDER ") (display (sdcost-arm sdcost-n)) (newline)
        (display "SDCOST-BARE ") (display (sdcost-bare sdcost-n)) (newline)
        (display "SDCOST-STATS ") (display (sd-recorder-stats)) (newline))))
  (display "SDCOST-END") (newline))
(sdcost-run)
;;; Copyright 2026 by Frobenius Norm LLC 2026-04-27 19:30:00
(define smoke-pass 0)
(define smoke-fail 0)
(define-syntax check
  (syntax-rules ()
    ((_ name expected expr)
     (let* ((expected-val expected)
            (actual-val   expr)
            (ok (equal? expected-val actual-val)))
       (display (if ok "PASS " "FAIL "))
       (display name)
       (display " | expr ")     (write (quote expr))
       (display " | expected ") (write expected-val)
       (display " | got ")      (write actual-val)
       (newline)
       (if ok (set! smoke-pass (+ smoke-pass 1))
              (set! smoke-fail (+ smoke-fail 1)))))))
(check "arithmetic"   4          (+ 2 2))
(check "lambda"       9          ((lambda (x) (* x x)) 3))
(check "tail-call"    0          (let loop ((n 1000)) (if (= n 0) 0 (loop (- n 1)))))
(check "list"         '(1 2 3)   (list 1 2 3))
(check "car/cdr"      2          (car (cdr '(1 2 3))))
(check "string"       "hi"       (string-append "h" "i"))
(check "utf8-length"  3          (string-length "\x03BB;\x03B1;x"))
(check "utf8-ref"     #\x03B1   (string-ref "\x03BB;\x03B1;x" 1))
(check "utf8-roundtrip" "\x03BB;" (utf8->string (string->utf8 "\x03BB;")))
(check "gc-stress"    #t         (let loop ((n 5000))
                                   (if (= n 0) #t (begin (cons n n) (loop (- n 1))))))
(check "boolean"      #f         (and #t #f))
(check "define"       42         (begin (define smoke-x 42) smoke-x))
(check "let"          7          (let ((a 3) (b 4)) (+ a b)))
(display "Total: ") (display smoke-pass) (display " pass, ")
(display smoke-fail) (display " fail") (newline)
(display "--- smoke done ---") (newline)
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-17 00:00:00
(define (sb-sqrt x) (sqrt x))
(define (sb-stats xs)
  (let ((n (length xs)))
    (if (= n 0)
        (list 0 0 0 0 0)
        (let loop ((l xs) (sum 0) (lo 1e9) (hi -1e9))
          (if (pair? l)
              (loop (cdr l) (+ sum (car l))
                    (if (< (car l) lo) (car l) lo)
                    (if (> (car l) hi) (car l) hi))
              (let ((mean (/ sum n)))
                (let loop2 ((l xs) (acc 0))
                  (if (pair? l)
                      (loop2 (cdr l) (+ acc (let ((d (- (car l) mean))) (* d d))))
                      (list n mean (sb-sqrt (/ acc (if (> n 1) (- n 1) 1))) lo hi)))))))))
(define (sb-blocking n)
  (let loop ((i 0) (ds '()) (pauses '()) (t-start (micros)))
    (if (>= i n)
        (list ds pauses (- (micros) t-start))
        (let* ((t0 (micros))
               (us (Sonar.ping))
               (t1 (micros))
               (d  (if us (Sonar.us->distance us) Sonar.range-m)))
          (loop (+ i 1) (cons d ds) (cons (- t1 t0) pauses) t-start)))))
(define (sb-isr n)
  (let loop ((i 0) (ds '()) (pauses '()) (busy 0) (t-start (micros)))
    (if (>= i n)
        (list ds pauses (- (micros) t-start) busy)
        (let poll ((b 0))
          (let* ((t0 (micros))
                 (r  (Sonar.result))
                 (t1 (micros))
                 (b2 (+ b (- t1 t0))))
            (cond
              ((not r) (poll b2))
              (else
               (let* ((d  (if (zero? r) Sonar.range-m (Sonar.us->distance r)))
                      (s0 (micros))
                      (_  (Sonar.start))
                      (s1 (micros))
                      (p  (+ b2 (- s1 s0))))
                 (loop (+ i 1) (cons d ds) (cons p pauses) (+ busy p) t-start)))))))))
(define (sb-wait-us gap)
  (let ((t0 (micros)))
    (let spin () (if (< (- (micros) t0) gap) (spin)))))
(define (sb-isr-gated n gap)
  (let loop ((i 0) (ds '()) (pauses '()) (t-start (micros)))
    (if (>= i n)
        (list ds pauses (- (micros) t-start))
        (let poll ((b 0))
          (let* ((t0 (micros))
                 (r  (Sonar.result))
                 (t1 (micros))
                 (b2 (+ b (- t1 t0))))
            (cond
              ((not r) (poll b2))
              (else
               (let* ((d  (if (zero? r) Sonar.range-m (Sonar.us->distance r))))
                 (sb-wait-us gap)
                 (let* ((s0 (micros))
                        (_  (Sonar.start))
                        (s1 (micros))
                        (p  (+ b2 (- s1 s0))))
                   (loop (+ i 1) (cons d ds) (cons p pauses) t-start))))))))))
(define (sb-report arm ds pauses total-us)
  (let ((ds-st (sb-stats ds))
        (pa-st (sb-stats pauses)))
    (display "RESULT arm=") (display arm)
    (display " n=")          (display (car ds-st))
    (display " mean_m=")     (display (exact->inexact (cadr ds-st)))
    (display " sd_m=")       (display (caddr ds-st))
    (display " min_m=")      (display (cadddr ds-st))
    (display " max_m=")      (display (car (cddddr ds-st)))
    (display " pause_mean_us=") (display (exact->inexact (cadr pa-st)))
    (display " pause_max_us=")  (display (car (cddddr pa-st)))
    (display " total_us=")   (display total-us)
    (display " per_sec=")    (display (if (> total-us 0) (/ (* 1.0 (car ds-st) 1000000) total-us) 0))
    (newline)))
(define (sonar-bench n)
  (if (not have-Sonar)
      (begin (display "RESULT arm=NONE error=no-sonar-on-this-board") (newline))
      (begin
        (display "SONARBENCH start n=") (display n) (newline)
        (let ((a2 (sb-blocking n)))
          (sb-report "A2-blocking" (car a2) (cadr a2) (caddr a2)))
        (Sonar.start)
        (let ((a3 (sb-isr n)))
          (sb-report "A3-isr" (car a3) (cadr a3) (caddr a3)))
        (Sonar.start)
        (let ((a3g (sb-isr-gated n 60000)))
          (sb-report "A3g-isr-gated" (car a3g) (cadr a3g) (caddr a3g)))
        (display "SONARBENCH done") (newline))))
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-17 00:00:00
(define (sis-one-interval gap n)
  (Sonar.min-interval-us! gap)
  (Sonar.start)
  (let loop ((i 0) (good '()) (bad 0))
    (if (>= i n)
        (let ((st (sb-stats good)))
          (list gap bad (if (> (car st) 0) (exact->inexact (cadr st)) 'none)
                        (if (> (car st) 1) (caddr st) 'none)))
        (let poll ()
          (let ((r (Sonar.result)))
            (cond
              ((not r) (poll))
              ((zero? r)
               (Sonar.start)
               (loop (+ i 1) good (+ bad 1)))
              (else
               (let ((d (Sonar.us->distance r)))
                 (Sonar.start)
                 (if (>= d Sonar.range-m)
                     (loop (+ i 1) good (+ bad 1))
                     (loop (+ i 1) (cons d good) bad))))))))))
(define (sonar-interval-sweep n)
  (if (not have-Sonar)
      (begin (display "RESULT sweep=NONE error=no-sonar") (newline))
      (begin
        (display "SONARBENCH start sweep n=") (display n) (newline)
        (for-each
          (lambda (gap)
            (let ((r (sis-one-interval gap n)))
              (display "RESULT sweep gap_us=") (display (car r))
              (display " misses=")             (display (cadr r))
              (display "/")                    (display n)
              (display " mean_m=")             (display (caddr r))
              (display " sd_m=")               (display (cadddr r))
              (newline)))
          '(60000 40000 25000 15000 10000 6000 4000 2000 1000 0))
        (Sonar.defaults!)
        (Sonar.start)
        (display "SONARBENCH" ) (display " done") (newline))))
(define (sis-one-rest rest n)
  (Sonar.min-interval-us! 0)
  (Sonar.rest-after-echo-us! rest)
  (Sonar.start)
  (let loop ((i 0) (good '()) (bad 0))
    (if (>= i n)
        (let ((st (sb-stats good)))
          (list rest bad (if (> (car st) 0) (exact->inexact (cadr st)) 'none)
                         (if (> (car st) 1) (caddr st) 'none)))
        (let poll ()
          (let ((r (Sonar.result)))
            (cond
              ((not r) (poll))
              ((zero? r) (Sonar.start) (loop (+ i 1) good (+ bad 1)))
              (else
               (let ((d (Sonar.us->distance r)))
                 (Sonar.start)
                 (if (>= d Sonar.range-m)
                     (loop (+ i 1) good (+ bad 1))
                     (loop (+ i 1) (cons d good) bad))))))))))
(define (sonar-rest-sweep n)
  (if (not have-Sonar)
      (begin (display "RESULT rest=NONE error=no-sonar") (newline))
      (begin
        (display "SONARBENCH start rest-sweep n=") (display n) (newline)
        (for-each
          (lambda (rest)
            (let ((r (sis-one-rest rest n)))
              (display "RESULT rest_us=") (display (car r))
              (display " misses=")        (display (cadr r))
              (display "/")               (display n)
              (display " mean_m=")        (display (caddr r))
              (display " sd_m=")          (display (cadddr r))
              (newline)))
          '(20000 15000 12000 10000 9000 8000 7000 6000 5000 4000 3000 2000 1000 0))
        (Sonar.defaults!)
        (Sonar.start)
        (display "SONARBENCH") (display " done") (newline))))
(define (sis-pattern rest n)
  (Sonar.min-interval-us! 0)
  (Sonar.rest-after-echo-us! rest)
  (Sonar.start)
  (let loop ((i 0) (acc '()))
    (if (>= i n)
        (reverse acc)
        (let poll ()
          (let ((r (Sonar.result)))
            (cond
              ((not r) (poll))
              ((zero? r) (Sonar.start) (loop (+ i 1) (cons #f acc)))
              (else
               (let ((d (Sonar.us->distance r)))
                 (Sonar.start)
                 (loop (+ i 1) (cons (if (>= d Sonar.range-m) #f d) acc))))))))))
(define (sis-longest-run seq)
  (let loop ((l seq) (cur 0) (best 0))
    (cond ((null? l) (max cur best))
          ((car l) (loop (cdr l) 0 (max cur best)))
          (else    (loop (cdr l) (+ cur 1) best)))))
(define (sonar-pattern-test n)
  (if (not have-Sonar)
      (begin (display "RESULT pattern=NONE error=no-sonar") (newline))
      (begin
        (display "SONARBENCH start pattern n=") (display n) (newline)
        (for-each
          (lambda (rest)
            (let* ((seq (sis-pattern rest n))
                   (bad (let c ((l seq) (k 0)) (if (null? l) k (c (cdr l) (if (car l) k (+ k 1)))))))
              (display "RESULT pattern rest_us=") (display rest)
              (display " misses=") (display bad) (display "/") (display n)
              (display " longest_run=") (display (sis-longest-run seq))
              (display " seq=")
              (for-each (lambda (x) (display (if x "." "X"))) seq)
              (newline)))
          '(60000 8000 6000 5000 4000 3000 2000 0))
        (Sonar.defaults!)
        (Sonar.start)
        (display "SONARBENCH") (display " done") (newline))))
;;; Copyright 2026 by Frobenius Norm LLC 2026-10-07 20:20:00
(define snw-ceiling-us    300000)
(define snw-gate-us       500000)
(define snw-r1-timeout-us 200000)
(define snw-near-lo-us        300)
(define snw-near-hi-us      25000)
(define snw-echo-max-us
  (+ 500 (inexact->exact (round (/ (* 2.0 Sonar.range-m 1000000.0) 343.0)))))
(define (snw-sum l) (if (null? l) 0 (+ (car l) (snw-sum (cdr l)))))
(define (snw-min l) (if (null? (cdr l)) (car l) (let ((r (snw-min (cdr l)))) (if (< (car l) r) (car l) r))))
(define (snw-max l) (if (null? (cdr l)) (car l) (let ((r (snw-max (cdr l)))) (if (> (car l) r) (car l) r))))
(define (snw-collect n)
  (let loop ((i 0) (acc '()))
    (if (>= i n) (reverse acc)
        (loop (+ i 1) (cons (Sonar.ping) acc)))))
(define (snw-fixture n)
  (if (not have-Sonar)
      (begin (display "RESULT noecho=NONE error=no-sonar") (newline) #f)
      (begin
        (Sonar.defaults!)
        (let* ((raw  (snw-collect n))
               (good (let f ((l raw) (a '()))
                       (cond ((null? l) (reverse a))
                             ((and (car l) (> (car l) snw-near-lo-us) (< (car l) snw-near-hi-us))
                              (f (cdr l) (cons (car l) a)))
                             (else (f (cdr l) a)))))
               (k    (length good)))
          (display "RESULT fixture n=")   (display n)
          (display " echoes=")            (display k)
          (display " min_us=")            (display (if (> k 0) (snw-min good) 'none))
          (display " max_us=")            (display (if (> k 0) (snw-max good) 'none))
          (newline)
          (display "RESULT fixture verdict=")
          (display (if (> k 0) "SENSOR-ALIVE" "NO-SENSOR"))
          (newline)
          (if (= k 0)
              (begin
                (display "RESULT fixture note=every ping timed out with a target in front -- ")
                (display "unpowered or unwired sensor, NOT a clear field; width not measured")
                (newline)))
          (> k 0)))))
(define (snw-width n)
  (if (not have-Sonar)
      (begin (display "RESULT noecho=NONE error=no-sonar") (newline) #f)
      (begin
        (Sonar.timeout-us!        snw-ceiling-us)
        (Sonar.min-interval-us!   snw-gate-us)
        (let* ((raw   (snw-collect n))
               (echoes-in-range
                (let f ((l raw) (a '()))
                  (cond ((null? l) (reverse a))
                        ((and (car l) (> (car l) snw-near-lo-us) (<= (car l) snw-echo-max-us))
                         (f (cdr l) (cons (car l) a)))
                        (else (f (cdr l) a)))))
               (edges (let f ((l raw) (a '()))
                        (cond ((null? l) (reverse a))
                              ((car l) (f (cdr l) (cons (car l) a)))
                              (else (f (cdr l) a)))))
               (k     (length edges))
               (over  (- n k)))
          (let loop ((l raw) (i 1))
            (if (not (null? l))
                (begin (display "RESULT ping ") (display i) (display " us=")
                       (display (if (car l) (car l) 'over-ceiling)) (newline)
                       (loop (cdr l) (+ i 1)))))
          (if (not (null? echoes-in-range))
              (begin
                (display "RESULT noecho verdict=FIELD-NOT-CLEAR in_range_pings=")
                (display (length echoes-in-range))
                (display "/")                 (display n)
                (display " min_us=")          (display (snw-min echoes-in-range))
                (display " implied_m=")
                (display (/ (* 343.0 (snw-min echoes-in-range)) 2000000.0))
                (display " echo_max_us=")     (display snw-echo-max-us)
                (newline)
                (display "RESULT noecho note=something is in front of the sensor; a reading at or ")
                (display "below the rated round trip is an ECHO, not a no-echo pulse.  Clear ~5 m ")
                (display "and re-run; no width reported.")
                (newline)))
          (display "RESULT noecho n=")      (display n)
          (display " edges=")               (display k)
          (display " over_ceiling=")        (display over)
          (display " ceiling_us=")          (display snw-ceiling-us)
          (display " min_us=")              (display (if (> k 0) (snw-min edges) 'none))
          (display " max_us=")              (display (if (> k 0) (snw-max edges) 'none))
          (display " mean_us=")             (display (if (> k 0) (exact->inexact (/ (snw-sum edges) k)) 'none))
          (newline)
          (display "RESULT noecho verdict=")
          (cond
            ((not (null? echoes-in-range))
             (display "FIELD-NOT-CLEAR -- see above; the width is NOT measured"))
            ((= k 0)
             (display "INCONCLUSIVE reason=every-ping-over-ceiling required_timeout_us>")
             (display snw-ceiling-us))
            ((>= (snw-max edges) snw-r1-timeout-us)
             (display "R1-DEFAULT-TOO-LOW measured_max_us=") (display (snw-max edges))
             (display " r1_default_us=")                     (display snw-r1-timeout-us)
             (display " -- F1 IS NOT FIXED on this unit; timeout must exceed the measured max"))
            (else
             (display "R1-DEFAULT-SOUND measured_max_us=") (display (snw-max edges))
             (display " margin_us=")                       (display (- snw-r1-timeout-us (snw-max edges)))))
          (newline)
          (Sonar.defaults!)
          (Sonar.arm!)
          (and (> k 0) (null? echoes-in-range))))))
(define (sonar-noecho-width n)
  (display "SONARBENCH start noecho n=") (display n) (newline)
  (display "RESULT step=1-fixture instruction=place a target 0.1-0.3 m in front NOW") (newline)
  (if (snw-fixture n)
      (begin
        (display "RESULT step=2-clear instruction=CLEAR THE FIELD -- nothing within ~5 m") (newline)
        (snw-width n))
      (display "RESULT step=2-clear SKIPPED -- fixture failed, a width here would be meaningless"))
  (newline)
  (display "SONARBENCH") (display " done") (newline))
