(define (fk-flips! perm)
  (let loop ((flips 0))
    (let ((k (vector-ref perm 0)))
      (if (= k 0) flips
          (begin
            (let swap ((i 0) (j k))
              (if (< i j)
                  (let ((t (vector-ref perm i)))
                    (vector-set! perm i (vector-ref perm j))
                    (vector-set! perm j t)
                    (swap (+ i 1) (- j 1)))))
            (loop (+ flips 1)))))))
(define (fannkuch n)
  (let ((perm1 (make-vector n 0)) (perm (make-vector n 0)) (count (make-vector n 0)))
    (let init ((i 0)) (if (< i n) (begin (vector-set! perm1 i i) (init (+ i 1)))))
    (let outer ((r n) (maxflips 0))
      (let settle ((r r))
        (if (not (= r 1))
            (begin (vector-set! count (- r 1) r) (settle (- r 1)))
            (begin
              (let cp ((i 0)) (if (< i n) (begin (vector-set! perm i (vector-ref perm1 i)) (cp (+ i 1)))))
              (let* ((f (fk-flips! perm))
                     (mf (if (> f maxflips) f maxflips)))
                (let adv ((r 1))
                  (if (= r n) mf
                      (let ((p0 (vector-ref perm1 0)))
                        (let sh ((i 0)) (if (< i r)
