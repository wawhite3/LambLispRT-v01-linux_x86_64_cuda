(define deriv-expr (quote (+ (* 3 x) (* a (* x x)))))
(define (deriv a)
  (cond ((not (pair? a)) (if (eq? a (quote x)) 1 0))
        ((eq? (car a) (quote +)) (cons (quote +) (map deriv (cdr a))))
        ((eq? (car a) (quote -)) (cons (quote -) (map deriv (cdr a))))
        ((eq? (car a) (quote *))
         (list (quote *) a (cons (quote +) (map (lambda (t) (list (quote /) (deriv t) t)) (cdr a)))))
        ((eq? (car a) (quote /))
         (list (quote -) (list (quote /) (deriv (cadr a)) (caddr a))
               (list (quote /) (cadr a)
                     (list (quote *) (caddr a) (caddr a) (deriv (caddr a))))))
        (else (quote error))))
(define (count-atoms e)
  (cond ((null? e) 0)
        ((not (pair? e)) 1)
        (else (+ (count-atoms (car e)) (count-atoms (cdr e))))))
