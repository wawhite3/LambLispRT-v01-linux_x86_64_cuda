    (display "gc-amax-is-boot-seed ") (display (if (= amax 0) 1 0)) (newline)))
(define bench-psram-probe (if (defined? 'bench-psram-probe) bench-psram-probe #f))
(define (bench-psram! name phase)
  (when bench-psram-probe
    (display "BENCH-PSRAM ") (display name) (display " ") (display phase)
    (display " ") (display (Platform.cell-pool-free)) (newline)))
(define (bench-timed/run name thunk08 verify)
  (bench-psram! name "entry")
  (bench-preexpand!)
  (thunk08)
  (bench-psram! name "after-settle")
  (bench-report-blocks! "-warm")
  (bench-report-yuasa!)
  (gc!)
  (bench-psram! name "after-gc")
  (let* ((t0     (current-us))
         (result (thunk08))
         (t1     (current-us))
         (d1     (- t1 t0)))
    (let loop ((reps 1) (prev t1) (lo d1) (hi d1) (hi2 -1))
      (if (and (< (- prev t0) bench-window-us)
               (< reps bench-max-reps))
          (begin (thunk08)
                 (let* ((now (current-us))
                        (d   (- now prev)))
                   (loop (+ reps 1) now
                         (if (< d lo) d lo)
                         (if (> d hi) d hi)
                         (if (> d hi) hi (if (> d hi2) d hi2)))))
          (let* ((_bx  (bench-report-blocks! ""))
                 (dt   (- prev t0))
                 (mean (quotient dt reps))
                 (spread (if (and (> lo 0) (> reps 1)) (quotient (* 100 (- hi lo)) lo) -1))
                 (ok   (verify result)))
            (bench-psram! name "after-thunk")
            (when bench-psram-probe (gc!) (bench-psram! name "after-gc2"))
            (unless ok (set! perf-fail-count (+ perf-fail-count 1)))
            (display name)
            (display "  ")
            (display mean)
            (display " us reps=")
            (display reps)
            (when (>= spread 0)
              (display " spread=")
              (display spread)
              (display " lo=")  (display lo)
              (display " hi=")  (display hi)
              (display " hi2=") (display hi2))
            (display " verified=")
            (display (if ok 1 0))
            (unless ok (display "  *** FAIL got=") (display result) (display " ***"))
            (newline))))))
