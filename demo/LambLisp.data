  (procedure->bytecode (lambda () 'hello)))
(check "quoted list"   '(1 2 3)   (bc-quoted-list))
(check "quoted sym"    'hello     (bc-quoted-sym))
(printf "--- 16. closures / globals capture ---\n")
(define bc-scale-factor 3)
(define bc-scaled
  (procedure->bytecode (lambda (x) (* x bc-scale-factor))))
(check "scale by global 3"   15   (bc-scaled 5))
(set! bc-scale-factor 10)
(check "scale after set! 10"  50   (bc-scaled 5))
(set! bc-scale-factor 3)
(printf "--- 17. bytecode-disasm ---\n")
(define disasm-result (bytecode-disasm bc-add1))
(check-true "disasm is pair" (pair? disasm-result))
(define (disasm-contains? disasm opname)
  (let loop ((l disasm))
    (if (null? l) #f
        (if (and (pair? (car l)) (eq? (caar l) opname))
            #t
            (loop (cdr l))))))
(check-true  "disasm has RETURN"     (disasm-contains? disasm-result 'RETURN))
(check-true  "disasm has LOAD_LOCAL" (disasm-contains? disasm-result 'LOAD_LOCAL))
(printf "--- 18. edge cases ---\n")
(define bc-only-defines
  (procedure->bytecode
   (lambda ()
     (define x 42)
     x)))
(check "body only define"  42  (bc-only-defines))
(define bc-counter-state 0)
(define bc-counter-bump!
  (procedure->bytecode
   (lambda ()
     (set! bc-counter-state (+ bc-counter-state 1))
     bc-counter-state)))
(check "counter bump 1"  1   (bc-counter-bump!))
(check "counter bump 2"  2   (bc-counter-bump!))
(check "counter bump 3"  3   (bc-counter-bump!))
(define bc-many-consts
  (procedure->bytecode
   (lambda () (+ 1 2 3 4 5))))
(check "many consts"   15  (bc-many-consts))
(printf "--- 19. Phase 7 closures ---\n")
(define bc-make-adder
  (procedure->bytecode
   (lambda (n)
     (lambda (x) (+ x n)))))
(check-true  "bc-make-adder bytecode?"  (bytecode? bc-make-adder))
(define bc-add5  (bc-make-adder 5))
(define bc-add7  (bc-make-adder 7))
(check "add5 3"   8   (bc-add5 3))
(check "add5 10"  15  (bc-add5 10))
(check "add7 3"   10  (bc-add7 3))
(check "add5 unchanged"  8  (bc-add5 3))
(check-true  "add5 bytecode?"  (bytecode? bc-add5))
(define bc-adder-mult
  (procedure->bytecode
   (lambda (a b)
     (lambda (x) (+ x a b)))))
(check "two captures"  15  ((bc-adder-mult 3 7) 5))
(check "two captures"  12  ((bc-adder-mult 2 5) 5))
(define bc-always-42
  (procedure->bytecode
   (lambda ()
     (lambda () 42))))
(check "no capture"  42  ((bc-always-42)))
(define bc-tail-inner
  (procedure->bytecode
   (lambda (n)
     (lambda (acc)
       (if (= n 0) acc
           ((bc-tail-inner (- n 1)) (+ acc 1)))))))
(check "tail inner"  5  ((bc-tail-inner 5) 0))
(define disasm-adder (bytecode-disasm bc-make-adder))
(define (disasm-has-op? disasm opname)
  (let loop ((l disasm))
    (cond ((null? l) #f)
          ((and (pair? (car l)) (eq? (caar l) opname)) #t)
          (else (loop (cdr l))))))
(check-true  "outer has MAKE_CLOSURE"  (disasm-has-op? disasm-adder 'MAKE_CLOSURE))
(let ((x 7))
  (check "qq atom"          7            ((procedure->bytecode (lambda (x) `7)) x))
  (check "qq sym"           'a           ((procedure->bytecode (lambda (x) `a)) x))
  (check "qq unquote"       7            ((procedure->bytecode (lambda (x) `,x)) x))
  (check "qq list"          '(a b)       ((procedure->bytecode (lambda (x) `(a b))) x))
  (check "qq list unquote"  '(a 7 b)    ((procedure->bytecode (lambda (x) `(a ,x b))) x))
  (check "qq nested"        '(a (b 7))  ((procedure->bytecode (lambda (x) `(a (b ,x)))) x))
  (let ((xs '(1 2 3)))
    (check "qq splice"  '(a 1 2 3 b)  ((procedure->bytecode (lambda (xs) `(a ,@xs b))) xs))))
(printf "--- B244 eq? mode agreement ---\n")
(define (b244-nan) (/ 0. 0.))
(define (b244-eq-self-ast)  (let ((x (b244-nan))) (eq? x x)))
(define (b244-eq-self-bc)   ((procedure->bytecode (lambda () (let ((x (b244-nan))) (eq? x x))))))
(check "B244 eq? NaN self: modes agree" (b244-eq-self-ast) (b244-eq-self-bc))
(check-true "B244 eq? NaN self is #t"   (b244-eq-self-ast))
(check "B244 eq? 1.5 self: modes agree"
       (let ((x 1.5)) (eq? x x))
       ((procedure->bytecode (lambda () (let ((x 1.5)) (eq? x x))))))
(check "B244 eq? 0.0 vs -0.0: modes agree"
       (eq? 0.0 -0.0)
       ((procedure->bytecode (lambda () (eq? 0.0 -0.0)))))
(check-false "B244 eq? 0.0 vs -0.0 is #f" (eq? 0.0 -0.0))
(check-true  "B244 eqv? NaN self still #t"     (let ((x (b244-nan))) (eqv? x x)))
(check-false "B244 eqv? 0.0 -0.0 still #f"     (eqv? 0.0 -0.0))
(check-true  "B244 eqv? 2.0 (sqrt 4.0) still #t" (eqv? 2.0 (sqrt 4.0)))
(printf "--- P274 procedure->bytecode! ---\n")
(define (p274-plain x) (+ x 1))
(check-false "P274 plain: the binding is AST to start with"  (bytecode? p274-plain))
(check-true  "P274 plain: the RETURN VALUE is bytecode"      (bytecode? (procedure->bytecode p274-plain)))
(check-false "P274 plain: the BINDING is STILL AST"          (bytecode? p274-plain))
(define (p274-bang x) (+ x 1))
(check-false "P274 bang: the binding is AST to start with"   (bytecode? p274-bang))
(check-true  "P274 bang: reports #t"                         (procedure->bytecode! p274-bang))
(check-true  "P274 bang: the BINDING is bytecode"            (bytecode? p274-bang))
(check       "P274 bang: the promoted binding still computes" 43 (p274-bang 42))
(let ((p274-local (lambda (x) (* x 2))))
  (check-false "P274 local: the local binding is AST to start with" (bytecode? p274-local))
  (check-true  "P274 local: reports #t"                             (procedure->bytecode! p274-local))
  (check-true  "P274 local: the LOCAL BINDING is bytecode"          (bytecode? p274-local))
  (check       "P274 local: the promoted local still computes" 10   (p274-local 5)))
(define p274-builtin car)
(check-false "P274 builtin: bang reports #f"                 (procedure->bytecode! p274-builtin))
(check-false "P274 builtin: the binding is not bytecode"     (bytecode? p274-builtin))
(check       "P274 builtin: and it still works" 7            (p274-builtin (list 7 8)))
(printf "--- done ---\n")
