          (let ((d (Platform.free-internal)))
            (gc!) (gc!) (gc!)
            (let ((e (Platform.free-internal)))
              (delay-ms 5000)
              (let ((f (Platform.free-internal)))
                (display "B508-CTL i=") (display i)
                (display " open=")  (display (- a b))
                (display " close=") (display (- b d))
                (display " gc=")    (display (- d e))
                (display " wait=")  (display (- e f))
                (display " int=")   (display f)
                (newline))))
          (loop (+ i 1))))))
(define (b609-frag n)
  (b508-settle)
  (display "B609-BASE free-int=") (display (Platform.free-internal))
  (display " largest-int=") (display (Platform.largest-free-internal)) (newline)
  (let loop ((i 0))
    (if (>= i n)
        (begin (b508-settle)
               (display "B609-END free-int=") (display (Platform.free-internal))
               (display " largest-int=") (display (Platform.largest-free-internal))
               (display "  <- compare BOTH with B609-BASE") (newline))
        (let ((c (open-tcp-client-port b508-target b508-data-port)))
          (if c (close-port c))
          (b508-settle)
          (display "B609 i=") (display i)
          (display " made=") (display (if c "y" "n"))
          (display " free-int=") (display (Platform.free-internal))
          (display " largest-int=") (display (Platform.largest-free-internal))
          (newline)
          (loop (+ i 1))))))
(define (b609-variant label n thunk)
  (b508-settle)
  (let ((a (Platform.free-internal)))
    (let loop ((i 0))
      (if (< i n) (begin (thunk i) (loop (+ i 1)))))
    (b508-settle)
    (let* ((b (Platform.free-internal))
           (d (- a b)))
      (display "B609-BISECT ") (display label)
      (display " n=") (display n)
      (display " total=") (display d)
      (display " per-cycle=") (display (quotient d n))
      (display " end-int=") (display b)
      (newline))))
(define b508-refused-port 9098)
(define (b609-bisect n)
  (b609-variant "E-control-nothing" n
    (lambda (i) #f))
  (b609-variant "A-client-open-close" n
    (lambda (i) (let ((c (open-tcp-client-port b508-target b508-data-port)))
                  (if c (close-port c)))))
  (b609-variant "B-client-REFUSED" n
    (lambda (i) (let ((c (open-tcp-client-port b508-target b508-refused-port)))
                  (if c (close-port c)))))
  (b609-variant "C-client-open-NO-close" n
    (lambda (i) (open-tcp-client-port b508-target b508-data-port)))
  (b609-variant "D-server-open-close" n
    (lambda (i) (let ((s (open-tcp-server-port (+ b508-base i))))
                  (if s (close-port s))))))
(define (b508-settle) (gc!) (gc!) (gc!))
(define (b508-run arm-name arm n)
  (b508-settle)
  (display "B508-BASE ") (display arm-name) (display " after-settle") (b508-mem!) (newline)
  (display "B508-ARM ") (display arm-name)
  (display " heap0=") (display (b508-heap)) (newline)
  (let loop ((i 0))
    (if (>= i n)
        (begin (b508-settle)
               (display "B508-RESID ") (display arm-name)
               (display " after-settle") (b508-mem!)
               (display "  <- compare with B508-BASE: THIS difference is the residual, the")
               (display " per-cycle in-loop slope is mostly garbage") (newline)
               (display "B508-DONE ") (display arm-name)
               (display " completed=") (display n)
               (b508-mem!)
               (display " outbound=ok") (newline))
        (let* ((made (arm i))
               (out  (b508-outbound-ok?)))
          (display "B508 ") (display arm-name)
          (display " cycle=") (display i)
          (display " made=") (display (if made "y" "n"))
          (if (not made) (begin (display " why=") (display b508-why)))
          (display " outbound=") (display (if out "y" "n"))
          (b508-mem!) (newline)
          (if out
              (loop (+ i 1))
              (begin (b508-settle)
                     (display "B508-RESID ") (display arm-name)
                     (display " after-settle-at-failure") (b508-mem!) (newline)
                     (display "B508-RETRY ") (display arm-name)
                     (display " outbound-after-gc=")
                     (display (if (b508-outbound-ok?) "y" "n"))
                     (b508-mem!) (newline)
                     (display "B508-FAIL ") (display arm-name)
                     (display " first-failure-at-cycle=") (display i)
                     (b508-mem!) (newline)))))))
(display "B508 probe loaded; target ") (display b508-target)
(display ":") (display b508-target-port) (newline)
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-22
(display "B554-ARM off walk-globals-was=")
(display (ncg-walk-globals! #f))
(newline)
(load "ll_tests/bench-runner.scm" 0)
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-22
(display "B554-ARM on walk-globals-was=")
(display (ncg-walk-globals! #t))
(newline)
(load "ll_tests/bench-runner.scm" 0)
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-25
(define b631-was-quiet (quiet 'echo))
(define b631-rounds 400)
(define b631-chain  128)
(define (b631-diag) (Platform.gc-diag))
(define (b631-ref d i) (if (> (length d) i) (list-ref d i) 0))
(define (b631-amax   d) (b631-ref d 0))
(define (b631-markq  d) (b631-ref d 6))
(define (b631-sweepq d) (b631-ref d 7))
(define (b631-urgent d) (b631-ref d 9))
(define (b631-bulk   d) (b631-ref d 16))
(define (b631-M      d) (b631-ref d 11))
(define (b631-nfree  d) (b631-ref d 13))
(define (b631-cells  d) (b631-ref d 14))
(define (b631-live   d) (b631-ref d 1))
(define (b631-tmark  d) (b631-ref d 4))
(define (b631-tswp   d) (b631-ref d 5))
(define (b631-gctime d) (b631-ref d 10))
(define (b631-genuine d) (- (b631-urgent d) (b631-bulk d)))
(define (b631-mreq amax k1 ncells k2)
  (if (or (= k1 0) (< k2 2))
      -1
      (let ((p (+ (quotient (* amax 1000) k1)
                  (quotient (* ncells 1000) k2))))
        (quotient (* p k2) (* 1000 (- k2 1))))))
(define (b631-mreq-of d)
  (b631-mreq (b631-amax d) (b631-markq d) (b631-cells d) (b631-sweepq d)))
(define (b631-chain-once n)
  (let loop ((i 0) (acc (list)))
    (if (= i n) acc (loop (+ i 1) (cons i acc)))))
(define b631-findings (list))
(define b631-minmargin 999999)
(define b631-negrounds 0)
(define b631-k1min 999999) (define b631-k1max 0)
(define b631-k2min 999999) (define b631-k2max 0)
(define b631-rmin 999999)  (define b631-rmax 0)
(define b631-tmmin 999999) (define b631-tmmax 0)
(define b631-tsmin 999999) (define b631-tsmax 0)
(define b631-minnfree  999999)
(define (b631-run rounds)
  (let ((d0 (b631-diag)))
    (let loop ((i 0) (prev d0) (g0 (b631-genuine d0)))
      (if (>= i rounds)
          (b631-genuine prev)
          (begin
            (b631-chain-once b631-chain)
            (let* ((d (b631-diag))
                   (g (b631-genuine d))
                   (mr (b631-mreq-of d))
                   (margin (- (b631-M d) mr)))
              (if (< margin b631-minmargin) (set! b631-minmargin margin))
              (if (< margin 0) (set! b631-negrounds (+ b631-negrounds 1)))
              (let ((k1 (b631-markq d)) (k2 (b631-sweepq d))
                    (tm (b631-tmark d)) (ts (b631-tswp d)))
                (if (< k1 b631-k1min) (set! b631-k1min k1))
                (if (> k1 b631-k1max) (set! b631-k1max k1))
                (if (< k2 b631-k2min) (set! b631-k2min k2))
                (if (> k2 b631-k2max) (set! b631-k2max k2))
                (if (< tm b631-tmmin) (set! b631-tmmin tm))
                (if (> tm b631-tmmax) (set! b631-tmmax tm))
                (if (< ts b631-tsmin) (set! b631-tsmin ts))
                (if (> ts b631-tsmax) (set! b631-tsmax ts))
                (if (> k2 0)
                    (let ((r (quotient (* k1 100) k2)))
                      (if (< r b631-rmin) (set! b631-rmin r))
                      (if (> r b631-rmax) (set! b631-rmax r)))))
              (if (< (b631-nfree d) b631-minnfree) (set! b631-minnfree (b631-nfree d)))
              (if (> g g0)
                  (set! b631-findings
                        (cons (list i (b631-M prev) (b631-mreq-of prev) (b631-markq prev)
                                    (b631-sweepq prev) (b631-amax prev) (b631-cells prev)
                                    (b631-nfree prev) (b631-live prev)
                                    (b631-M d) mr (b631-markq d) (b631-sweepq d)
                                    (b631-amax d) (b631-cells d) (b631-nfree d))
                              b631-findings)))
              (loop (+ i 1) d g)))))))
(define (b631-show1 f)
  (display "  round ") (display (list-ref f 0))
  (display " BEFORE M=") (display (list-ref f 1))
  (display " Mreq=")     (display (list-ref f 2))
  (display " margin=")   (display (- (list-ref f 1) (list-ref f 2)))
  (display " k1=")       (display (list-ref f 3))
  (display " k2=")       (display (list-ref f 4))
  (display " amax=")     (display (list-ref f 5))
  (display " cells=")    (display (list-ref f 6))
  (display " nfree=")    (display (list-ref f 7))
  (display " live=")     (display (list-ref f 8))
  (newline)
  (display "           AFTER  M=") (display (list-ref f 9))
  (display " Mreq=")     (display (list-ref f 10))
  (display " margin=")   (display (- (list-ref f 9) (list-ref f 10)))
  (display " k1=")       (display (list-ref f 11))
  (display " k2=")       (display (list-ref f 12))
  (display " amax=")     (display (list-ref f 13))
  (display " cells=")    (display (list-ref f 14))
  (display " nfree=")    (display (list-ref f 15))
  (newline))
(display "B631-MARGIN start rounds=") (display b631-rounds)
(display " chain=") (display b631-chain) (newline)
(define b631-d-pre (b631-diag))
(display "B631-MARGIN pre  M=")    (display (b631-M b631-d-pre))
(display " Mreq=")                 (display (b631-mreq-of b631-d-pre))
(display " k1=")                   (display (b631-markq b631-d-pre))
(display " k2=")                   (display (b631-sweepq b631-d-pre))
(display " amax=")                 (display (b631-amax b631-d-pre))
(display " cells=")                (display (b631-cells b631-d-pre))
(display " live=")                 (display (b631-live b631-d-pre))
(display " nfields=") (display (length b631-d-pre))
(display " genuine=")              (display (b631-genuine b631-d-pre))
(newline)
(define b631-g-end (b631-run b631-rounds))
(display "B631-MARGIN genuine-urgent=") (display (- b631-g-end (b631-genuine b631-d-pre)))
(display " min-margin=") (display b631-minmargin)
(display " min-nfree=")  (display b631-minnfree)
(display " rounds-M-below-formula=") (display b631-negrounds)
(display " findings=")   (display (length b631-findings))
(newline)
(display "B631-RATIO k1=")   (display b631-k1min) (display "..") (display b631-k1max)
(display " k2=")             (display b631-k2min) (display "..") (display b631-k2max)
(display " k1/k2x100=")      (display b631-rmin)  (display "..") (display b631-rmax)
(display " t_mark_ns=")      (display b631-tmmin) (display "..") (display b631-tmmax)
(display " t_sweep_ns=")     (display b631-tsmin) (display "..") (display b631-tsmax)
(display " gc-us=")      (display (- (b631-gctime (b631-diag)) (b631-gctime b631-d-pre)))
(newline)
(for-each b631-show1 (reverse b631-findings))
(display "B631-MARGIN done") (newline)
(quiet b631-was-quiet)
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-26
(define b660-trips 0)
(define (b660-say tag rest)
  (display "B660-") (display tag) (display " ") (display rest) (newline))
(define (b660-dose iters inner)
  (let loop ((k 0) (bad 0))
    (if (= k iters)
        bad
        (let ((r (float32-div inner)))
          (set! b660-trips (+ b660-trips (* 2 inner)))
          (loop (+ k 1)
                (if (and (= r 1.0) (float32? r)) bad (+ bad 1)))))))
(b660-say "PROBE" "start")
(load "ll_tests/benchmarks.scm" 0)
(set! float32-div (procedure->bytecode float32-div))
(ncg-compile-transitive! float32-div)
(let ((sz (if (defined? 'ncg-code-size) (ncg-code-size float32-div) #f)))
  (b660-say "CODESIZE" sz)
  (if (or (not sz) (= sz 0))
      (b660-say "BYTECODE-ONLY" "this dose never entered ncg_div")
      (let ((bad (b660-dose 400 4000)))
        (b660-say "WRONG-VALUES" bad)
        (b660-say "REACHED" b660-trips))))
(b660-say "END" "probe file finished")
;;; Copyright 2026 by Frobenius Norm LLC 2026-10-07
(define b789-was-quiet (quiet (quote echo)))
(if (not (defined? (quote b789-load-kb))) (define b789-load-kb 0))
(define (b789-tier name)
  (guard (e (#t #f))
    (let loop ((ts (ncg-exec-pool-tiers)))
      (cond ((not (pair? ts)) #f)
            ((and (pair? (car ts)) (eq? (car (car ts)) name)) (car ts))
            (else (loop (cdr ts)))))))
(define (b789-tier-size name) (let ((t (b789-tier name))) (if (pair? t) (caddr t) -1)))
(define (b789-tier-used name) (let ((t (b789-tier name))) (if (pair? t) (cadr t) -1)))
(define (b789-say label a b)
  (display label) (display " ") (display a) (display " ") (display b) (newline))
(define b789-diram-size0 (b789-tier-size (quote diram)))
(define b789-free0       (Platform.free-internal))
(define b789-largest0    (Platform.largest-free-internal))
(display "B789-ARM ") (display (if (> b789-load-kb 0) "loaded" "clean")) (newline)
(b789-say "B789-BEFORE free-internal" b789-free0 b789-largest0)
(display "B789-BEFORE diram-size ") (display b789-diram-size0) (newline)
(define b789-refused
  (cond ((< b789-diram-size0 0)
         (display "B789-REFUSED no diram pool in this build -- ")
         (display "'the claim failed' and 'there was never a pool' are different facts") (newline)
         #t)
        ((> b789-diram-size0 0)
         (display "B789-REFUSED this build CLAIMS AT BOOT (diram size ")
         (display b789-diram-size0)
         (display " before any compile) -- it is not the B789 code under test") (newline)
         #t)
        (else #f)))
(define b789-ballast (list))
(define (b789-load! kb)
  (let loop ((n 0))
    (if (< n kb)
        (begin
          (set! b789-ballast (cons (make-bytevector 768 7) b789-ballast))
          (loop (+ n 1))))))
(if (and (not b789-refused) (> b789-load-kb 0)) (b789-load! b789-load-kb))
(define b789-free1    (Platform.free-internal))
(define b789-largest1 (Platform.largest-free-internal))
(if (not b789-refused) (b789-say "B789-AFTER-LOAD free-internal" b789-free1 b789-largest1))
(define b789-refused2
  (if (and (not b789-refused) (> b789-load-kb 0) (>= b789-largest1 b789-largest0))
      (begin
        (display "B789-REFUSED the load did not shrink the largest free block (")
        (display b789-largest0) (display " -> ") (display b789-largest1)
        (display ") -- the manipulation did not happen, so a claim proves nothing") (newline)
        #t)
      b789-refused))
(define (b789-victim n) (let loop ((i 0) (acc 0)) (if (< i n) (loop (+ i 1) (modulo (+ acc (* i 3)) 97)) acc)))
(define b789-landed
  (if b789-refused2 #f (guard (e (#t (quote raised))) (compile-low-latency! (procedure->bytecode b789-victim)))))
(define b789-diram-size2 (b789-tier-size (quote diram)))
(define b789-diram-used2 (b789-tier-used (quote diram)))
(define b789-largest2    (Platform.largest-free-internal))
(if (not b789-refused2)
    (begin
      (display "B789-CLAIM landed ") (display b789-landed) (newline)
      (display "B789-AFTER diram used/size ") (display b789-diram-used2)
      (display " ") (display b789-diram-size2) (newline)
      (b789-say "B789-AFTER free-internal" (Platform.free-internal) b789-largest2)
      (display "B789-VERDICT ")
      (cond ((> b789-diram-size2 0)
             (display "CLAIMED size ") (display b789-diram-size2)
             (display " largest-before-claim ") (display b789-largest1))
            (else
             (display "DID-NOT-CLAIM largest-at-attempt ") (display b789-largest1)
             (display " needed 32768")))
      (newline)))
(display "--- b789-lazy-claim done ---") (newline)
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-22
(guard (e (#t #f)) (load "bacnet.scm" 0))
(define bac-pass 0)
(define bac-fail 0)
(define (bac-check name expected actual)
  (if (equal? expected actual)
      (begin (set! bac-pass (+ bac-pass 1)) (display "PASS ") (display name) (newline))
      (begin (set! bac-fail (+ bac-fail 1))
             (display "FAIL ") (display name)
             (display " | expected ") (write expected)
             (display " | got ") (write actual) (newline))))
(define (bv . bytes) (apply bytevector bytes))
(define (bl b)
  (let loop ((i (- (bytevector-length b) 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (bytevector-u8-ref b i) acc)))))
(bac-check "objid-device-12"      #x0200000c (bacnet-objid bacnet-object-device 12))
(bac-check "objid-ai-1"           1          (bacnet-objid bacnet-object-analog-input 1))
(bac-check "objid-av-max-inst"    #x00bfffff (bacnet-objid bacnet-object-analog-value #x3fffff))
(bac-check "objid-type-back"      8          (bacnet-objid-type (bacnet-objid 8 12345)))
(bac-check "objid-inst-back"      12345      (bacnet-objid-instance (bacnet-objid 8 12345)))
(bac-check "objid-roundtrip-bo"   '(4 99)
           (let ((o (bacnet-objid bacnet-object-binary-output 99)))
             (list (bacnet-objid-type o) (bacnet-objid-instance o))))
(bac-check "uint-85-is-1-byte"    '(85)        (bl (bacnet-uint-bytes 85)))
(bac-check "uint-255-is-1-byte"   '(255)       (bl (bacnet-uint-bytes 255)))
(bac-check "uint-256-is-2-bytes"  '(1 0)       (bl (bacnet-uint-bytes 256)))
(bac-check "uint-65536-is-4"      '(0 1 0 0)   (bl (bacnet-uint-bytes 65536)))
(bac-check "ctx-0-len-4-is-0x0C"  '(#x0c)      (bl (bacnet-context-tag 0 4)))
(bac-check "ctx-1-len-1-is-0x19"  '(#x19)      (bl (bacnet-context-tag 1 1)))
(bac-check "open-tag-3-is-0x3E"   '(#x3e)      (bl (bacnet-open-tag 3)))
(bac-check "close-tag-3-is-0x3F"  '(#x3f)      (bl (bacnet-close-tag 3)))
(bac-check "ctx-uint-propid-85"   '(#x19 #x55) (bl (bacnet-context-uint 1 85)))
(bac-check "ctx-objid-ai-1"       '(#x0c 0 0 0 1)
           (bl (bacnet-context-objid 0 (bacnet-objid bacnet-object-analog-input 1))))
(bac-check "app-real-72.5"        '(#x44 #x42 #x91 #x00 #x00) (bl (bacnet-app-value 72.5)))
(bac-check "app-unsigned-1"       '(#x21 1)    (bl (bacnet-app-value 1)))
(bac-check "app-bool-true"        '(#x11)      (bl (bacnet-app-value #t)))
(bac-check "app-bool-false"       '(#x10)      (bl (bacnet-app-value #f)))
(bac-check "app-null"             '(#x00)      (bl (bacnet-app-value 'null)))
(bac-check "app-enumerated-1"     '(#x91 1)    (bl (bacnet-app-value '(enumerated 1))))
(bac-check "who-is-frame" '(#x81 #x0b #x00 #x08 #x01 #x00 #x10 #x08)
           (bl (bacnet-encode-who-is)))
(bac-check "read-property-frame"
           '(#x81 #x0a #x00 #x11 #x01 #x04 #x00 #x05 #x00 #x0c
             #x0c #x00 #x00 #x00 #x01 #x19 #x55)
           (bl (bacnet-encode-read-property 0 (bacnet-objid bacnet-object-analog-input 1)
                                            bacnet-prop-present-value)))
(bac-check "write-property-frame"
           '(#x81 #x0a #x00 #x1a #x01 #x04 #x00 #x05 #x01 #x0f
             #x0c #x00 #x80 #x00 #x03 #x19 #x55
             #x3e #x44 #x42 #x88 #x00 #x00 #x3f #x49 #x08)
           (bl (bacnet-encode-write-property 1 (bacnet-objid bacnet-object-analog-value 3)
                                             bacnet-prop-present-value 68.0 8)))
(define bac-ack-real
  (bv #x81 #x0a #x00 #x17 #x01 #x00 #x30 #x00 #x0c
      #x0c #x00 #x00 #x00 #x01 #x19 #x55 #x3e #x44 #x42 #x91 #x00 #x00 #x3f))
(bac-check "decode-real-ack"      72.5  (bacnet-decode-read-ack bac-ack-real 0))
(bac-check "decode-wrong-invoke"  #f    (bacnet-decode-read-ack bac-ack-real 1))
(bac-check "decode-enumerated-ack" '(enumerated 1)
           (bacnet-decode-read-ack
            (bv #x81 #x0a #x00 #x14 #x01 #x00 #x30 #x02 #x0c
                #x0c #x00 #xc0 #x00 #x05 #x19 #x55 #x3e #x91 #x01 #x3f) 2))
(bac-check "decode-string-ack" "AHU1"
           (bacnet-decode-read-ack
            (bv #x81 #x0a #x00 #x19 #x01 #x00 #x30 #x03 #x0c
