(define (gc-amax)   (list-ref (Platform.gc-diag) 0))
(define (gc-churn n) (do ((k 0 (+ k 1))) ((= k n) #f) (cons k k)))
(define gc-amax-base (gc-amax))
(define gc-burst-n (max 4000 (+ gc-amax-base 2000)))
(define gc-burst (let loop ((i gc-burst-n) (acc '())) (if (= i 0) acc (loop (- i 1) (cons i acc)))))
(gc-churn 2000)
(ll-ext-check-true "gc/decay-burst-live" (pair? gc-burst))
(define gc-amax-peak (gc-amax))
(syslog "  gc/amax: base=~a burst_n=~a peak=~a~%" gc-amax-base gc-burst-n gc-amax-peak)
(set! gc-burst #f)
(define gc-amax-after
  (let loop ((i 0) (a gc-amax-peak))
    (if (or (< a gc-amax-peak) (>= i 400000)) a
        (begin (gc-churn 2000) (loop (+ i 2000) (gc-amax))))))
(ll-ext-check-true "gc/amax-ratcheted-up"       (> gc-amax-peak gc-amax-base))
(ll-ext-check-true "gc/amax-decays-after-burst" (< gc-amax-after gc-amax-peak))
(define gc-blocks0 (Platform.n-cell-blocks))
(Platform.expand-to-n-blocks! (+ gc-blocks0 2))
(ll-ext-check-true "gc/expansion-grows-heap" (> (Platform.n-cell-blocks) gc-blocks0))
(ll-ext-check-raises "b190/empty-let"          (lambda () (let ())))
(ll-ext-check-raises "b190/empty-let-binding"  (lambda () (let ((x 1)))))
(ll-ext-check-raises "b190/empty-let*"         (lambda () (let* ())))
(ll-ext-check-raises "b190/empty-let*-binding" (lambda () (let* ((x 1)))))
(ll-ext-check-raises "b190/empty-letrec"       (lambda () (letrec ())))
(ll-ext-check-raises "b190/empty-letrec-bind"  (lambda () (letrec ((x 1)))))
(ll-ext-check-raises "b190/empty-named-let"    (lambda () (let lp ((n 1)))))
(ll-ext-check-raises "b190/empty-let-in-arith" (lambda () (+ 1 (let ((x 1))))))
(ll-ext-check-true  "b180/empty-begin"         (begin (begin) #t))
(ll-ext-check-false "b190/begin-is-not-null"   (null? (begin)))
(ll-ext-check-false "b190/void-matches-if"     (null? (if #f #f)))
(ll-ext-check-true  "b180/do-empty-result"     (begin (do ((k 0 (+ k 1))) ((= k 3)) k) #t))
(ll-ext-check-false "b190/do-empty-not-null"   (null? (do ((k 0 (+ k 1))) ((= k 3)) k)))
(define (b190-empty-let-proc) (let ((x 1))))
(ll-ext-check-false  "b190/compiler-refuses-empty-let"
                     (bytecode? (procedure->bytecode b190-empty-let-proc)))
(ll-ext-check-raises "b190/compiled-empty-let-raises"
                     (lambda () ((procedure->bytecode b190-empty-let-proc))))
(define (b191-bad-car) (car 5))
(define b191-compiled (procedure->bytecode b191-bad-car))
(ll-ext-check-true   "b191/proc-did-compile"   (bytecode? b191-compiled))
(ll-ext-check-raises "b191/error-in-compiled-proc-raises" (lambda () (b191-compiled)))
(ll-ext-check-true   "b191/vm-survived"        #t)
(ll-ext-news "\n--- system / system-capture ---\n")
(define ll-ext-host? (integer? (system "true")))
(ll-ext-check-true "system/true-is-0-or-unsupported"
                   (or (not ll-ext-host?) (= 0 (system "true"))))
(ll-ext-check-true "system/exit-3-decodes-to-3"
                   (or (not ll-ext-host?) (= 3 (system "exit 3"))))
(ll-ext-check-true "system-capture/returns-status-and-output"
                   (or (not ll-ext-host?)
                       (let ((r (system-capture "echo hello")))
                         (and (pair? r) (= 0 (car r)) (string=? "hello\n" (cdr r))))))
(ll-ext-check-true "system-capture/failing-command-keeps-both"
                   (or (not ll-ext-host?)
                       (let ((r (system-capture "echo err; exit 2")))
                         (and (pair? r) (= 2 (car r)) (string=? "err\n" (cdr r))))))
(ll-ext-check-true "system-capture/stderr-not-captured"
                   (or (not ll-ext-host?)
                       (let ((r (system-capture "echo oops 1>&2")))
                         (and (pair? r) (string=? "" (cdr r))))))
(ll-ext-check-true "system-capture/stderr-folded-on-request"
                   (or (not ll-ext-host?)
                       (let ((r (system-capture "echo oops 2>&1")))
                         (and (pair? r) (string=? "oops\n" (cdr r))))))
(ll-ext-check-true "system-capture/large-output-not-truncated"
                   (or (not ll-ext-host?)
                       (= 23893 (string-length (cdr (system-capture "seq 1 5000"))))))
(define ll-ext-expected-checks 69)
(define ll-ext-ran (+ ll-ext-pass ll-ext-fail))
(if (not (= ll-ext-ran ll-ext-expected-checks))
  (begin
    (set! ll-ext-fail (+ ll-ext-fail 1))
    (ll-ext-warn "FAIL ll-ext/assertion-count  expected=~a  ran=~a  -- ASSERTIONS VANISHED (a check raised outside a thunk, or the declared total is stale)\n"
                 ll-ext-expected-checks ll-ext-ran)))
(ll-ext-news "\n=== ll-extensions: ~a passed, ~a failed ===\n" ll-ext-pass ll-ext-fail)
(if (= ll-ext-fail 0)
  (ll-ext-news "ALL PASSED\n")
  (ll-ext-warn "~a FAILED\n" ll-ext-fail))
(define *pass* 0)
(define *fail* 0)
(define *skip* 0)
(define (check name expected actual)
  (if (equal? expected actual)
    (begin (set! *pass* (+ *pass* 1)) (news "PASS ~a\n" name))
    (begin (set! *fail* (+ *fail* 1)) (warn "FAIL ~a  expected=~a  got=~a\n" name expected actual))))
(define (check-true name actual)
  (if actual
    (begin (set! *pass* (+ *pass* 1)) (news "PASS ~a\n" name))
    (begin (set! *fail* (+ *fail* 1)) (warn "FAIL ~a  expected=#t  got=~a\n" name actual))))
(define (skip name . why)
  (set! *skip* (+ *skip* 1))
  (if (null? why)
    (news "SKIP ~a\n" name)
    (news "SKIP ~a  (~a)\n" name (car why))))
(define backend (llarduino-backend))
(define simulated? (equal? backend "null"))
(display "\n=== LLArduino conformance: backend ") (display backend) (display " ===\n")
(check-true "backend name is a string"            (string? backend))
(let* ((m0 (millis)) (u0 (micros)))
  (check-true "millis returns an integer"         (integer? m0))
  (check-true "micros returns an integer"         (integer? u0))
  (check-true "millis is non-negative"            (>= m0 0))
  (delay_ms 25)
  (let ((m1 (millis)) (u1 (micros)))
    (check-true "millis advances over delay_ms"   (>= m1 m0))
    (check-true "micros advances over delay_ms"   (>= u1 u0))
    (check-true "delay_ms(25) elapsed >= 20ms"    (>= (- m1 m0) 20))
    (check-true "delay_ms(25) elapsed < 2000ms"   (< (- m1 m0) 2000))))
(let ((u0 (micros)))
  (delay_us 2000)
  (check-true "delay_us(2000) elapsed >= 1ms"     (>= (- (micros) u0) 1000)))
(check "print(255, HEX) is FF, no 0x prefix" "FF"     (llarduino-fmt-int 255 16))
(check "print(255, DEC)"                     "255"    (llarduino-fmt-int 255 10))
(check "print(5, BIN)"                       "101"    (llarduino-fmt-int 5 2))
(check "print(8, OCT)"                       "10"     (llarduino-fmt-int 8 8))
(check "negative signs in base 10"           "-42"    (llarduino-fmt-int -42 10))
(check "zero prints as 0"                    "0"      (llarduino-fmt-int 0 10))
(check "print(double) defaults to 2 places"  "1.50"   (llarduino-fmt-real 1.5 2))
(check "print(double, 0) has no point"       "3"      (llarduino-fmt-real 3.14159 0))
(check "print(double, 4)"                    "3.1416" (llarduino-fmt-real 3.14159 4))
(check "println terminator is CRLF"          "\\r\\n" (llarduino-eol))
(check "bit(0)"            1   (bit 0))
(check "bit(7)"            128 (bit 7))
(check "bitRead(5,0)"      1   (bitRead 5 0))
(check "bitRead(5,1)"      0   (bitRead 5 1))
(check "bitSet(0,3)"       8   (bitSet 0 3))
(check "bitClear(255,0)"   254 (bitClear 255 0))
(check "highByte(#x1234)"  18  (highByte 4660))
(check "lowByte(#x1234)"   52  (lowByte 4660))
(if (not simulated?)
    (skip "Tier B pin writes"
          "real backend -- a pin write moves hardware; refusing to drive an unseen board")
    (begin
      (pinMode 13 1)
      (digitalWrite 13 1)
      (check-true "digitalWrite HIGH reads back"      (digitalRead 13))
      (digitalWrite 13 0)
      (check-true "digitalWrite LOW reads back"       (not (digitalRead 13)))
      (digitalWrite 13 #t)
      (check-true "digitalWrite #t is HIGH"           (digitalRead 13))
      (digitalWrite 13 #f)
      (check-true "digitalWrite #f is LOW"            (not (digitalRead 13)))
      (digitalWrite 13 1)
      (digitalWrite 14 0)
      (check-true "pins are independent"              (and (digitalRead 13)
                                                           (not (digitalRead 14))))
      (analogWrite 5 200)
      (check "analogWrite/analogRead loopback"  200   (analogRead 5))
      (analogWrite 5 0)
      (check "analogWrite 0"                    0     (analogRead 5))
      (digitalWrite 0 0)
      (digitalWrite 99999 1)
      (check-true "out-of-range pin is harmless"      (not (digitalRead 0)))))
(if simulated?
    (skip "Tier C device reads" "simulated backend -- nothing to read")
    (begin
      (pinMode 0 0)
      (check-true "digitalRead returns a boolean"     (boolean? (digitalRead 0)))
      (check-true "millis on device is sane"          (> (millis) 0))))
(display "\n=== LLArduino TEST SUMMARY: ")
(display *pass*) (display " passed, ")
(display *fail*) (display " failed, ")
(display *skip*) (display " skipped ===\n")
(define llarduino-test-pass *pass*)
(define llarduino-test-fail *fail*)
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-20
(define llip-auth-was-quiet (quiet))
(define *la-pass* 0)
(define *la-fail* 0)
(define (la-chk name got want)
  (if (equal? got want)
      (begin (set! *la-pass* (+ *la-pass* 1)) (display "PASS ") (display name) (newline))
      (begin (set! *la-fail* (+ *la-fail* 1))
             (display "FAIL ") (display name)
             (display " got=") (display got) (display " want=") (display want) (newline))))
(define la-expected 9)
(define la-have-keys (file-exists? "llip-test-privkey.scm"))
(if (not la-have-keys)
    (begin (display "LLIP-AUTH-TESTS SKIPPED -- no llip-test-privkey.scm in data/\n")
           (display "  (generate with: python3 w3_ai_scripts/llip_keygen.py llip-test)\n")))
(define (la-run)
  (la-chk 'load-keys (begin (llip-load-keys "llip-test-privkey.scm" "llip-test-pubkey.scm")
                            (> (length *llip-trusted*) 0))
          #t)
  (la-chk 'pubkey-id-len (bytevector-length (llip-pubkey-id *llip-pubkey*)) 8)
  (la-chk 'pubkey-id-stable (equal? (llip-pubkey-id *llip-pubkey*)
                                    (llip-pubkey-id *llip-pubkey*)) #t)
  (let ((a (bytevector 1 2 3 4)) (b (bytevector 9 9 9 9)))
    (la-chk 'nonce-order-asymmetric
            (equal? (hmac-sha256 a b) (hmac-sha256 b a)) #f))
  (la-chk 'unknown-key-rejected (llip--trusted-by-id (make-bytevector 8 0)) #f)
  (la-chk 'known-key-resolves   (if (llip--trusted-by-id (llip-pubkey-id *llip-pubkey*)) #t #f) #t)
  (let* ((sk (make-bytevector 32 7))
         (iv (ll-random-bytes 12))
         (pt (string->utf8 "(eval (+ 1 2))"))
         (ct (llip-aes-gcm-encrypt (llip--aes-key sk) iv pt)))
    (la-chk 'envelope-roundtrip
            (equal? pt (llip-aes-gcm-decrypt (llip--aes-key sk) iv ct)) #t)
    (la-chk 'tampered-ciphertext-raises
            (guard (e (#t 'raised))
              (let ((bad (bytevector-copy ct)))
                (bytevector-u8-set! bad 0 (bitwise-xor (bytevector-u8-ref bad 0) 1))
                (llip-aes-gcm-decrypt (llip--aes-key sk) iv bad)
                'accepted))
            'raised)
    (la-chk 'wrong-session-key-raises
            (guard (e (#t 'raised))
              (llip-aes-gcm-decrypt (llip--aes-key (make-bytevector 32 8)) iv ct)
              'accepted)
            'raised)))
(if la-have-keys (la-run))
(display "LLIP-AUTH-TESTS ") (display *la-pass*) (display " pass, ")
(display *la-fail*) (display " fail, ")
(display (+ *la-pass* *la-fail*)) (display " ran, ")
(display (if la-have-keys la-expected 0)) (display " declared")
(newline)
(if (and la-have-keys (not (= (+ *la-pass* *la-fail*) la-expected)))
    (begin (display "LLIP-AUTH-TESTS-FAIL checks vanished -- one raised outside its guard, or the declared total is stale")
           (newline)))
(if (> *la-fail* 0)
    (begin (display "LLIP-AUTH-TESTS-FAIL ") (display *la-fail*) (display " check(s) failed") (newline))
    (display "--- llip-auth-tests done ---\n"))
(quiet llip-auth-was-quiet)
;;; Copyright 2026 by Frobenius Norm LLC 2026-10-14
(define *lls-pass* 0)
(define *lls-fail* 0)
(define (lls-chk name got want)
  (if (equal? got want)
      (begin (set! *lls-pass* (+ *lls-pass* 1))
             (display "PASS ") (display name) (newline))
      (begin (set! *lls-fail* (+ *lls-fail* 1))
             (display "FAIL ") (display name)
             (display " got=")  (write got)
             (display " want=") (write want) (newline))))
(define lls-expected 20)
(define (lls-mark where)
  (display ";; about to poll: ") (display where)
  (display " -- if the log stops here, that poll did not return") (newline))
(define (lls-reply port)
  (let ((v (read port)))
    (when (char-ready? port)
      (let ((c (peek-char port)))
        (when (and (char? c) (char=? c #\newline)) (read-char port))))
    v))
(define lls-port 18854)
(define lls-have-machine? (guard (e (#t #f)) (procedure? llip-srv-phase)))
(define lls-ran #f)
(if (not lls-have-machine?)
    (lls-chk "server-has-b854-state-machine" #f #t)
    (guard (e (#t (if lls-ran
                      (begin
                        (display "FAIL llip-server-tests aborted mid-suite (the listener WAS obtained): ")
                        (display (if (error-object? e) (error-object-message e) e))
                        (newline))
                      (begin
                        (display "SKIPPED llip-server-tests (no TCP listener on this target: ")
                        (display (if (error-object? e) (error-object-message e) e))
                        (display ")") (newline)))))
      (let ((srv (llip-make-tcp-server lls-port "testtoken")))
        (set! lls-ran #t)
    (lls-chk "s0-phase-idle"            (llip-srv-phase srv) 'idle)
    (lls-chk "s0-conn-empty"            (llip-srv-conn  srv) #f)
    (llip-server-poll srv)
    (lls-chk "s1-poll-no-client-idle"   (llip-srv-phase srv) 'idle)
    (let ((cli (open-tcp-client-port "127.0.0.1" lls-port)))
      (lls-mark "s2 accept (client connected, silent)")
      (llip-server-poll srv)
      (lls-chk "s2-accept-await-auth"   (llip-srv-phase srv) 'await-auth)
      (lls-chk "s2-accept-conn-live"    (if (llip-srv-conn srv) #t #f) #t)
      (lls-mark "s3 idle silent client -- THE B854 ARM")
      (llip-server-poll srv)
      (lls-chk "s3-idle-client-returns" (llip-srv-phase srv) 'await-auth)
      (lls-chk "s3-banner-is-hello"     (car (lls-reply cli)) 'hello)
      (write '(auth "testtoken") cli) (newline cli)
      (lls-mark "s4 auth frame")
      (llip-server-poll srv)
      (lls-chk "s4-auth-phase-ready"    (llip-srv-phase srv) 'ready)
      (lls-chk "s4-auth-reply-ok"       (car (lls-reply cli)) 'ok)
      (lls-mark "s5 authenticated but idle")
      (llip-server-poll srv)
      (lls-chk "s5-authed-idle-returns" (llip-srv-phase srv) 'ready)
      (write '(ping) cli) (newline cli)
      (lls-mark "s6 one ping")
      (llip-server-poll srv)
      (lls-chk "s6-ping-reply-ok"       (car (lls-reply cli)) 'ok)
      (write '(eval (+ 1 2))   cli) (newline cli)
      (write '(eval (+ 10 20)) cli) (newline cli)
      (lls-mark "s7 two queued requests, polling ONCE")
      (llip-server-poll srv)
      (lls-chk "s7-first-answered"      (lls-reply cli) '(ok 3))
      (lls-chk "s7-one-frame-per-call"  (char-ready? cli) #f)
      (lls-mark "s7 second poll")
      (llip-server-poll srv)
      (lls-chk "s7-second-answered"     (lls-reply cli) '(ok 30))
      (write '(bye) cli) (newline cli)
      (lls-mark "s8 bye")
      (llip-server-poll srv)
      (lls-chk "s8-bye-conn-cleared"    (llip-srv-conn  srv) #f)
      (lls-chk "s8-bye-phase-idle"      (llip-srv-phase srv) 'idle)
      (close-port cli))
    (let ((cli2 (open-tcp-client-port "127.0.0.1" lls-port)))
      (lls-mark "s9 re-accept after a completed session")
      (llip-server-poll srv)
      (lls-chk "s9-reaccept-await-auth" (llip-srv-phase srv) 'await-auth)
      (close-port cli2))
        (llip-srv-drop! srv)
        (close-port (llip-srv-port srv)))
      (let ((legacy (list (open-tcp-server-port (+ lls-port 1)) "tok")))
        (llip-server-poll legacy)
        (lls-chk "legacy-descriptor-upgraded" (length legacy) 5)
        (lls-chk "legacy-descriptor-idle"     (llip-srv-phase legacy) 'idle)
        (close-port (llip-srv-port legacy)))
      (lls-chk "non-descriptor-refused"
               (guard (e (#t 'raised)) (llip-server-poll 'nonsense) 'no-raise)
               'raised)))
(display "llip-server-tests: ") (display *lls-pass*) (display " pass, ")
(display *lls-fail*) (display " fail, ") (display lls-expected) (display " expected")
(newline)
(if lls-ran
    (if (not (= (+ *lls-pass* *lls-fail*) lls-expected))
        (begin (display "FAIL llip-server-tests-declared-total got=")
               (display (+ *lls-pass* *lls-fail*))
               (display " want=") (display lls-expected) (newline)))
    (begin (display "llip-server-tests: did not run on this target -- declared-total check")
           (display " not applied (see the line above for why)") (newline)))
; Copyright 2026 by Frobenius Norm LLC 2026-04-12 00:00:00
(define llip-test-pass 0)
(define llip-test-fail 0)
(define (llip-test-reset!)
  (set! llip-test-pass 0)
  (set! llip-test-fail 0))
(define (llip-check label got expected)
  (if (equal? got expected)
    (begin
      (set! llip-test-pass (+ llip-test-pass 1))
      (display "  pass: ") (display label) (newline))
    (begin
      (set! llip-test-fail (+ llip-test-fail 1))
      (display "  FAIL: ") (display label) (newline)
      (display "    expected: ") (write expected) (newline)
      (display "    got:      ") (write got)      (newline))))
(define (llip-check-true label val)
  (llip-check label (if val #t #f) #t))
(define (llip-test-section name thunk17)
  (display "--- ") (display name) (newline)
  (thunk17))
(define (llip-test-default sym fallback)
  (let ((b (dict-ref? (interaction-environment) sym)))
    (if b (cdr b) fallback)))
(define llip-test-host  (llip-test-default 'llip-test-host  "127.0.0.1"))
(define llip-test-port  (llip-test-default 'llip-test-port  8443))
(define llip-test-token (llip-test-default 'llip-test-token "llip-test-secret"))
(define llip-test-cert  (llip-test-default 'llip-test-cert  #f))
(define llip-test-tcp?  (llip-test-default 'llip-test-tcp?  #f))
(define (llip-test-connect)
  (if llip-test-tcp?
    (llip-connect-tcp llip-test-host llip-test-port llip-test-token)
    (if llip-test-cert
      (llip-connect llip-test-host llip-test-port llip-test-token llip-test-cert)
      (llip-connect llip-test-host llip-test-port llip-test-token))))
(llip-test-section "1. connection and ping" (lambda ()
  (define c (llip-test-connect))
  (llip-check-true "connected" c)
  (llip-check-true "ping" (llip-ping c))
  (llip-disconnect c)))
(llip-test-section "2. write and read" (lambda ()
  (define c (llip-test-connect))
  (define path "/llip-test-wr.txt")
  (llip-check-true "write"      (llip-write c path "hello llip\n"))
  (llip-check      "read back"  (llip-read c path) "hello llip\n")
  (llip-disconnect c)))
(llip-test-section "3. append" (lambda ()
  (define c (llip-test-connect))
  (define path "/llip-test-ap.txt")
  (llip-write  c path "line1\n")
  (llip-append c path "line2\n")
  (llip-check "appended" (llip-read c path) "line1\nline2\n")
  (llip-delete c path)
  (llip-disconnect c)))
(llip-test-section "4. stat" (lambda ()
  (define c (llip-test-connect))
  (define path "/llip-test-st.txt")
  (llip-write c path "0123456789")
  (llip-check "file size" (llip-stat c path) 10)
  (llip-delete c path)
  (llip-disconnect c)))
(llip-test-section "5. directory-list" (lambda ()
  (define c (llip-test-connect))
  (llip-write c "/llip-ls-a.txt" "a")
  (llip-write c "/llip-ls-b.txt" "b")
  (define listing (llip-ls c "/"))
  (define (ls-contains? lst name)
    (or (member name lst) (member (string-append "/" name) lst)))
  (llip-check-true "ls contains a" (ls-contains? listing "llip-ls-a.txt"))
  (llip-check-true "ls contains b" (ls-contains? listing "llip-ls-b.txt"))
  (llip-delete c "/llip-ls-a.txt")
  (llip-delete c "/llip-ls-b.txt")
  (llip-disconnect c)))
(llip-test-section "6. delete" (lambda ()
  (define c (llip-test-connect))
  (define path "/llip-test-del.txt")
  (llip-write c path "x")
  (llip-delete c path)
  (define deleted?
    (guard (e (#t #t))
      (llip-read c path)
      #f))
  (llip-check "deleted" deleted? #t)
  (llip-disconnect c)))
(llip-test-section "7. rename" (lambda ()
  (define c (llip-test-connect))
  (llip-write c "/llip-old.txt" "renamed")
  (llip-rename c "/llip-old.txt" "/llip-new.txt")
  (llip-check "renamed content" (llip-read c "/llip-new.txt") "renamed")
  (define old-gone?
    (guard (e (#t #t))
      (llip-read c "/llip-old.txt")
      #f))
  (llip-check "old gone" old-gone? #t)
  (llip-delete c "/llip-new.txt")
  (llip-disconnect c)))
(llip-test-section "8. chunked read" (lambda ()
  (define c (llip-test-connect))
  (define path "/llip-test-chunk.txt")
  (llip-write c path "abcdefghij")
  (llip-check "chunk 0-4" (llip-read-chunk c path 0 4) "abcd")
  (llip-check "chunk 4-4" (llip-read-chunk c path 4 4) "efgh")
  (llip-check "chunk 8-4" (llip-read-chunk c path 8 4) "ij")
  (llip-delete c path)
  (llip-disconnect c)))
(llip-test-section "9. remote load" (lambda ()
  (define c (llip-test-connect))
  (define path "/llip-test-load.scm")
  (llip-write c path "(+ 1 2)")
  (llip-check "load result" (llip-load c path) 3)
  (llip-delete c path)
  (llip-disconnect c)))
(llip-test-section "10. path safety" (lambda ()
  (define c (llip-test-connect))
  (define (expect-error thunk18)
    (guard (e (#t #t)) (thunk18) #f))
  (llip-check "reject .." (expect-error (lambda () (llip-read c "/../etc/passwd"))) #t)
  (llip-check "reject no-slash" (expect-error (lambda () (llip-read c "relative"))) #t)
  (llip-disconnect c)))
(llip-test-section "11. upload/download" (lambda ()
  (define c (llip-test-connect))
  (let ((local-src "/tmp/llip-up-src.txt")
        (remote    "/llip-upload-test.txt")
        (local-dst "/tmp/llip-up-dst.txt"))
    (let ((p (open-output-file local-src)))
      (write-string "upload-content-123" p)
      (close-port p))
    (llip-upload c local-src remote)
    (llip-download c remote local-dst)
    (let* ((p   (open-input-file local-dst))
           (out (open-output-string)))
      (let loop ()
        (let ((ch (read-char p)))
          (unless (eof-object? ch) (write-char ch out) (loop))))
      (close-port p)
      (llip-check "round-trip" (get-output-string out) "upload-content-123"))
    (llip-delete c remote))
  (llip-disconnect c)))
(llip-test-section "12. remote eval sync" (lambda ()
  (define c (llip-test-connect))
  (llip-eval c '(define (llip-test-fib n) (if (< n 3) 1 (+ (llip-test-fib (- n 1)) (llip-test-fib (- n 2))))))
  (llip-check     "eval arith"        (llip-eval c '(+ 1 2))                   3)
  (llip-check     "eval fib(10)"      (llip-eval c '(llip-test-fib 10))       55)
  (llip-check     "eval string-append" (llip-eval c '(string-append "a" "b"))  "ab")
  (llip-check     "eval list"         (llip-eval c '(list 1 2 3))              '(1 2 3))
  (llip-disconnect c)))
(llip-test-section "13. eval error propagation" (lambda ()
  (define c (llip-test-connect))
  (define caught-boom?
    (guard (e (#t #t))
      (llip-eval c '(error "boom" "test"))
      #f))
  (llip-check-true "eval/error-propagated" caught-boom?)
  (llip-check-true "eval/session-survives" (llip-ping c))
  (define caught-unbound?
    (guard (e (#t #t))
      (llip-eval c '(this-symbol-does-not-exist-xyzzy))
      #f))
  (llip-check-true "eval/unbound-propagated" caught-unbound?)
  (llip-disconnect c)))
(llip-test-section "14. llip-make-remote" (lambda ()
  (define c (llip-test-connect))
  (define rfib (llip-make-remote c 'llip-test-fib))
  (llip-check "make-remote fib(10)" (rfib 10) 55)
  (llip-check "make-remote fib(12)" (rfib 12) 144)
  (llip-disconnect c)))
(llip-test-section "15. async eval" (lambda ()
  (define c (llip-test-connect))
  (llip-eval-send c '(llip-test-fib 15))
  (define result #f)
  (let loop ((tries 0))
    (set! result (llip-eval-recv c))
    (cond
      (result #t)
      ((> tries 100000) (display "  TIMEOUT async eval\n"))
      (else (loop (+ tries 1)))))
  (llip-check "async fib(15)" result 610)
  (llip-eval-send c '(+ 10 20))
  (set! result #f)
  (let loop ((tries 0))
    (set! result (llip-eval-recv c))
    (cond
      (result #t)
      ((> tries 100000) (display "  TIMEOUT async eval 2\n"))
      (else (loop (+ tries 1)))))
  (llip-check "async 10+20" result 30)
  (llip-disconnect c)))
(llip-test-section "16. llip-make-remote-async" (lambda ()
  (define c (llip-test-connect))
  (define cb-result #f)
  (define fire-async
    (llip-make-remote-async c 'llip-test-fib
      (lambda (v) (set! cb-result v))))
  (fire-async 10)
  (let loop ((tries 0))
    (llip-poll-async c)
    (cond
      (cb-result #t)
      ((> tries 100000) (display "  TIMEOUT make-remote-async\n"))
      (else (loop (+ tries 1)))))
  (llip-check "make-remote-async fib(10)" cb-result 55)
  (llip-disconnect c)))
(llip-test-section "17. error paths" (lambda ()
  (define c (llip-test-connect))
  (define (expect-error thunk19)
    (guard (e (#t #t)) (thunk19) #f))
  (llip-check-true "err/read-missing"
    (expect-error (lambda () (llip-read c "/llip-no-such-file-xyzzy.txt"))))
  (llip-check-true "err/stat-missing"
    (expect-error (lambda () (llip-stat c "/llip-no-such-file-xyzzy.txt"))))
  (llip-check-true "err/delete-missing"
    (expect-error (lambda () (llip-delete c "/llip-no-such-file-xyzzy.txt"))))
  (llip-check-true "err/rename-missing"
    (expect-error (lambda () (llip-rename c "/llip-no-src-xyzzy.txt" "/llip-no-dst-xyzzy.txt"))))
  (llip-check-true "err/bad-path-relative"
    (expect-error (lambda () (llip-read c "relative-path.txt"))))
  (llip-check-true "err/bad-path-dotdot"
    (expect-error (lambda () (llip-read c "/../etc/passwd"))))
  (let ((port (llip-port c)))
    (llip-send-raw port '(frobnicate "arg"))
    (let ((resp (llip-recv-raw port)))
      (llip-check "err/unknown-op-tag" (and (pair? resp) (car resp)) 'error)))
  (llip-check-true "err/session-after-unknown-op" (llip-ping c))
  (llip-disconnect c)))
(llip-test-section "18. bad auth" (lambda ()
  (define p
    (if llip-test-tcp?
      (open-tcp-client-port llip-test-host llip-test-port)
      (open-tls-client-port llip-test-host llip-test-port)))
  (define hello (llip-recv-raw p))
  (llip-check-true "bad-auth/hello-received"
    (and (pair? hello) (eq? (car hello) 'hello)))
  (llip-send-raw p (list 'auth "DEFINITELY-WRONG-TOKEN"))
  (define resp (llip-recv-raw p))
  (llip-check-true "bad-auth/server-closes" (eof-object? resp))
  (close-port p)))
(llip-test-section "19. sequential connections" (lambda ()
  (define N 10)
  (define successes 0)
  (let loop ((i 0))
    (when (< i N)
      (guard (e (#t #f))
        (define c (llip-test-connect))
        (when (llip-ping c)
          (set! successes (+ successes 1)))
        (llip-disconnect c))
      (loop (+ i 1))))
  (llip-check "sequential/all-10-succeeded" successes N)))
(llip-test-section "20. large file" (lambda ()
  (define c (llip-test-connect))
  (define path "/llip-t-big.txt")
  (define chunk-16 "0123456789abcdef")
  (define big-string
    (let loop ((n 0) (acc ""))
      (if (= n 256)
        acc
        (loop (+ n 1) (string-append acc chunk-16)))))
  (llip-check "large/size" (string-length big-string) 4096)
  (llip-write c path big-string)
  (llip-check "large/stat"      (llip-stat c path) 4096)
  (llip-check "large/read-full" (llip-read c path) big-string)
  (define reassembled
    (let loop ((off 0) (acc ""))
      (if (>= off 4096)
        acc
        (loop (+ off 512) (string-append acc (llip-read-chunk c path off 512))))))
  (llip-check "large/reassembled" reassembled big-string)
  (llip-delete c path)
  (llip-disconnect c)))
(display "llip tests: ")
(display llip-test-pass) (display " pass, ")
(display llip-test-fail) (display " fail")
(newline)
