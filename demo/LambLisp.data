(define tag1 (hx #x58 #xe2 #xfc #xce #xfa #x7e #x30 #x61
                 #x36 #x7f #x1d #x57 #xa4 #xe7 #x45 #x5a))
(define ct2 (hx #x03 #x88 #xda #xce #x60 #xb6 #xa3 #x92
                #xf3 #x28 #xc2 #xb9 #x71 #xb2 #xfe #x78))
(define tag2 (hx #xab #x6e #x47 #xd4 #x2c #xec #x13 #xbd
                 #xf5 #x3a #x67 #xb2 #x12 #x57 #xbd #xdf))
(define k3  (hx #xfe #xff #xe9 #x92 #x86 #x65 #x73 #x1c
                #x6d #x6a #x8f #x94 #x67 #x30 #x83 #x08))
(define iv3 (hx #xca #xfe #xba #xbe #xfa #xce #xdb #xad #xde #xca #xf8 #x88))
(define pt3 (hx #xd9 #x31 #x32 #x25 #xf8 #x84 #x06 #xe5 #xa5 #x59 #x09 #xc5 #xaf #xf5 #x26 #x9a
                #x86 #xa7 #xa9 #x53 #x15 #x34 #xf7 #xda #x2e #x4c #x30 #x3d #x8a #x31 #x8a #x72
                #x1c #x3c #x0c #x95 #x95 #x68 #x09 #x53 #x2f #xcf #x0e #x24 #x49 #xa6 #xb5 #x25
                #xb1 #x6a #xed #xf5 #xaa #x0d #xe6 #x57 #xba #x63 #x7b #x39 #x1a #xaf #xd2 #x55))
(define ct3 (hx #x42 #x83 #x1e #xc2 #x21 #x77 #x74 #x24 #x4b #x72 #x21 #xb7 #x84 #xd0 #xd4 #x9c
                #xe3 #xaa #x21 #x2f #x2c #x02 #xa4 #xe0 #x35 #xc1 #x7e #x23 #x29 #xac #xa1 #x2e
                #x21 #xd5 #x14 #xb2 #x54 #x66 #x93 #x1c #x7d #x8f #x6a #x5a #xac #x84 #xaa #x05
                #x1b #xa3 #x0b #x39 #x6a #x0a #xac #x97 #x3d #x58 #xe0 #x91 #x47 #x3f #x59 #x85))
(define tag3 (hx #x4d #x5c #x2a #xf3 #x27 #xcd #x64 #xa6
                 #x2c #xf3 #x5a #xbd #x2b #xa6 #xfa #xb4))
(define (bv-append a b)
  (let* ((na (bytevector-length a))
         (nb (bytevector-length b))
         (r  (make-bytevector (+ na nb) 0)))
    (let loop ((i 0)) (if (< i na) (begin (bytevector-u8-set! r i (bytevector-u8-ref a i)) (loop (+ i 1)))))
    (let loop ((i 0)) (if (< i nb) (begin (bytevector-u8-set! r (+ na i) (bytevector-u8-ref b i)) (loop (+ i 1)))))
    r))
(define (crypto-suite)
  (crypto-chk 'selftest-backend (llip-aes-gcm-selftest) #t)
  (crypto-chk 'gcm-case1-empty (llip-aes-gcm-encrypt k0 iv0 (make-bytevector 0 0)) tag1)
  (crypto-chk 'gcm-case2-oneblock
              (llip-aes-gcm-encrypt k0 iv0 (make-bytevector 16 0))
              (bv-append ct2 tag2))
  (crypto-chk 'gcm-case3-fourblock
              (llip-aes-gcm-encrypt k3 iv3 pt3)
              (bv-append ct3 tag3))
  (crypto-chk 'gcm-decrypt-known (llip-aes-gcm-decrypt k3 iv3 (bv-append ct3 tag3)) pt3)
  (crypto-chk 'gcm-forged-tag-refused
              (guard (e (#t 'refused))
                (let ((bad (bv-append ct3 tag3)))
                  (bytevector-u8-set! bad 64 (bitwise-xor (bytevector-u8-ref bad 64) 1))
                  (llip-aes-gcm-decrypt k3 iv3 bad)
                  'accepted))
              'refused)
  (crypto-chk 'gcm-altered-ciphertext-refused
              (guard (e (#t 'refused))
                (let ((bad (bv-append ct3 tag3)))
                  (bytevector-u8-set! bad 0 (bitwise-xor (bytevector-u8-ref bad 0) 1))
                  (llip-aes-gcm-decrypt k3 iv3 bad)
                  'accepted))
              'refused)
  (crypto-chk 'gcm-bad-key-length-refused
              (guard (e (#t 'refused))
                (llip-aes-gcm-encrypt (make-bytevector 15 0) iv0 (make-bytevector 4 0))
                'accepted)
              'refused))
(define rsa-test-n 17228651051260992152740333037418788243318441657880650478369493914253805092531006163003759849957646319727088828616297)
(define rsa-test-e 17)
(define rsa-test-d 21410916799412997704316901040702719440743713742188049476007979628765453317941694563170475210928524093167564497443)
(define rsa-test-pub  (list (cons 'n rsa-test-n) (cons 'e rsa-test-e)))
(define rsa-test-priv (list (cons 'n rsa-test-n) (cons 'd rsa-test-d)))
(define (crypto-rsa-suite)
  (crypto-chk 'rsa-modexp-roundtrip-hash-sized
              (let ((h (bytevector->bignum (sha256 (string->utf8 "isolation arm")))))
                (= (modular-exponent (modular-exponent h rsa-test-d rsa-test-n)
                                     rsa-test-e rsa-test-n)
                   h))
              #t)
  (let* ((msg  (string->utf8 "the genuine message"))
         (sig  (rsa-sign msg rsa-test-priv)))
    (crypto-chk 'rsa-verify-accepts-genuine (rsa-verify msg sig rsa-test-pub) #t)
    (crypto-chk 'rsa-verify-rejects-other-message
                (rsa-verify (string->utf8 "a different message") sig rsa-test-pub) #f)
    (crypto-chk 'rsa-verify-rejects-mangled-sig
                (rsa-verify msg (modulo (+ sig 1) rsa-test-n) rsa-test-pub) #f)))
(crypto-suite)
(crypto-rsa-suite)
(display "CRYPTO-TESTS ") (display *crypto-pass*) (display " pass, ")
(display *crypto-fail*) (display " fail, ")
(display (+ *crypto-pass* *crypto-fail*)) (display " ran, ")
(display crypto-expected) (display " declared")
(newline)
(if (not (= (+ *crypto-pass* *crypto-fail*) crypto-expected))
    (begin (display "FAIL crypto-tests/declared-total -- checks vanished: one raised outside its guard, or the declared total is stale")
           (newline)))
(if (> *crypto-fail* 0)
    (begin (display "CRYPTO-TESTS-FAIL ") (display *crypto-fail*) (display " check(s) failed") (newline))
    (display "--- crypto-tests done ---\n"))
(quiet crypto-was-quiet)
