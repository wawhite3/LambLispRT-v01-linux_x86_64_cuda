(define (fill2! arr rows cols vals)
  (let loop ((i 0) (vs vals))
    (when (< i rows)
      (let jloop ((j 0) (vs vs))
        (if (< j cols)
            (begin (array-set! arr i j (car vs)) (jloop (+ j 1) (cdr vs)))
            (loop (+ i 1) vs))))))
