            (begin
              (guard (exn (#t (llip-srv-drop! srv))) (llip-srv-skip-interframe-ws! conn))
              (when (and (llip-srv-conn srv) (char-ready? conn))
                (guard (exn (#t (llip-srv-drop! srv)))
