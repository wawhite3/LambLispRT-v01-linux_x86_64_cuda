(when (file-exists? "eye-cam.scm")  (load "eye-cam.scm" 0))   ;; P136 Ph2 camera+ST7789 demo glue (ESP32-S3-EYE only)
(when (file-exists? "Cuda.scm") (load "Cuda.scm"))
(when (file-exists? "rsa.scm")      (load "rsa.scm" 0))
