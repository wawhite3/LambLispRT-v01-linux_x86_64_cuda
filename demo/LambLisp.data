(define (b910-err-text thunk)
  (let ((p (open-output-string)))
    (guard (e (#t (begin (display e p) (get-output-string p))))
      (thunk)
      "no-raise")))
(define (b910-has? hay needle)
  (let ((nh (string-length hay)) (nn (string-length needle)))
    (let loop ((i 0))
      (cond ((> (+ i nn) nh) #f)
            ((string=? (substring hay i (+ i nn)) needle) #t)
            (else (loop (+ i 1)))))))
(define (b910-bucket-of sym)
  (let* ((d (dict-new 16)) (f (car d)))
    (dict-bind! d sym 1)
    (let loop ((i 0))
      (cond ((>= i 16) -1) ((not (null? (vector-ref f i))) i) (else (loop (+ i 1)))))))
(define b910-ic (modulo (+ (b910-bucket-of 'b910zzz) 1) 16))
(define (b910-msg corrupt)
  (let* ((d (dict-new 16)) (f (car d)))
    (vector-set! f b910-ic corrupt)
    (b910-err-text (lambda () (dict-ref d 'b910zzz)))))
