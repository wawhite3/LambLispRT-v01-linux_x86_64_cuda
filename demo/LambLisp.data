(define gcpb:n-fields 36)
(define gcpb:worst               0)
(define gcpb:mean                1)
(define gcpb:cnt-1ms             2)
(define gcpb:cnt-5ms             3)
(define gcpb:pause-sum           4)
(define gcpb:discarded          21)
(define gcpb:worst-i            22)
(define gcpb:worst-ngc-d        23)
(define gcpb:worst-nfree-d      24)
(define gcpb:worst-ctrl         25)
(define gcpb:ctrl-over100       26)
(define gcpb:worst-grow-d       27)
(define gcpb:markstack-grows    28)
(define gcpb:worst-urgent-d     29)
(define gcpb:urgent-calls       30)
(define gcpb:urgent-max         31)
(define gcpb:startmark-max      32)
(define gcpb:startmark-nroots   33)
(define gcpb:extraroots-max     34)
(define gcpb:extraroots-pushes  35)
(define (gcpb-check r)
  (if (not (= (length r) gcpb:n-fields))
      (begin (display "GCPAUSE-FAIL gc-pause-bench returned ") (display (length r))
             (display " fields, expected ") (display gcpb:n-fields)
             (display " -- the mop3's shape changed; see B427 and the table at its signature")
             (newline)))
  r)
(define heap-size (if (defined? 'w3-gcpause-heap) w3-gcpause-heap 30000))
(define gc-wifi-off
  (cond ((and (defined? 'w3-gcpause-keep-wifi) (= w3-gcpause-keep-wifi 1)) 0)
        ((defined? 'WiFi.mode) (begin (WiFi.mode 0) 1))
        (else 0)))
(define gc-wifi-status
  (if (defined? 'WiFi.status)
      (guard (e (#t -1)) (WiFi.status))
      -1))
(display "gc-wifi-off    ") (display gc-wifi-off) (newline)
(display "gc-wifi-status ") (display gc-wifi-status) (newline)
(if (= gc-wifi-off 0)
    (begin
      (display ";; WARNING: WiFi.mode is not available, the radio was NOT silenced.")
      (newline)
      (display ";; On a single-core part the worst-case below may be one FreeRTOS tick of")
      (newline)
      (display ";; preemption (~1000us at 1000Hz), not a collector pause -- see B434.")
      (newline)))
(define baseline   14891)
(define cellpop    (+ baseline heap-size))
(define n-cycles   30)
(define n-allocs-cap 3000000)
(define n-allocs
  (if (defined? 'w3-gcpause-allocs)
      w3-gcpause-allocs
      (let ((want (* n-cycles cellpop)))
        (if (> want n-allocs-cap) n-allocs-cap want))))
(display "GC pause bench: ") (display n-allocs)
(display " allocs, live heap ") (display heap-size) (display " cells") (newline)
(define warm-rounds-max 8)
(define warm-allocs     (quotient n-allocs 2))
(define warm-result
  (let loop ((round 0) (prev (Platform.n-cell-blocks)) (stable 0))
    (if (or (>= stable 2) (>= round warm-rounds-max))
        (list round prev stable)
        (begin
          (gc-pause-bench warm-allocs heap-size)
          (let ((now (Platform.n-cell-blocks)))
            (loop (+ round 1) now (if (= now prev) (+ stable 1) 0)))))))
(Platform.expand-to-n-blocks! (Platform.max-cell-blocks))
(define gcd0    (Platform.gc-diag))
(define yuasa-M (list-ref gcd0 11))
(define yuasa-N (list-ref gcd0 12))
(define pool    (* (Platform.n-cell-blocks) (Platform.cell-block-size)))
(display "gc-yuasa-M     ") (display yuasa-M) (newline)
(display "gc-yuasa-N     ") (display yuasa-N) (newline)
(display "gc-pool-cells  ") (display pool) (newline)
(display "gc-budget-ns   ") (display (Platform.gc-budget-ns)) (newline)
(display "gc-budget-achieved-ns ") (display (Platform.gc-budget-achieved-ns)) (newline)
(display "gc-diag-full   ") (display (Platform.gc-diag)) (newline)
(if (< pool yuasa-N)
    (begin
      (display "gc-yuasa-VIOLATION 1") (newline)
      (display ";; pool ") (display pool) (display " < yuasa_N ") (display yuasa-N)
      (display " -- the collector WILL expand during the timed region; the worst-pause figure")
      (newline)
      (display ";; below will contain a ~12.6ms block allocation (measured n8r2-01 2026-09-24,")
      (newline)
      (display ";; NOT the ~300us this line used to claim) and is NOT a collector pause")
      (newline))
    (begin (display "gc-yuasa-VIOLATION 0") (newline)))
(display "gc-warm-rounds ") (display (list-ref warm-result 0)) (newline)
(display "gc-nblocks-cap ") (display (Platform.max-cell-blocks)) (newline)
(display "gc-nblocks-warm ") (display (Platform.n-cell-blocks)) (newline)
(if (< (list-ref warm-result 2) 2)
    (begin
      (display "gc-warm-UNSTABLE 1")
      (newline)
      (display ";; heap still expanding after ")
      (display warm-rounds-max)
      (display " warmup rounds -- the pause figure below INCLUDES expansion stalls (B215)")
      (newline))
    (begin (display "gc-warm-UNSTABLE 0") (newline)))
(define gc0   (list-ref (Platform.gc-diag) 10))
(define wall0 (Platform.micros))
(define was-quiet (quiet))
(let* ((r       (gc-pause-bench n-allocs heap-size))
       (ignore1 (quiet was-quiet))
       (worst   (list-ref (gcpb-check r) gcpb:worst))
       (mean    (list-ref r gcpb:mean))
       (cnt-1ms (list-ref r gcpb:cnt-1ms))
       (cnt-5ms (list-ref r gcpb:cnt-5ms)))
  (display "gc-pause-worst ") (display worst)   (display " us") (newline)
  (display "gc-pause-mean  ") (display mean)    (display " us") (newline)
  (display "gc-pause->1ms  ") (display cnt-1ms) (newline)
  (display "gc-pause->5ms  ") (display cnt-5ms) (newline)
  (display "gc-pause-sumus ") (display (list-ref r gcpb:pause-sum)) (newline)
  (display "gc-pause-hist")
  (let loop ((i 5))
    (if (< i 21)
        (begin (display " ") (display (list-ref r i)) (loop (+ i 1)))))
  (newline)
  (display "gc-pause-heap  ") (display heap-size) (newline)
  (display "gc-discarded   ") (display (list-ref r gcpb:discarded)) (newline)
  (display "gc-worst-i     ") (display (list-ref r gcpb:worst-i)) (newline)
  (display "gc-worst-ngc-d ") (display (list-ref r gcpb:worst-ngc-d)) (newline)
  (display "gc-worst-nfree-d ") (display (list-ref r gcpb:worst-nfree-d)) (newline)
  (display "gc-ctrl-worst  ") (display (list-ref r gcpb:worst-ctrl)) (newline)
  (display "gc-ctrl-over100 ") (display (list-ref r gcpb:ctrl-over100)) (newline)
  (display "gc-worst-grow-d ") (display (list-ref r gcpb:worst-grow-d)) (newline)
  (display "gc-markstack-grows ") (display (list-ref r gcpb:markstack-grows)) (newline)
  (display "gc-worst-urgent-d ") (display (list-ref r gcpb:worst-urgent-d)) (newline)
  (display "gc-urgent-calls ") (display (list-ref r gcpb:urgent-calls)) (newline)
  (display "gc-urgent-max-us ") (display (list-ref r gcpb:urgent-max)) (newline)
  (display "gc-startmark-max-us ") (display (list-ref r gcpb:startmark-max)) (newline)
  (display "gc-startmark-nroots ") (display (list-ref r gcpb:startmark-nroots)) (newline)
  (display "gc-extraroots-max-us ") (display (list-ref r gcpb:extraroots-max)) (newline)
  (display "gc-extraroots-pushes ") (display (list-ref r gcpb:extraroots-pushes)) (newline)
  (let ((d (Platform.gc-diag)))
    (display "gc-amax        ") (display (list-ref d 0)) (newline)
    (display "gc-live        ") (display (list-ref d 1)) (newline)
    (display "gc-npass-idle  ") (display (list-ref d 2)) (newline)
    (display "gc-npass-work  ") (display (list-ref d 3)) (newline)
    (display "gc-t-mark-ns   ") (display (list-ref d 4)) (newline)
    (display "gc-t-sweep-ns  ") (display (list-ref d 5)) (newline)
    (display "gc-mark-q      ") (display (list-ref d 6)) (newline)
    (display "gc-sweep-q     ") (display (list-ref d 7)) (newline)
    (display "gc-urgent-max  ") (display (list-ref d 8)) (newline)
    (display "gc-urgent-n    ") (display (list-ref d 9)) (newline)
    (display "gc-urgent-bulk ") (display (list-ref d 16)) (newline))
  (display "gc-wall-us     ") (display (- (Platform.micros) wall0)) (newline)
  (display "gc-allocs      ") (display n-allocs) (newline)
  (display "gc-collections ") (display n-cycles) (newline)
  (display "gc-load-us     ") (display (- (list-ref (Platform.gc-diag) 10) gc0)) (newline)
  (display "gc-cellpop     ") (display (Platform.total-cells)) (newline)
  (display "gc-blocks      ") (display (Platform.n-cell-blocks))
  (display " base ") (display (Platform.cell-block-size))
  (display " exp ")  (display (Platform.extension-block-size)) (newline)
  (display "gc-cellfree    ")
  (display (- (Platform.total-cells) (list-ref (Platform.gc-diag) 1))) (newline)
  (display "gc-cellused    ") (display (list-ref (Platform.gc-diag) 1)) (newline)
  (display "gc-nblocks     ") (display (Platform.n-cell-blocks)) (newline)
(display "--- done ---") (newline))
;;; Copyright 2026 by Frobenius Norm LLC 2026-05-28 20:30:00
(define (check-true name actual)
  (if actual
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a expected=#t got=~a\n" name actual)))
(define (check name expected actual)
  (if (equal? expected actual)
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a expected=~a got=~a\n" name expected actual)))
(define (alloc-pressure n)
  (let loop ((i n) (acc '()))
    (if (= i 0) (length acc)
        (loop (- i 1) (cons (vector i (* i 2) (* i 3)) acc)))))
(define my-cond
  (syntax-rules (else)
    ((_ (else e ...))           (begin e ...))
    ((_ (test e ...) rest ...)  (if test (begin e ...) (my-cond rest ...)))))
(define my-let
  (syntax-rules ()
    ((_ ((var init) ...) body ...)
     ((lambda (var ...) body ...) init ...))))
(define my-and
  (syntax-rules ()
    ((_)           #t)
    ((_ e)         e)
    ((_ e1 e2 ...) (let ((t e1)) (if t (my-and e2 ...) #f)))))
(define my-or
  (syntax-rules ()
    ((_)           #f)
    ((_ e)         e)
    ((_ e1 e2 ...) (let ((t e1)) (if t t (my-or e2 ...))))))
(printf "--- B16/1: cond chain ---\n")
(let loop ((i 50))
  (when (> i 0)
    (alloc-pressure 80)
    (let ((r1 (my-cond (#f 'a) (#f 'b) (else 'c)))
          (r2 (my-cond (#t 'yes) (else 'no)))
          (r3 (my-cond (#f 1) (#f 2) (#f 3) (else 4))))
      (if (not (and (equal? r1 'c) (equal? r2 'yes) (equal? r3 4)))
          (printf "FAIL B16/1 iter ~a: r1=~a r2=~a r3=~a\n" i r1 r2 r3)))
    (loop (- i 1))))
(gc!)
(check-true "B16/1 integrity after cond-chain" (lamb-integrity-check))
(printf "--- B16/2: let lockstep ellipsis ---\n")
(let loop ((i 50))
  (when (> i 0)
    (alloc-pressure 80)
    (let ((r1 (my-let ((x 3) (y 4)) (* x y)))
          (r2 (my-let ((a 1) (b 2) (c 3)) (+ a b c)))
          (r3 (my-let ((p 10) (q 20) (r 30)) (list p q r))))
      (if (not (and (= r1 12) (= r2 6) (equal? r3 '(10 20 30))))
          (printf "FAIL B16/2 iter ~a: r1=~a r2=~a r3=~a\n" i r1 r2 r3)))
    (loop (- i 1))))
(gc!)
(check-true "B16/2 integrity after let-ellipsis" (lamb-integrity-check))
(printf "--- B16/3: and/or recursive ---\n")
(let loop ((i 50))
  (when (> i 0)
    (alloc-pressure 80)
    (let ((r1 (my-and 1 2 3))
          (r2 (my-and #f 2 3))
          (r3 (my-or #f #f 42))
          (r4 (my-or 1 2 3))
          (r5 (my-and (my-or #f 5) (my-and 1 2 3))))
      (if (not (and (= r1 3) (equal? r2 #f) (= r3 42) (= r4 1) (= r5 3)))
          (printf "FAIL B16/3 iter ~a: r1=~a r2=~a r3=~a r4=~a r5=~a\n"
                  i r1 r2 r3 r4 r5)))
    (loop (- i 1))))
(gc!)
(check-true "B16/3 integrity after and/or" (lamb-integrity-check))
(printf "--- B16/4: vector-set! during mark ---\n")
(let loop ((i 50))
  (when (> i 0)
    (alloc-pressure 80)
    (let ((v (make-vector 8 #f)))
      (vector-set! v 0 (cons 1 2))
      (vector-set! v 1 (cons 3 4))
      (vector-set! v 2 'sym)
      (vector-set! v 3 (make-vector 3 99))
      (vector-set! v 0 (cons 10 20))
      (vector-set! v 3 (list 1 2 3))
      (let ((r (+ (car (vector-ref v 0))
                  (car (vector-ref v 1)))))
        (if (not (= r 13))
            (printf "FAIL B16/4 iter ~a: r=~a\n" i r))))
    (loop (- i 1))))
(gc!)
(check-true "B16/4 integrity after vector-set!" (lamb-integrity-check))
(printf "--- B16/5: gc! before/after every expansion ---\n")
(let loop ((i 50))
  (when (> i 0)
    (gc!)
    (alloc-pressure 60)
    (let ((r1 (my-cond (#f 'a) (#f 'b) (else 'c)))
          (r2 (my-let ((x 3) (y 4)) (* x y)))
          (r3 (my-and 1 2 3))
          (r4 (my-or #f 42)))
      (gc!)
      (if (not (and (equal? r1 'c) (= r2 12) (= r3 3) (= r4 42)))
          (printf "FAIL B16/5 iter ~a: r1=~a r2=~a r3=~a r4=~a\n" i r1 r2 r3 r4))
      (if (not (lamb-integrity-check))
          (printf "FAIL B16/5 integrity at iter ~a\n" i)))
    (loop (- i 1))))
(check-true "B16/5 integrity after combined stress" (lamb-integrity-check))
(printf "--- B16 regression done ---\n")
;;; Copyright 2026 by Frobenius Norm LLC 2026-09-17
(define gcs-was-quiet (quiet))
(define *gcs-pass* 0)
(define *gcs-fail* 0)
(define *gcs-skip* 0)
(define (gchk name ok detail)
  (if ok
      (begin (set! *gcs-pass* (+ *gcs-pass* 1)) (display "PASS ") (display name) (newline))
      (begin (set! *gcs-fail* (+ *gcs-fail* 1))
             (display "FAIL ") (display name) (display " -- ") (display detail) (newline))))
(define (gskip name why)
  (set! *gcs-skip* (+ *gcs-skip* 1))
  (display "SKIP ") (display name) (display " -- ") (display why) (newline))
(define (gcs-amax)     (list-ref (Platform.gc-diag) 0))
(define (gcs-live)     (list-ref (Platform.gc-diag) 1))
(define (gcs-urgent)   (list-ref (Platform.gc-diag) 9))
(define (gcs-yuasa-m)  (list-ref (Platform.gc-diag) 11))
(define (gcs-free)     (list-ref (Platform.gc-diag) 13))
(define (gcs-total)    (list-ref (Platform.gc-diag) 14))
(define (gcs-cycles n)
  (if (> n 0)
      (begin (let b ((k 2000) (a (list))) (if (= k 0) a (b (- k 1) (cons k a))))
             (gcs-cycles (- n 1)))))
(define (gcs-build n acc) (if (= n 0) acc (gcs-build (- n 1) (cons (cons n n) acc))))
(define gcs-total0 (gcs-total))
(define gcs-chunk  (quotient gcs-total0 8))
(define gcs-retained '())
(set! gcs-retained (gcs-build gcs-chunk '()))
(gcs-cycles 3)
(let ((a (gcs-amax)) (occ (- (gcs-total) (gcs-free))))
  (gchk "amax-tracks-rising-live"
        (>= a (quotient occ 2))
        (list 'amax a 'occupancy occ
              "-- Amax is under half the live occupancy, so yuasa_M is paced from an estimate the"
              "workload has already outrun (the P153 failure)")))
(define gcs-amax-peak (gcs-amax))
(set! gcs-retained '())
(gcs-cycles 12)
(gchk "amax-decays-after-drop"
      (< (gcs-amax) gcs-amax-peak)
      (list 'peak gcs-amax-peak 'now (gcs-amax)
            "-- Amax did not fall after the live set was dropped.  Since P153 it ratchets UP"
            "instantly and DECAYS DOWN toward live; a non-decreasing value means monotonic"
            "behaviour has been restored and every later cycle is over-paced by a transient"))
(gcs-cycles 24)
(gchk "amax-decay-floored"
      (and (> (gcs-amax) 0) (> (gcs-yuasa-m) 0))
      (list 'amax (gcs-amax) 'yuasa_M (gcs-yuasa-m)
            "-- decay reached zero.  _gc_Amax_floor exists precisely to stop yuasa_M collapsing,"
            "which would stall marking altogether"))
(set! gcs-retained (gcs-build gcs-chunk '()))
(set! gcs-retained '())
(gcs-cycles 12)
(define gcs-live-settled (gcs-live))
(gcs-cycles 24)
(let ((later (gcs-live)))
  (gchk "burst-returns-cells"
        (<= later (+ gcs-live-settled (quotient gcs-chunk 2)))
        (list 'settled-live gcs-live-settled 'after-24-more later 'burst gcs-chunk
              "-- the LIVE SET kept growing after the burst was dropped and the collector had"
              "settled, so cells are not being returned: a leak, or a sweep missing cells"
              "allocated while marking was in progress")))
(define gcs-urgent0 (gcs-urgent))
(define (gcs-churn n)
  (if (> n 0)
      (begin (gcs-build (quotient gcs-chunk 16) '())
             (gcs-churn (- n 1)))))
(gcs-churn 24)
(let ((used (- (gcs-urgent) gcs-urgent0)))
  (gchk "alloc-outruns-pacing"
        (<= used 8)
        (list 'urgent-calls used
              "-- sustained allocation drove the collector into synchronous catch-up repeatedly."
              "That is the pacing estimate failing to keep up with the allocation rate, which is"
              "the failure P153 was written for")))
(display "gc-stress-tests: ")
(display *gcs-pass*) (display " pass, ")
(display *gcs-fail*) (display " fail, ")
(display *gcs-skip*) (display " skip")
(newline)
(display "Total: ") (display *gcs-pass*) (display " pass, ")
(display *gcs-fail*) (display " fail") (newline)
(display "--- gc-stress done ---") (newline)
(quiet gcs-was-quiet)
