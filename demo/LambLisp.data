(define lowlat-was-quiet (quiet))
(define (lowlat-work-a n) (let loop ((i 0) (acc 0)) (if (< i n) (loop (+ i 1) (modulo (+ acc (* i 3)) 97)) acc)))
(define (lowlat-work-b n) (let loop ((i 0) (acc 0)) (if (< i n) (loop (+ i 1) (modulo (+ acc (* i 3)) 97)) acc)))
(define lowlat-inner 200)
(define lowlat-samples 400)
(define (lowlat-pool-used)
  (guard (e (#t -1))
    (let ((t (ncg-exec-pool-tiers)))
      (cond ((not (pair? t)) -1)
            ((pair? (car t)) (cadr (car t)))
            ((and (pair? (cdr t)) (number? (cadr t))) (cadr t))
            (else -1)))))
(define lowlat-pool0 (lowlat-pool-used))
(define lowlat-bc-a (procedure->bytecode lowlat-work-a))
(define lowlat-bc-b (procedure->bytecode lowlat-work-b))
(ncg-compile lowlat-bc-a)
(define lowlat-pool-after-a (lowlat-pool-used))
(define lowlat-pinned (compile-low-latency! lowlat-bc-b))
(define lowlat-pool-after-b (lowlat-pool-used))
(define (lowlat-max-of thunk22 n)
  (let loop ((i 0) (worst 0) (total 0))
    (if (>= i n)
        (cons worst total)
        (let* ((t0 (micros))
               (ignored (thunk22))
               (dt (- (micros) t0)))
          (loop (+ i 1) (if (> dt worst) dt worst) (+ total dt))))))
(define (lowlat-run)
  (let loop ((i 0) (wa 0) (ta 0) (wb 0) (tb 0))
    (if (>= i lowlat-samples)
        (list wa ta wb tb)
        (let* ((a0 (micros)) (xa (lowlat-bc-a lowlat-inner)) (da (- (micros) a0))
               (b0 (micros)) (xb (lowlat-bc-b lowlat-inner)) (db (- (micros) b0)))
          (loop (+ i 1)
                (if (> da wa) da wa) (+ ta da)
                (if (> db wb) db wb) (+ tb db))))))
(lowlat-bc-a lowlat-inner)
(lowlat-bc-b lowlat-inner)
(display "P173 pool occupancy: start=") (display lowlat-pool0)
(display " after-unpinned=") (display lowlat-pool-after-a)
(display " after-pinned=") (display lowlat-pool-after-b)
(display " compile-low-latency!=") (display lowlat-pinned) (newline)
(cond
 ((not lowlat-pinned)
  (display "P173 NO-POOL-OR-REFUSED -- compile-low-latency! returned #f, so BOTH arms are\n")
  (display "  ordinary native code in the same memory.  No comparison is reported: an identical\n")
  (display "  pair of arms would read as 'the tier is worthless', which is a different claim.\n")
  (display "  Expected on any host build; on a board it means the pool is absent or full.\n"))
 ((not (> lowlat-pool-after-b lowlat-pool-after-a))
  (display "P173 PLACEMENT-UNCONFIRMED -- the pinned arm reported success but pool occupancy did\n")
  (display "  not rise.  Refusing to report a comparison; fix the accounting first.\n"))
 ((not (and (ncg-compiled? lowlat-bc-a) (ncg-compiled? lowlat-bc-b)))
  (display "P173 NOT-NATIVE -- arm A native? ") (display (ncg-compiled? lowlat-bc-a))
  (display ", arm B native? ") (display (ncg-compiled? lowlat-bc-b)) (newline)
  (display "  At least one arm is not running native code, so this would compare the interpreter\n")
  (display "  with itself.  Refusing to report a comparison.\n"))
 (else
  (let* ((r1 (lowlat-run)) (r2 (lowlat-run)) (r3 (lowlat-run))
         (r  r1)
         (wa (car r)) (ta (cadr r)) (wb (caddr r)) (tb (cadddr r)))
    (display "P173 repeat worsts  A: ") (display (car r1)) (display " ") (display (car r2))
    (display " ") (display (car r3))
    (display "   B: ") (display (caddr r1)) (display " ") (display (caddr r2))
    (display " ") (display (caddr r3)) (display " (us)") (newline)
    (display "P173 arm A (unpinned, PSRAM): worst=") (display wa)
    (display "us mean=") (display (quotient ta lowlat-samples)) (display "us") (newline)
    (display "P173 arm B (pinned, on-die): worst=") (display wb)
    (display "us mean=") (display (quotient tb lowlat-samples)) (display "us") (newline)
    (display "P173 WORST-CASE DELTA (B-A) = ") (display (- wb wa))
    (display "us over ") (display lowlat-samples) (display " alternating samples") (newline)
    (display "P173 READING: on-die is worth enabling for real-time work only if B's WORST is\n")
    (display "  materially below A's.  A difference smaller than the spread of repeated runs of\n")
    (display "  the SAME arm is not a result -- run this several times before concluding.\n"))))
(display "--- ncg-lowlat-ab done ---\n")
(quiet lowlat-was-quiet)
;;; Copyright 2026 by Frobenius Norm LLC 2026-04-17 00:00:00
(display "=== Compiling environment to NCG ===\n")
(ncg-compile-environment! (interaction-environment))
(display "=== NCG compile done -- loading r7rs-tests.scm ===\n")
(load "r7rs-tests.scm" 0)
(display "=== ncg-test-runner done ===\n")
;;; Copyright 2026 by Frobenius Norm LLC 2026-05-16
(define (check name expected actual)
  (if (equal? expected actual)
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a  expected=~a  got=~a\n" name expected actual)))
(define (check-true name actual)
  (if actual
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a  expected=#t  got=~a\n" name actual)))
(define (check-false name actual)
  (if (not actual)
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a  expected=#f  got=~a\n" name actual)))
(define (ncg-compile-lambda lam)
  (ncg-compile (procedure->bytecode lam)))
(define ncg-available?
  (let ((probe (ncg-compile (procedure->bytecode (lambda (x) x)))))
    (ncg-compiled? probe)))
(printf "NCG available: ~a\n" ncg-available?)
(printf "--- 1. ncg-compiled? predicate ---\n")
(define ncg-add1 (ncg-compile-lambda (lambda (x) (+ x 1))))
(check-false "ncg-compiled? lambda"    (ncg-compiled? (lambda (x) x)))
(check-false "ncg-compiled? integer"   (ncg-compiled? 42))
(check-false "ncg-compiled? nil"       (ncg-compiled? '()))
(let ((bc (procedure->bytecode (lambda (x) x))))
  (check-false "ncg-compiled? plain bytecode"  (ncg-compiled? bc)))
(check-true "ncg-compiled? is boolean"
            (boolean? (ncg-compiled? ncg-add1)))
(printf "--- 2. constants ---\n")
(define ncg-ret42   (ncg-compile-lambda (lambda () 42)))
(define ncg-ret-t   (ncg-compile-lambda (lambda () #t)))
(define ncg-ret-f   (ncg-compile-lambda (lambda () #f)))
(define ncg-ret-nil (ncg-compile-lambda (lambda () '())))
(define ncg-ret-str (ncg-compile-lambda (lambda () "world")))
(define ncg-ret-sym (ncg-compile-lambda (lambda () 'bar)))
(check "ncg const 42"     42       (ncg-ret42))
(check "ncg const #t"     #t       (ncg-ret-t))
(check "ncg const #f"     #f       (ncg-ret-f))
(check "ncg const nil"    '()      (ncg-ret-nil))
(check "ncg const string" "world"  (ncg-ret-str))
(check "ncg const symbol" 'bar     (ncg-ret-sym))
(printf "--- 3. locals ---\n")
(define ncg-identity  (ncg-compile-lambda (lambda (x) x)))
(define ncg-swap      (ncg-compile-lambda (lambda (a b) (list b a))))
(define ncg-3args     (ncg-compile-lambda (lambda (a b c) (+ a (* b c)))))
(check "ncg identity 7"   7        (ncg-identity 7))
(check "ncg identity #f"  #f       (ncg-identity #f))
(check "ncg swap"         '(2 1)   (ncg-swap 1 2))
(check "ncg 3 args"       7        (ncg-3args 1 2 3))
(define ncg-local-set!
  (ncg-compile-lambda
   (lambda (x)
     (set! x (* x 3))
     x)))
(check "ncg local set! *3"   12   (ncg-local-set! 4))
(printf "--- 4. globals ---\n")
(define ncg-test-global 200)
(define ncg-read-global
  (ncg-compile-lambda (lambda () ncg-test-global)))
(define ncg-write-global
  (ncg-compile-lambda
   (lambda (v)
     (set! ncg-test-global v))))
(check "ncg read global"   200  (ncg-read-global))
(ncg-write-global 777)
(check "ncg write global"  777  ncg-test-global)
(ncg-write-global 200)
(define ncg-call-car
  (ncg-compile-lambda (lambda (x) (car x))))
(check "ncg call global car"  'a  (ncg-call-car '(a b c)))
(printf "--- 5. calls ---\n")
(define ncg-add   (ncg-compile-lambda (lambda (a b) (+ a b))))
(define ncg-mul   (ncg-compile-lambda (lambda (a b) (* a b))))
(check "ncg add"  9    (ncg-add 4 5))
(check "ncg mul"  42   (ncg-mul 6 7))
(define ncg-sq+1
  (ncg-compile-lambda (lambda (x) (+ (* x x) 1))))
(check "ncg sq+1 3"   10  (ncg-sq+1 3))
(check "ncg sq+1 5"   26  (ncg-sq+1 5))
(define ncg-begin-seq
  (ncg-compile-lambda
   (lambda (x)
     (+ x 1)
     (+ x 2)
     (+ x 10))))
(check "ncg begin last"  20  (ncg-begin-seq 10))
(printf "--- 6. branches ---\n")
(define ncg-abs
  (ncg-compile-lambda
   (lambda (x)
     (if (< x 0) (- x) x))))
(check "ncg abs -7"   7   (ncg-abs -7))
(check "ncg abs  7"   7   (ncg-abs  7))
(check "ncg abs  0"   0   (ncg-abs  0))
(define ncg-sign
  (ncg-compile-lambda
   (lambda (x)
     (if (> x 0) 1
         (if (< x 0) -1 0)))))
(check "ncg sign  2"    1   (ncg-sign  2))
(check "ncg sign -2"   -1   (ncg-sign -2))
(check "ncg sign  0"    0   (ncg-sign  0))
(define ncg-cond-grade
  (ncg-compile-lambda
   (lambda (score)
     (cond ((>= score 90) 'A)
           ((>= score 80) 'B)
           ((>= score 70) 'C)
           (else          'F)))))
(check "ncg cond A"  'A  (ncg-cond-grade 95))
(check "ncg cond B"  'B  (ncg-cond-grade 85))
(check "ncg cond C"  'C  (ncg-cond-grade 72))
(check "ncg cond F"  'F  (ncg-cond-grade 50))
(printf "--- 7. and / or ---\n")
(define ncg-and2 (ncg-compile-lambda (lambda (a b) (and a b))))
(define ncg-or2  (ncg-compile-lambda (lambda (a b) (or  a b))))
(check "ncg and #t #t"   #t   (ncg-and2 #t #t))
(check "ncg and #f #t"   #f   (ncg-and2 #f #t))
(check "ncg and 3  5"     5   (ncg-and2  3  5))
(check "ncg and #f 5"    #f   (ncg-and2 #f  5))
(check "ncg or  #f #f"   #f   (ncg-or2 #f #f))
(check "ncg or  #f  7"    7   (ncg-or2 #f  7))
(check "ncg or   4 #f"    4   (ncg-or2  4 #f))
(define ncg-and0 (ncg-compile-lambda (lambda () (and))))
(define ncg-or0  (ncg-compile-lambda (lambda () (or))))
(check "ncg and empty"   #t   (ncg-and0))
(check "ncg or  empty"   #f   (ncg-or0))
(printf "--- 8. let / let* ---\n")
(define ncg-let1
  (ncg-compile-lambda
   (lambda (x)
     (let ((y (+ x 1))
           (z (- x 1)))
       (* y z)))))
(check "ncg let"   24   (ncg-let1 5))
(define ncg-letstar
  (ncg-compile-lambda
   (lambda (x)
     (let* ((a (+ x 1))
            (b (* a a)))
       b))))
(check "ncg let*"   25   (ncg-letstar 4))
(printf "--- 9. named let loop ---\n")
(define ncg-sum-n
  (ncg-compile-lambda
   (lambda (n)
     (let loop ((i n) (s 0))
       (if (= i 0) s
           (loop (- i 1) (+ s i)))))))
(check "ncg sum 0"    0    (ncg-sum-n 0))
(check "ncg sum 10"  55    (ncg-sum-n 10))
(define ncg-fib-iter
  (ncg-compile-lambda
   (lambda (n)
     (let loop ((i n) (a 0) (b 1))
       (if (= i 0) a
           (loop (- i 1) b (+ a b)))))))
(check "ncg fib 0"    0   (ncg-fib-iter  0))
(check "ncg fib 7"   13   (ncg-fib-iter  7))
(check "ncg fib 10"  55   (ncg-fib-iter 10))
(printf "--- 10. NCG_SELF (self-tail) ---\n")
(define ncg-countdown
  (ncg-compile-lambda
   (lambda (n acc)
     (if (= n 0)
         acc
         (ncg-countdown (- n 1) (+ acc 1))))))
(check "ncg self-recursive count 5"   5   (ncg-countdown 5 0))
(check "ncg self-recursive count 0"   0   (ncg-countdown 0 0))
(printf "--- 11. numerical ---\n")
(define ncg-pow2
  (ncg-compile-lambda
   (lambda (n)
     (let loop ((i n) (r 1))
       (if (= i 0) r
           (loop (- i 1) (* r 2)))))))
(check "ncg 2^0"    1     (ncg-pow2  0))
(check "ncg 2^8"  256     (ncg-pow2  8))
(check "ncg 2^10" 1024    (ncg-pow2 10))
(define ncg-gcd
  (ncg-compile-lambda
   (lambda (a b)
     (let loop ((x a) (y b))
       (if (= y 0) x
           (loop y (remainder x y)))))))
(check "ncg gcd 12 8"   4   (ncg-gcd 12  8))
(check "ncg gcd 35 14"  7   (ncg-gcd 35 14))
(check "ncg gcd 7  5"   1   (ncg-gcd  7  5))
(printf "--- 12. list ops ---\n")
(define ncg-list-len
  (ncg-compile-lambda
   (lambda (lst)
     (let loop ((l lst) (n 0))
       (if (null? l) n
           (loop (cdr l) (+ n 1)))))))
(check "ncg length nil"   0   (ncg-list-len '()))
(check "ncg length 3"     3   (ncg-list-len '(a b c)))
(check "ncg length 5"     5   (ncg-list-len '(1 2 3 4 5)))
(define ncg-list-sum
  (ncg-compile-lambda
   (lambda (lst)
     (let loop ((l lst) (s 0))
       (if (null? l) s
