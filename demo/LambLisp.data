(define (+ . args)
  (if (%any-cpx? args)
    (let loop ((acc 0) (rest args))
      (if (null? rest) acc
        (loop (%cpx-add2 acc (car rest)) (cdr rest))))
    (apply %cpx:+ args)))
(define (- first . rest)
  (if (or (%cpx? first) (%any-cpx? rest))
    (if (null? rest)
      (%cpx-sub2 0 first)
      (let loop ((acc first) (r rest))
        (if (null? r) acc
          (loop (%cpx-sub2 acc (car r)) (cdr r)))))
    (apply %cpx:- first rest)))
(define (* . args)
  (if (%any-cpx? args)
    (let loop ((acc 1) (rest args))
