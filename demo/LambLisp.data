(probe 'f4-nest  '(lambda (n) (p4-double (p4-double n)))      7)
(define (p4-even? n) (if (= n 0) #t (p4-odd?  (- n 1))))
(define (p4-odd?  n) (if (= n 0) #f (p4-even? (- n 1))))
(probe 'f4t-one    '(lambda (n) (p4-double n))               21)
(probe 'f4t-3arg   '(lambda (n) (p4-tri n 2 3))               1)
(probe 'f4t-mutual '(lambda (n) (p4-even? n))               100)
