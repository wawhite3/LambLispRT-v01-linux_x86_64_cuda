(define sandbox-rate-limit      3)
(define sandbox-rate-window-ms  2000)
(define sandbox-whitelist
  '(robot-move!
    robot-stop
    robot-turn!
    robot-sweep
    robot-pose
    set-leds!
    set-led!
    leds-off
    buzzer-beep
    get-sonar
    get-battery
    get-light
    get-heading))
(define sandbox-rate-table '())
(define (sandbox-rate-ok? client-id now-ms)
  (let ((entry (assoc client-id sandbox-rate-table)))
    (if (not entry)
      (begin
        (set! sandbox-rate-table
              (cons (cons client-id (cons 1 now-ms)) sandbox-rate-table))
        #t)
      (let* ((count (cadr entry))
             (win   (cddr entry))
             (age   (- now-ms win)))
        (cond
          ((>= age sandbox-rate-window-ms)
           (set-cdr! entry (cons 1 now-ms))
           #t)
          ((< count sandbox-rate-limit)
           (set-cdr! entry (cons (+ count 1) win))
           #t)
          (else #f))))))
(define sandbox-forbidden-heads
  '(define set! define-syntax load eval apply
    open-input-file open-output-file
    open-tcp-client-port open-tcp-server-port
    system shell))
(define (sandbox-safe? expr)
  (cond
    ((not (pair? expr)) #t)
    ((not (symbol? (car expr))) #f)
    ((memq (car expr) sandbox-forbidden-heads) #f)
    ((not (memq (car expr) sandbox-whitelist)) #f)
    (else
     (let loop ((args (cdr expr)))
       (cond
         ((null? args) #t)
         ((pair? (car args)) (and (sandbox-safe? (car args)) (loop (cdr args))))
         (else (loop (cdr args))))))))
(define (sandbox-eval expr-string client-id car-conn now-ms)
  (cond
    ((not (sandbox-rate-ok? client-id now-ms))
     (list 'error "rate limit exceeded -- please wait"))
    (else
     (let ((expr (guard (e (#t #f))
                   (read (open-input-string expr-string)))))
       (cond
         ((not expr)
          (list 'error "parse error"))
         ((not (sandbox-safe? expr))
          (list 'error "expression not permitted"))
         (else
          (guard (e (#t (list 'error (condition/report-string e))))
            (let ((result (llip-eval car-conn expr)))
              (list 'ok (with-output-to-string (lambda () (write result))))))))))))
; Copyright 2026 by Frobenius Norm LLC 2026-04-18 00:00:00
(define demo-car-host      "192.168.1.100")
(define demo-car-port      8080)
(define demo-car-token     "demo-car")
(define demo-bridge-port   8181)
(define demo-bridge-token  "demo-bridge")
(define demo-poll-ms       150)
(define demo-sweep-ms      2000)
(define demo-max-clients   16)
(define demo-car-conn   #f)
(define demo-bridge-srv #f)
(define demo-bridge-clients '())
(define demo-last-poll  0)
(define demo-last-sweep 0)
(define demo-cmd-queue  '())
(define demo-history    '())
(define (car-eval expr)
  (llip-eval demo-car-conn expr))
(define (car-move! dir ms)    (car-eval `(robot-move! ',dir ,ms)))
(define (car-stop)            (car-eval '(robot-stop)))
(define (car-turn! deg)       (car-eval `(robot-turn! ,deg)))
(define (car-sweep)           (car-eval '(robot-sweep)))
(define (car-set-leds! pat)   (car-eval `(set-leds! ',pat)))
(define (car-leds-off)        (car-eval '(leds-off)))
(define (demo-poll-telemetry! now)
  (when (>= (- now demo-last-poll) demo-poll-ms)
    (telem-poll! demo-car-conn now)
    (set! demo-last-poll now)))
(define (demo-poll-sweep! now)
  (when (>= (- now demo-last-sweep) demo-sweep-ms)
    (let ((result (guard (e (#t '())) (car-sweep))))
      (when (pair? result)
        (grid-update-sweep! result)))
    (set! demo-last-sweep now)))
(define (demo-accept-bridges!)
  (when (< (length demo-bridge-clients) demo-max-clients)
    (let ((conn (llip-server-accept demo-bridge-srv)))
      (when conn
        (set! demo-bridge-clients (cons conn demo-bridge-clients))
        (demo-send-history! conn)
        (demo-accept-bridges!)))))
(define (demo-cull-bridges!)
  (set! demo-bridge-clients
        (filter (lambda (c) (llip-alive? c)) demo-bridge-clients)))
(define (demo-push-all! now)
  (when (>= (- now demo-last-poll) demo-poll-ms)
    (let ((msg `(telemetry ,(telem->json) ,(grid->ascii))))
      (for-each
        (lambda (c)
          (guard (e (#t #f))
            (llip-send-result c msg)))
        demo-bridge-clients))))
(define (demo-send-history! conn)
  (for-each
    (lambda (h)
      (guard (e (#t #f))
        (llip-send-result conn `(history . ,h))))
    (reverse demo-history)))
(define (demo-read-commands!)
  (for-each
    (lambda (conn)
      (let ((msg (llip-poll conn)))
        (when (and msg (pair? msg) (eq? (car msg) 'eval))
          (let ((expr-string (cadr msg))
                (client-id   (caddr msg)))
            (set! demo-cmd-queue
                  (append demo-cmd-queue
                          (list (list client-id expr-string conn))))))))
    demo-bridge-clients))
(define (demo-dispatch-one!)
  (when (pair? demo-cmd-queue)
    (let* ((item      (car demo-cmd-queue))
           (client-id (car item))
           (expr-str  (cadr item))
           (conn      (caddr item))
           (now       (elapsed-ms))
           (result    (sandbox-eval expr-str client-id demo-car-conn now)))
      (set! demo-cmd-queue (cdr demo-cmd-queue))
      (set! demo-history
            (let ((h (cons expr-str (if (eq? (car result) 'ok) (cadr result) (cadr result)))))
              (if (> (length demo-history) 20)
                (append (cdr demo-history) (list h))
                (append demo-history (list h)))))
      (for-each
        (lambda (c)
          (guard (e (#t #f))
            (llip-send-result c `(eval-result ,client-id ,expr-str ,result))))
        demo-bridge-clients))))
(define (demo-loop)
  (let loop ()
    (let ((now (elapsed-ms)))
      (demo-accept-bridges!)
      (demo-read-commands!)
      (demo-dispatch-one!)
      (demo-poll-telemetry! now)
      (demo-poll-sweep! now)
      (demo-push-all! now)
      (when (zero? (modulo (inexact->exact (floor (/ now 5000))) 1))
        (demo-cull-bridges!))
      (loop))))
(define (demo-start)
  (display "demo-supervisor: connecting to car at ")
  (display demo-car-host) (display ":") (display demo-car-port) (newline)
  (set! demo-car-conn
        (llip-connect-tcp demo-car-host demo-car-port demo-car-token))
  (display "demo-supervisor: car connected.") (newline)
  (display "demo-supervisor: starting bridge server on port ")
  (display demo-bridge-port) (newline)
