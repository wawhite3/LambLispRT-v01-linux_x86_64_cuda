(guard (e (#t #f)) (load "csv.scm" 0))
(define csv-pass 0)
(define csv-fail 0)
(define (csv-check name expected actual)
  (if (equal? expected actual)
      (begin (set! csv-pass (+ csv-pass 1)) (display "PASS ") (display name) (newline))
      (begin (set! csv-fail (+ csv-fail 1))
             (display "FAIL ") (display name) (display " exp=") (write expected)
             (display " got=") (write actual) (newline))))
(csv-check "simple" '(("a" "b" "c") ("1" "2" "3")) (csv-string->rows "a,b,c\n1,2,3\n"))
(csv-check "empty-mid"   '(("a" "" "c")) (csv-string->rows "a,,c\n"))
(csv-check "empty-edges" '(("" "a" "")) (csv-string->rows ",a,\n"))
(csv-check "quoted-comma" '(("a" "x,y" "c")) (csv-string->rows "a,\"x,y\",c\n"))
(csv-check "quoted-lf"   '(("a" "x\ny" "c"))   (csv-string->rows "a,\"x\ny\",c\n"))
(csv-check "quoted-crlf" '(("a" "x\r\ny" "c")) (csv-string->rows "a,\"x\r\ny\",c\n"))
(csv-check "escaped-quote" '(("a" "he \"x\"" "c")) (csv-string->rows "a,\"he \"\"x\"\"\",c\n"))
(csv-check "mixed" '(("plain" "with,comma" "42")) (csv-string->rows "plain,\"with,comma\",42\n"))
(csv-check "crlf-rows"      '(("a" "b") ("c" "d")) (csv-string->rows "a,b\r\nc,d\r\n"))
(csv-check "bare-cr-rows"   '(("a" "b") ("c" "d")) (csv-string->rows "a,b\rc,d\r"))
(csv-check "no-trailing-nl" '(("a" "b"))           (csv-string->rows "a,b"))
(csv-check "blank-skip" '(("a" "b") ("c" "d")) (csv-string->rows "a,b\n\nc,d\n"))
(csv-check "semicolon" '(("a" "b" "c")) (csv-string->rows "a;b;c\n" (list (cons 'delimiter (integer->char 59)))))
(csv-check "tab"       '(("a" "b"))     (csv-string->rows "a\tb\n"  (list (cons 'delimiter (integer->char 9)))))
(csv-check "trim"        '(("a" "b"))   (csv-string->rows " a , b \n"   (list (cons 'trim #t))))
(csv-check "trim-quoted" '((" a " "b")) (csv-string->rows "\" a \",b\n" (list (cons 'trim #t))))
(define csv-d1 (csv-string->dicts "name,age\nAda,36\nBob,40\n"))
(csv-check "dict-count" 2     (length csv-d1))
(csv-check "dict-name"  "Ada" (dict-ref (car csv-d1) 'name))
(csv-check "dict-age"   "40"  (dict-ref (cadr csv-d1) 'age))
(define csv-d2 (csv-string->dicts "x,y\n1,2\n" (list (cons 'coerce (lambda (col v) (string->number v))))))
(csv-check "coerce" 2 (dict-ref (car csv-d2) 'y))
(csv-check "ragged-short" "" (dict-ref (car (csv-string->dicts "a,b,c\n1,2\n")) 'c))
(csv-check "ragged-long"  "1" (dict-ref (car (csv-string->dicts "a,b\n1,2,3\n")) 'a))
(csv-check "write-plain"  "a,b\r\n"          (rows->csv-string '(("a" "b"))))
(csv-check "write-comma"  "\"a,b\"\r\n"      (rows->csv-string '(("a,b"))))
(csv-check "write-quote"  "\"he \"\"x\"\"\"\r\n" (rows->csv-string '(("he \"x\""))))
(csv-check "write-nl-opt" "a,b\n"            (rows->csv-string '(("a" "b")) (list (cons 'newline "\n"))))
(csv-check "quote-all" "\"a\",\"b\"\r\n" (rows->csv-string '(("a" "b")) (list (cons 'quote-all #t))))
(define csv-corpus '(("a" "b,c" "d\ne") ("x" "he \"hi\"" "") ("" "1" "2")))
(csv-check "round-trip" csv-corpus (csv-string->rows (rows->csv-string csv-corpus)))
(csv-check "empty-input" '()               (csv-string->rows ""))
(csv-check "parse-line"  '("a" "b,c" "d")   (csv-parse-line "a,\"b,c\",d"))
(csv-check "dicts-write-rt" "36"
           (dict-ref (car (csv-string->dicts (dicts->csv-string csv-d1))) 'age))
(display "Total: ")(display csv-pass)(display " pass, ")(display csv-fail)(display " fail")(newline)
;;; Copyright 2026 by Frobenius Norm LLC 2026-10-03
(define (ep-delta thunk)
  (let ((a (Platform.eval-progress)))
    (thunk)
    (- (Platform.eval-progress) a)))
(define ep-idle    (ep-delta (lambda () #f)))
(define ep-work    (ep-delta (lambda ()
                               (let loop ((i 0) (acc (list)))
                                 (if (< i 2000) (loop (+ i 1) (cons i acc)) (length acc))))))
(define ep-blocked (ep-delta (lambda () (delay_ms 400))))
(define ep-noise (* 20 (+ 1 ep-idle)))
(display "eval-progress idle=")    (display ep-idle)
(display " work=")                 (display ep-work)
(display " blocked=")              (display ep-blocked)
(newline)
(if (> ep-work ep-noise)
    (begin (display "PASS eval-progress advances under work") (newline))
    (begin (display "FAIL eval-progress did NOT advance under work -- a watchdog built on this would")
           (display " call a BUSY evaluator stopped and reboot a healthy unit") (newline)))
(if (< ep-blocked ep-noise)
    (begin (display "PASS eval-progress stays put while blocked") (newline))
    (begin (display "FAIL eval-progress moved while BLOCKED -- it is not measuring evaluator")
           (display " progress, so STOPPED cannot be told from SLOW") (newline)))
(if (> ep-work (* 100 (+ 1 ep-blocked)))
    (begin (display "PASS work and blocked differ by >100x") (newline))
    (begin (display "FAIL work and blocked are too close to set a threshold between") (newline)))
(define ep-stall-0    (Platform.stall-ms 0))
(define ep-stall-neg  (Platform.stall-ms -500))
(define ep-spin-ret 0)
(define ep-stall-spin (ep-delta (lambda () (set! ep-spin-ret (Platform.stall-ms 250 #t)))))
(display "stall-ms zero=")   (display ep-stall-0)
(display " negative=")       (display ep-stall-neg)
(display " spin-elapsed=")   (display ep-spin-ret)
(display " spin-ticks=")     (display ep-stall-spin)
(newline)
(if (>= ep-spin-ret 250)
    (begin (display "PASS stall-ms actually stalled for the requested interval") (newline))
    (begin (display "FAIL stall-ms returned ") (display ep-spin-ret)
           (display " ms for a requested 250 -- the wedge did NOT happen, so anything built on it")
           (display " is measuring nothing") (newline)))
(if (< ep-stall-spin ep-noise)
    (begin (display "PASS the tick stays put across a deliberate spin") (newline))
    (begin (display "FAIL the tick advanced ") (display ep-stall-spin)
           (display " across a spin that must not allocate -- this instrument cannot wedge the")
           (display " evaluator, so no staleness arm built on it means anything") (newline)))
(if (and (< ep-stall-0 50) (< ep-stall-neg 50))
    (begin (display "PASS stall-ms clamps zero and negative requests") (newline))
    (begin (display "FAIL stall-ms did not clamp: zero=") (display ep-stall-0)
           (display " negative=") (display ep-stall-neg) (newline)))
(define ep-stats (Platform.progress-watch-stats))
(display "progress-watch-stats (unarmed)=") (display ep-stats) (newline)
(if (eq? ep-stats #f)
    (begin (display "PASS progress-watch-stats reports #f when no sampler is running") (newline))
    (begin (display "FAIL progress-watch-stats returned ") (display ep-stats)
           (display " with no sampler running -- a never-started watch must not be readable as a")
           (display " quiet one, because that number is what a reset threshold gets chosen from")
           (newline)))
