(define fib-memo-table (make-vector 36 #f))
(define (fib-memo-reset!) (set! fib-memo-table (make-vector 36 #f)))
(define (fib-memo n)
  (let ((cached (vector-ref fib-memo-table n)))
    (if cached
        cached
        (let ((result (if (< n 2) n
                          (+ (fib-memo (- n 1))
                             (fib-memo (- n 2))))))
          (vector-set! fib-memo-table n result)
          result))))
