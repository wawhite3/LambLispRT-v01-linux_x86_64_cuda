(define (bench-table-has? s)
  (let loop ((t bench-table))
    (if (null? t) #f (if (eq? (cdr (car t)) s) #t (loop (cdr t))))))
(define bench-registration-ok #t)
(define bench-open-paren (string-ref "(" 0))
(define bench-blank      (string-ref " " 0))
(define (bench-name-stem s)
  (let loop ((i 0))
    (if (or (>= i (string-length s))
            (char=? (string-ref s i) bench-open-paren)
            (char=? (string-ref s i) bench-blank))
        (substring s 0 i)
        (loop (+ i 1)))))
(define (bench-row-names rows)
  (let loop ((r rows) (acc (list)))
    (if (null? r) (reverse acc)
        (loop (cdr r) (cons (bench-name-stem (row-name (car r))) acc)))))
(define (bench-arms-assert!)
  (let* ((e (bench-row-names (bench-rows-embedded)))
         (h (bench-row-names (bench-rows-host)))
         (miss (list)))
    (for-each (lambda (n) (if (not (member n h)) (set! miss (cons (cons "host" n) miss)))) e)
    (for-each (lambda (n) (if (not (member n e)) (set! miss (cons (cons "embedded" n) miss)))) h)
    (display "BENCH-ARMS embedded=") (display (length e))
    (display " host=")               (display (length h))
    (display " divergent=")          (display (length miss))
    (newline)
    (if (not (null? miss))
        (begin
          (for-each (lambda (m)
                      (display "BENCH-ARM-MISSING ") (display (cdr m))
                      (display " is absent from the ") (display (car m))
                      (display " arm\n"))
                    miss)
          (set! bench-registration-ok #f)
          (set! perf-fail-count (+ perf-fail-count 1))))))
(define (bench-registration-assert!)
  (let ((missing (list)) (declared 0))
    (for-each
      (lambda (r)
        (for-each
          (lambda (s)
            (set! declared (+ declared 1))
            (if (not (bench-table-has? s))
                (set! missing (cons (cons (row-name r) s) missing))))
          (row-procs r)))
      bench-rows)
    (display "BENCH-REGISTRATION rows=")      (display (length bench-rows))
    (display " table=")                       (display (length bench-table))
    (display " declared=")                    (display declared)
    (display " unregistered=")                (display (length missing))
    (newline)
    (let ((orphans (list)))
      (for-each
        (lambda (e)
          (let ((used #f))
            (for-each (lambda (r) (if (memq (cdr e) (row-procs r)) (set! used #t))) bench-rows)
            (if (not used) (set! orphans (cons (cdr e) orphans)))))
        bench-table)
      (if (not (null? orphans))
          (begin (display "BENCH-TABLE-UNCLAIMED ")
                 (for-each (lambda (s) (display s) (display " ")) orphans)
                 (newline))))
    (if (not (null? missing))
        (begin
          (for-each (lambda (m)
                      (display "BENCH-UNREGISTERED ") (display (car m))
                      (display " needs ")            (display (cdr m))
                      (display " -- not in bench-table, so no tier compiles it\n"))
                    missing)
          (set! bench-registration-ok #f)
          (set! perf-fail-count (+ perf-fail-count 1))))))
(define (bench-compiled-assert! label)
  (let ((missing (list)) (checked 0))
    (for-each
      (lambda (r)
        (for-each
          (lambda (s)
            (let ((p (eval s (interaction-environment))))
              (set! checked (+ checked 1))
              (if (if (string=? label "NCG")
                      (if (defined? 'ncg-code-size)
                          (let ((sz (ncg-code-size p))) (or (not sz) (= sz 0)))
                          #f)
                      (not (bytecode? p)))
                  (set! missing (cons (cons (row-name r) s) missing)))))
          (row-procs r)))
      bench-rows)
    (display "BENCH-COMPILED ") (display label)
    (display " checked=")       (display checked)
    (display " uncompiled=")    (display (length missing))
    (newline)
    (if (not (null? missing))
        (for-each (lambda (m)
                    (display "BENCH-UNCOMPILED ") (display label) (display " ")
                    (display (car m)) (display " needs ") (display (cdr m)) (newline))
                  missing))))
(bench-arms-assert!)
(bench-registration-assert!)
(when (defined? 'bc-cursor-root?)
  (display "BC-CURSOR-ROOT ") (display (if (bc-cursor-root?) 1 0)) (newline))
(run-suite "Interpreter")
(if bench-embedded?
  (for-each (lambda (e)
              (eval (list 'set! (cdr e) (list 'procedure->bytecode (cdr e)))
                    (interaction-environment)))
            bench-table)
  (compile-environment! (interaction-environment)))
(bench-compiled-assert! "Bytecode")
(run-suite "Bytecode")
(unless (vector-sorted? (qsort-vec! (make-iota-vec 200)))
  (error "qsort-vec! BC correctness check FAILED"))
(define bench-psram-leave (if (defined? 'bench-psram-leave) bench-psram-leave #f))
(define bench-psram-hogs  (list))
(define (bench-psram-free)
  (if (not (defined? 'ncg-exec-pool-tiers)) #f
    (let loop ((ts (ncg-exec-pool-tiers)))
      (cond ((null? ts)                    #f)
            ((eq? 'psram (car (car ts)))   (caddr (car ts)))
            (else                          (loop (cdr ts)))))))
(define bench-psram-chunk-floor 1024)
(define (bench-psram-starve! leave)
  (let loop ((n 0) (chunk 65536))
    (let ((free (bench-psram-free)))
      (cond
       ((not free)
        (display "B511-STARVE unavailable: this build has no psram exec tier\n") #f)
       ((<= free leave)
        (display "B511-STARVE ok free ") (display free)
        (display " leave ") (display leave)
        (display " chunks ") (display n) (newline) #t)
       ((< chunk bench-psram-chunk-floor)
        (display "B511-STARVE floor free ") (display free)
        (display " leave ") (display leave)
        (display " chunks ") (display n)
        (display " -- fragmentation: no free PSRAM block >= ")
        (display bench-psram-chunk-floor) (newline) #t)
       (else
        (let* ((want  (min (- free leave) chunk))
               (bv    (guard (e (#t #f)) (make-bytevector want)))
               (moved (and bv (- free (bench-psram-free)))))
          (cond
           ((not bv)              (loop n (quotient chunk 2)))
           ((< moved (quotient want 2)) (loop n (quotient chunk 2)))
           (else
            (set! bench-psram-hogs (cons bv bench-psram-hogs))
            (loop (+ n 1) chunk)))))))))
(when bench-psram-leave (bench-psram-starve! bench-psram-leave))
(let ((f (bench-psram-free)))
  (when f (display "B511-PSRAM-FREE ") (display f) (newline)))
(define bench-ncg-low-latency
  (if (defined? 'bench-ncg-low-latency) bench-ncg-low-latency #f))
(if bench-embedded?
  (let ((pinned 0) (asked 0))
    (for-each
      (lambda (p)
        (if bench-ncg-low-latency
          (begin (set! asked (+ asked 1))
                 (if (ncg-compile-low-latency-transitive! p) (set! pinned (+ pinned 1))))
          (ncg-compile-transitive! p)))
      (map cdr (bench-proc-list)))
    (when bench-ncg-low-latency
      (display "NCG-LOWLAT-PINNED ") (display pinned)
      (display " of ") (display asked) (newline)))
  (ncg-compile-environment! (interaction-environment)))
(bench-compiled-assert! "NCG")
(run-suite "NCG")
(when (defined? 'ncg-code-size)
  (let* ((nt (ncg-native-count)) (n (car nt)))
    (display "NCG-NATIVE-PROCS-END ") (display n) (display " of ") (display (cdr nt)) (newline)
    (when (< n (cdr nt))
      (display "NCG-NOT-NATIVE-END ")
      (let loop ((fs (bench-proc-list)))
        (if (not (null? fs))
          (begin
            (let ((sz (ncg-code-size (cdr (car fs)))))
              (if (or (not sz) (= sz 0))
                (begin (display (car (car fs))) (display " "))))
            (loop (cdr fs)))))
      (newline))))
(unless bench-only (print-size-report))
(when (and bench-only (> bench-only bench-counter))
  (display "=== BENCH INDEX OUT OF RANGE ===\n"))
(display "=== PERF VERIFY: ") (display perf-fail-count) (display " failure(s) ===\n")
(display "--- done ---\n")
