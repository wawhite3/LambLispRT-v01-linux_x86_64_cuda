;;; Copyright 2026 by Frobenius Norm LLC 2026-05-16
(define (check name expected actual)
  (if (equal? expected actual)
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a expected=~a got=~a\n" name expected actual)))
(define (check-true name actual)
  (if actual
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a expected=#t got=~a\n" name actual)))
(define (check-false name actual)
  (if (not actual)
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a expected=#f got=~a\n" name actual)))
(printf "--- 1. basic pvar ---\n")
(define my-identity
  (syntax-rules ()
    ((_ x) x)))
(check "identity number"   42      (my-identity 42))
(check "identity #t"       #t      (my-identity #t))
(check "identity #f"       #f      (my-identity #f))
(check "identity string"   "hi"    (my-identity "hi"))
(check "identity quoted"   'foo    (my-identity 'foo))
(check "identity list"     '(1 2)  (my-identity '(1 2)))
(check "identity expr"     7       (my-identity (+ 3 4)))
(define my-list2
  (syntax-rules ()
    ((_ a b) (list a b))))
(check "two pvars"   '(1 2)    (my-list2 1 2))
(check "two exprs"   '(3 4)    (my-list2 (+ 1 2) (+ 2 2)))
(define my-list3
  (syntax-rules ()
    ((_ a b c) (list a b c))))
(check "three pvars"  '(1 2 3)  (my-list3 1 2 3))
(printf "--- 2. wildcard ---\n")
(define my-first
  (syntax-rules ()
    ((_ x _ ...) x)))
(check "wildcard one"    1  (my-first 1))
(check "wildcard many"   1  (my-first 1 2 3 4))
(define my-second
  (syntax-rules ()
    ((_ _ x _ ...) x)))
(check "wildcard skip"  2  (my-second 1 2 3))
(define const-42
  (syntax-rules ()
    ((_ _ _ _) 42)))
(check "all wildcards"  42  (const-42 1 2 3))
(printf "--- 3. literals ---\n")
(define my-cond
  (syntax-rules (else)
    ((_ (else e ...))           (begin e ...))
    ((_ (test e ...) rest ...)  (if test (begin e ...) (my-cond rest ...)))))
(check "cond first"   'a   (my-cond (#t 'a) (else 'b)))
(check "cond else"    'b   (my-cond (#f 'a) (else 'b)))
(check "cond chain"   'c   (my-cond (#f 'a) (#f 'b) (else 'c)))
(check "cond multi"    3   (my-cond (#t 1 2 3) (else 0)))
(define use-else
  (syntax-rules ()
    ((_ else x) x)))
(check "else as pvar"  42  (use-else else 42))
(printf "--- 4. datum patterns ---\n")
(define my-zero?
  (syntax-rules ()
    ((_ 0) 'zero)
    ((_ x) 'nonzero)))
(check "datum 0"       'zero     (my-zero? 0))
(check "datum other"   'nonzero  (my-zero? 1))
(check "datum #f"      'nonzero  (my-zero? #f))
(define my-true?
  (syntax-rules ()
    ((_ #t) 'yes)
    ((_ x)  'no)))
(check "datum #t yes"  'yes  (my-true? #t))
(check "datum #f no"   'no   (my-true? #f))
(check "datum val no"  'no   (my-true? 42))
(printf "--- 5. ellipsis ---\n")
(define my-list
  (syntax-rules ()
    ((_ e ...) (list e ...))))
(check "list zero"   '()        (my-list))
(check "list one"    '(1)       (my-list 1))
(check "list three"  '(1 2 3)   (my-list 1 2 3))
(check "list five"   '(1 2 3 4 5)  (my-list 1 2 3 4 5))
(define my-list-prefix
  (syntax-rules ()
    ((_ first rest ...) (list first rest ...))))
(check "ellipsis after fixed one"   '(1)      (my-list-prefix 1))
(check "ellipsis after fixed three" '(1 2 3)  (my-list-prefix 1 2 3))
(define my-let
  (syntax-rules ()
    ((_ ((var init) ...) body ...)
     ((lambda (var ...) body ...) init ...))))
(check "let one"         5  (my-let ((x 5)) x))
(check "let two"        12  (my-let ((x 3) (y 4)) (* x y)))
(check "let multi-body"  7  (my-let ((x 3) (y 4)) (+ x 0) (+ x y)))
(define my-begin
  (syntax-rules ()
    ((_ e)         e)
    ((_ e1 e2 ...) (let ((ignore e1)) (my-begin e2 ...)))))
(check "begin one"    3   (my-begin 3))
(check "begin two"   'b   (my-begin 'a 'b))
(check "begin three" 'c   (my-begin 'a 'b 'c))
(printf "--- 6. multiple patterns ---\n")
(define my-and
  (syntax-rules ()
    ((_)           #t)
    ((_ e)         e)
    ((_ e1 e2 ...) (let ((t e1)) (if t (my-and e2 ...) #f)))))
(check "and empty"      #t  (my-and))
(check "and single"     42  (my-and 42))
(check "and single #f"  #f  (my-and #f))
(check "and two true"    2  (my-and 1 2))
(check "and short"      #f  (my-and 1 #f 3))
(check "and all false"  #f  (my-and #f #f #f))
(check "and returns last" 3 (my-and 1 2 3))
(define my-or
  (syntax-rules ()
    ((_)           #f)
    ((_ e)         e)
    ((_ e1 e2 ...) (let ((t e1)) (if t t (my-or e2 ...))))))
(check "or empty"       #f  (my-or))
(check "or single"      99  (my-or 99))
(check "or single #f"   #f  (my-or #f))
(check "or first true"   1  (my-or 1 2 3))
(check "or first false" 42  (my-or #f 42))
(check "or all false"   #f  (my-or #f #f #f))
(printf "--- 7. recursive ---\n")
(define my-when
  (syntax-rules ()
    ((_ test body ...)
     (if test (begin body ...) (if #f #f)))))
(define my-unless
  (syntax-rules ()
    ((_ test body ...)
     (if test (if #f #f) (begin body ...)))))
(check "when true"     'yes       (my-when   #t 'yes))
(check "when false"    (if #f #f) (my-when   #f 'yes))
(check "unless false"  'yes       (my-unless #f 'yes))
(check "unless true"   (if #f #f) (my-unless #t 'yes))
(define my-while
  (syntax-rules ()
    ((_ test body ...)
     (let loop ()
       (when test body ... (loop))))))
(check "while basic"  10
  (let ((i 0) (sum 0))
    (my-while (< i 5)
      (set! sum (+ sum i))
      (set! i (+ i 1)))
    sum))
(printf "--- 8. hygiene ---\n")
(check "or hygiene"
  99
  (let ((t 99)) (my-or #f t)))
(check "and hygiene"
  3
  (let ((t 99)) (my-and 1 2 3)))
(define swap!
  (syntax-rules ()
    ((_ a b)
     (let ((tmp a))
       (set! a b)
       (set! b tmp)))))
(check "swap! basic"
  '(2 1)
  (let ((x 1) (y 2))
    (swap! x y)
    (list x y)))
(check "swap! hygiene tmp"
  '(2 1 99)
  (let ((tmp 99) (x 1) (y 2))
    (swap! x y)
    (list x y tmp)))
(check "while hygiene loop"
  '(10 999)
  (let ((loop 999) (i 0) (sum 0))
    (my-while (< i 5)
      (set! sum (+ sum i))
      (set! i (+ i 1)))
    (list sum loop)))
(check "nested or hygiene"
  42
  (let ((t 99))
    (my-or #f (my-or #f 42))))
(define my-letone
  (syntax-rules ()
    ((_ x body ...)
     (let ((v x)) body ...))))
(check "let hygiene"
  99
  (let ((v 99))
    (my-letone 1 v)))
(printf "--- 9. falsy values ---\n")
(define use-val
  (syntax-rules ()
    ((_ v) (list v v))))
(check "pvar #f"   '(#f #f)  (use-val #f))
(check "pvar 0"    '(0 0)    (use-val 0))
(check "pvar nil"  '(() ())  (use-val '()))
(define use-vals
  (syntax-rules ()
    ((_ v ...) (list v ...))))
(check "ellipsis #f"    '(#f)      (use-vals #f))
(check "ellipsis 0"     '(0)       (use-vals 0))
(check "ellipsis nil"   '(())      (use-vals '()))
(check "ellipsis mixed" '(1 #f 3)  (use-vals 1 #f 3))
(check "or #f first"   2   (my-or #f 2))
(check "or 0 truthy"   0   (my-or 0 2))
(check "or nil truthy" '() (my-or '() 2))
(printf "--- 10. dotted patterns ---\n")
(define my-lambda
  (syntax-rules ()
    ((_ formals body ...)
     (lambda formals body ...))))
(check "lambda fixed"    3      ((my-lambda (x y) (+ x y)) 1 2))
(check "lambda rest"     '(2 3) ((my-lambda (x . rest) rest) 1 2 3))
(check "lambda vararg"   '(1 2) ((my-lambda args args) 1 2))
(check "lambda multi"    3      ((my-lambda (x y) (+ x 0) (+ x y)) 1 2))
(printf "--- 11. binding macros ---\n")
(define my-named-let
  (syntax-rules ()
    ((_ name ((var init) ...) body ...)
     (letrec ((name (lambda (var ...) body ...)))
       (name init ...)))))
(check "named-let countdown"  0
  (my-named-let loop ((n 5))
    (if (= n 0) n (loop (- n 1)))))
(check "named-let sum"  15
  (my-named-let loop ((i 5) (acc 0))
    (if (= i 0) acc (loop (- i 1) (+ acc i)))))
(check "named-let fib"  55
  (my-named-let fib ((n 10) (a 0) (b 1))
    (if (= n 0) a (fib (- n 1) b (+ a b)))))
(define my-let*
  (syntax-rules ()
    ((_ () body ...)
     (begin body ...))
    ((_ ((var init) rest ...) body ...)
     (let ((var init))
       (my-let* (rest ...) body ...)))))
(check "let* sequential"  6
  (my-let* ((x 1) (y (+ x 1)) (z (+ y 1)))
    (+ x y z)))
(printf "--- 12. case ---\n")
(define my-case
  (syntax-rules (else)
    ((_ val (else e ...))
     (begin e ...))
    ((_ val ((datum ...) e ...) rest ...)
     (if (memv val '(datum ...))
         (begin e ...)
         (my-case val rest ...)))))
(check "case match"    'yes  (my-case 2 ((1 2 3) 'yes) (else 'no)))
(check "case no match" 'no   (my-case 5 ((1 2 3) 'yes) (else 'no)))
(check "case else"     'def  (my-case 99 (else 'def)))
(check "case multi"    'b    (my-case 3 ((1 2) 'a) ((3 4) 'b) (else 'c)))
(printf "--- 13. ellipsis lockstep ---\n")
(define zip-lists
  (syntax-rules ()
    ((_ (a ...) (b ...))
     (list (list a b) ...))))
(check "zip two"    '((1 4) (2 5) (3 6))  (zip-lists (1 2 3) (4 5 6)))
(check "zip one"    '((1 4))               (zip-lists (1) (4)))
(printf "--- 14. composing ---\n")
(define my-nor
  (syntax-rules ()
    ((_ x ...) (my-unless (my-or x ...) #t))))
(check "nor all false"  #t          (my-nor #f #f #f))
(check "nor one true"   (if #f #f)  (my-nor #f 1 #f))
(define my-nand
  (syntax-rules ()
    ((_ x ...) (my-unless (my-and x ...) #t))))
(check "nand all true"   (if #f #f)  (my-nand 1 2 3))
(check "nand one false"  #t          (my-nand 1 #f 3))
(define my-defconst
  (syntax-rules ()
    ((_ name val) (define name val))))
(my-defconst pi 3.14159)
(check "defconst"  3.14159  pi)
(my-defconst greeting "hello")
(check "defconst string"  "hello"  greeting)
(printf "--- 15. do ---\n")
(define my-do
  (syntax-rules ()
    ((_ ((var init step) ...)
        (test result ...)
        body ...)
     (let loop ((var init) ...)
       (if test
           (begin result ...)
           (begin body ... (loop step ...)))))))
(check "do sum"  10
  (my-do ((i 0 (+ i 1))
          (sum 0 (+ sum i)))
         ((= i 5) sum)))
(check "do list"  '(4 3 2 1 0)
  (my-do ((i 0 (+ i 1))
          (acc '() (cons i acc)))
         ((= i 5) acc)))
(check "do vector"  '#(0 1 2 3 4)
  (let ((v (make-vector 5)))
    (my-do ((i 0 (+ i 1)))
           ((= i 5) v)
      (vector-set! v i i))))
(printf "--- 16. and-let* ---\n")
(define my-and-let*
  (syntax-rules ()
    ((_ () body ...)
     (begin body ...))
    ((_ ((var expr) rest ...) body ...)
     (let ((var expr))
       (if var
           (my-and-let* (rest ...) body ...)
           #f)))))
(check "and-let* true"   6   (my-and-let* ((x 2) (y (* x 3))) y))
(check "and-let* false"  #f  (my-and-let* ((x #f) (y 99)) y))
(define-syntax b152-cnt (syntax-rules () ((_ ()) 0) ((_ (h . t)) (+ 1 (b152-cnt t)))))
(check "dotted recursive"    3          (b152-cnt (a b c)))
(define-syntax b153-vecpat (syntax-rules () ((_ #(a b c)) (+ a b c))))
(check "vector pattern"      15         (b153-vecpat #(4 5 6)))
(define-syntax b153-vecell (syntax-rules () ((_ #(a ...)) (list a ...))))
(check "vector pattern ell"  '(1 2 3)   (b153-vecell #(1 2 3)))
(define-syntax b153-vectmpl (syntax-rules () ((_ a b) #(a b))))
(check "vector template"     '#(1 2)    (b153-vectmpl 1 2))
(define-syntax b153-vecswap (syntax-rules () ((_ #(a b)) #(b a))))
(check "vector pat+tmpl"     '#(2 1)    (b153-vecswap #(1 2)))
(define-syntax b153-vectmpl-ell (syntax-rules () ((_ x ...) #(0 x ...))))
(check "vector template ell" '#(0 1 2 3) (b153-vectmpl-ell 1 2 3))
(define-syntax b153-elldot (syntax-rules () ((_ (a ... . r)) (list (list a ...) r))))
(check "ellipsis-dotted"     '((1 2 3) 4) (b153-elldot (1 2 3 . 4)))
(define-syntax b153-elldotmid (syntax-rules () ((_ (a b ... . r)) (list (list b ...) r))))
(check "ellipsis-dotted mid"  '((2 3) 4) (b153-elldotmid (1 2 3 . 4)))
(printf "--- done ---\n")
;;; Copyright 2026 by Frobenius Norm LLC 2026-08-29 16:05:00
(define ll-esc (string (integer->char #x1b)))
(define chez-scheme?
  (guard (exn (#t #t))
    (eval 'syslog)
    #f))
(define (%s64-fmt color fmt . args)
  (when color (display color))
  (let loop ((chars (string->list fmt)) (args args))
    (cond
      ((null? chars) (values))
      ((and (char=? (car chars) #\~) (pair? (cdr chars)) (char=? (cadr chars) #\a))
       (display (if (null? args) "?" (car args)))
       (loop (cddr chars) (if (null? args) '() (cdr args))))
      ((and (char=? (car chars) #\~) (pair? (cdr chars)) (char=? (cadr chars) #\w))
       (write (if (null? args) "?" (car args)))
       (loop (cddr chars) (if (null? args) '() (cdr args))))
      (else
       (display (string (car chars)))
       (loop (cdr chars) args))))
  (when color (display (string-append ll-esc "[0m"))))
(define (news fmt . args) (apply %s64-fmt (string-append ll-esc "[32m") fmt args))
(define (warn fmt . args) (apply %s64-fmt (string-append ll-esc "[33m") fmt args))
(define *s64-pass*      0)
(define *s64-fail*      0)
(define *s64-exception* 0)
(define *s64-skip*      0)
(define *s64-group*    '())
(define s64-exception-names '())
(define *s64-anon* 0)
(define (%s64-anon-name)
  (set! *s64-anon* (+ *s64-anon* 1))
  (string-append (if (null? *s64-group*) "test" (car *s64-group*))
                 "/" (number->string *s64-anon*)))
(define (skip name . why)
  (set! *s64-skip* (+ *s64-skip* 1))
  (if (null? why)
    (news "SKIP ~a\n" name)
    (news "SKIP ~a  (~a)\n" name (car why))))
(define (%s64-pass! name)  (set! *s64-pass* (+ *s64-pass* 1)) (news "PASS ~a\n" name))
(define (%s64-fail! name form expected got)
  (set! *s64-fail* (+ *s64-fail* 1))
  (warn "FAIL ~a | expr ~w | expected ~w | got ~w\n" name form expected got))
(define (%s64-fail-exn! name form expected)
  (set! *s64-fail* (+ *s64-fail* 1))
  (warn "FAIL ~a | expr ~w | expected ~w | got exception\n" name form expected))
(define (%s64-cmp= name expected actual form eqproc)
  (if (eqproc expected actual) (%s64-pass! name) (%s64-fail! name form expected actual)))
(define-syntax test-equal
  (syntax-rules ()
    ((_ name expected expr)
     (guard (exn (#t (%s64-fail-exn! name (quote expr) expected)))
       (%s64-cmp= name expected expr (quote expr) equal?)))
    ((_ expected expr)
     (test-equal (%s64-anon-name) expected expr))))
(define-syntax test-eqv
  (syntax-rules ()
    ((_ name expected expr)
     (guard (exn (#t (%s64-fail-exn! name (quote expr) expected)))
       (%s64-cmp= name expected expr (quote expr) eqv?)))
    ((_ expected expr)
     (test-eqv (%s64-anon-name) expected expr))))
(define-syntax test-eq
  (syntax-rules ()
    ((_ name expected expr)
     (guard (exn (#t (%s64-fail-exn! name (quote expr) expected)))
       (%s64-cmp= name expected expr (quote expr) eq?)))
    ((_ expected expr)
     (test-eq (%s64-anon-name) expected expr))))
(define-syntax test-assert
  (syntax-rules ()
    ((_ name expr)
     (guard (exn (#t (%s64-fail-exn! name (quote expr) #t)))
       (if expr (%s64-pass! name) (%s64-fail! name (quote expr) #t expr))))
    ((_ expr)
     (test-assert (%s64-anon-name) expr))))
(define-syntax test-approximate
  (syntax-rules ()
    ((_ name expected expr err)
     (guard (exn (#t (%s64-fail-exn! name (quote expr) expected)))
       (let ((v expr))
         (if (<= (abs (- expected v)) err)
           (%s64-pass! name)
           (%s64-fail! name (quote expr) expected v)))))
    ((_ expected expr err)
     (test-approximate (%s64-anon-name) expected expr err))))
(define-syntax test-error
  (syntax-rules ()
    ((_ name expr)
     (let ((r (guard (e (#t 'caught)) expr 'no-error)))
       (if (eq? r 'caught)
         (%s64-pass! name)
         (%s64-fail! name (quote expr) 'error 'no-error))))
    ((_ expr)
     (test-error (%s64-anon-name) expr))))
(define (test-begin . o)
  (let ((name (if (pair? o) (car o) "tests")))
    (set! *s64-group* (cons name *s64-group*))
    (news "\n--- ~a ---\n" name)))
(define (test-end . o)
  (if (pair? *s64-group*) (set! *s64-group* (cdr *s64-group*)))
  #f)
(define-syntax test-group
  (syntax-rules ()
    ((_ name body ...)
     (begin (test-begin name) body ... (test-end name)))))
(define-syntax test-group-with-cleanup
  (syntax-rules ()
    ((_ name body ... cleanup)
     (begin (test-begin name)
            (guard (e (#t cleanup (raise e)))
              body ...)
            cleanup
            (test-end name)))))
(define (test-read-eval-string str)
  (eval (read (open-input-string str)) (interaction-environment)))
(define (test-runner-current)        'srfi64-simple)
(define (test-runner-pass-count . o) *s64-pass*)
(define (test-runner-fail-count . o) *s64-fail*)
(define (test-runner-xfail-count . o) *s64-exception*)
(define (test-runner-group-path . o) (reverse *s64-group*))
(define (test-runner-reset . o)
  (set! *s64-pass* 0) (set! *s64-fail* 0) (set! *s64-exception* 0)
  (set! s64-exception-names '()) (set! *s64-group* '()))
(define (test-passed?) (= *s64-fail* 0))
(define (note-exception name)
  (set! *s64-exception* (+ *s64-exception* 1))
  (set! s64-exception-names (cons name s64-exception-names)))
(define-syntax test-exception
  (syntax-rules ()
    ((_ name expected expr)
     (guard (exn (#t (note-exception name)))
       (let ((actual expr))
         (if (equal? expected actual)
           (begin (set! *s64-pass* (+ *s64-pass* 1))
                  (news "PASS ~a (nonconformance resolved)\n" name))
           (note-exception name)))))))
(define-syntax test-assert-exception
  (syntax-rules ()
    ((_ name expr)
     (guard (exn (#t (note-exception name)))
       (let ((actual expr))
         (if actual
           (begin (set! *s64-pass* (+ *s64-pass* 1))
                  (news "PASS ~a (nonconformance resolved)\n" name))
           (note-exception name)))))))
(define-syntax test
  (syntax-rules ()
    ((_ name expected expr) (test-equal name expected expr))
    ((_ expected expr)      (test-equal (%s64-anon-name) expected expr))))
(define-syntax test-values
  (syntax-rules ()
    ((_ name expected expr)
     (test-equal name (call-with-values (lambda () expected) list)
                      (call-with-values (lambda () expr) list)))
    ((_ expected expr)
     (test-values (%s64-anon-name) expected expr))))
(define (test-summary label)
  (news "\n=== ~a: ~a passed, ~a failed, ~a exception, ~a skipped ===\n"
        label *s64-pass* *s64-fail* *s64-exception* *s64-skip*)
  (if (= *s64-fail* 0)
    (news "ALL TESTS PASSED\n")
    (warn "~a TESTS FAILED\n" *s64-fail*)))
;;; Copyright 2026 by Frobenius Norm LLC 2026-06-30
(define *st-pass* 0)
(define *st-fail* 0)
(define (st-check name expected actual)
  (if (equal? expected actual)
      (begin
        (set! *st-pass* (+ *st-pass* 1))
        (display "PASS ") (display name) (newline))
      (begin
        (set! *st-fail* (+ *st-fail* 1))
        (display "FAIL ") (display name)
        (display "  expected=") (write expected)
        (display "  got=") (write actual) (newline))))
(st-check "calcsize >HHf"   8 (struct-calcsize ">HHf"))
(st-check "calcsize <4h2xQ" 18 (struct-calcsize "<4h2xQ"))
(st-check "calcsize bBhHiIqQ" 30 (struct-calcsize "bBhHiIqQ"))
(st-check "be HHf"  '(258 1000 3.5)   (struct-unpack ">HHf" (struct-pack ">HHf" 258 1000 3.5)))
(st-check "le HHf"  '(258 1000 3.5)   (struct-unpack "<HHf" (struct-pack "<HHf" 258 1000 3.5)))
(st-check "le i neg"  '(-123456)      (struct-unpack "<i" (struct-pack "<i" -123456)))
(st-check "be b neg"  '(-5)           (struct-unpack ">b" (struct-pack ">b" -5)))
(st-check "be h neg"  '(-30000)       (struct-unpack ">h" (struct-pack ">h" -30000)))
(st-check "B 200"     '(200)          (struct-unpack ">B" (struct-pack ">B" 200)))
(st-check "H 65535"   '(65535)        (struct-unpack ">H" (struct-pack ">H" 65535)))
(st-check "le q big"  '(9000000000)   (struct-unpack "<q" (struct-pack "<q" 9000000000)))
(st-check "be d" #t (= 3.140625 (car (struct-unpack ">d" (struct-pack ">d" 3.140625)))))
(st-check "be bytes"  '(1 2)          (struct-unpack ">BB" (struct-pack ">H" 258)))
(st-check "le bytes"  '(1 2)          (struct-unpack "<BB" (struct-pack ">H" 258)))
(st-check "endian flip" '(513)        (struct-unpack "<H" (struct-pack ">H" 258)))
(st-check "pack-into!" '(513 1027)
          (let ((bv (make-bytevector 8 0)))
            (struct-pack-into! bv 2 ">HH" 513 1027)
            (struct-unpack ">HH" bv 2)))
(st-check "pad xx"    '(7 9)          (struct-unpack ">B2xB" (struct-pack ">B2xB" 7 9)))
(display "\n=== STRUCT TESTS: ")
(display *st-pass*) (display " passed, ")
(display *st-fail*) (display " failed ===\n")
;;; Copyright 2026 by Frobenius Norm LLC 2026-06-02 00:00:00
(define (run-subsys file)
  (display "\n--- ") (display file) (display " ---\n")
  (guard (e (#t (display "FAIL ") (display file) (display " load-error\n")))
    (load (string-append "ll_tests/" file) 0)))
(run-subsys "let-tests.scm")
(run-subsys "named-let-tests.scm")
(run-subsys "letrec-tests.scm")
(run-subsys "loop-tests.scm")
(run-subsys "qq-tests.scm")
(run-subsys "syntax-rules-tests.scm")
(run-subsys "bytecode-tests.scm")
(run-subsys "cpp-vs-scheme-tests.scm")
(run-subsys "eval-progress-tests.scm")
(run-subsys "root-balance-tests.scm")
(run-subsys "ncg-tests.scm")
(run-subsys "ncg-demote-tests.scm")
(run-subsys "proc-slots-tests.scm")
(run-subsys "bug-tests.scm")
(run-subsys "gc-sr-regression.scm")
(run-subsys "idle-heap-tests.scm")
(run-subsys "array-tests.scm")
(run-subsys "behaviors-tests.scm")
(run-subsys "ncg-differential.scm")
(run-subsys "json-tests.scm")
(run-subsys "bitwise-tests.scm")
(run-subsys "csv-tests.scm")
(run-subsys "bacnet-tests.scm")
(run-subsys "struct-tests.scm")
(run-subsys "p86-test.scm")
(cond ((not (defined? 'modbus-tcp-connect))
       (display "SKIPPED modbus-tests (modbus binding not built on this board)\n"))
      ((not (procedure? modbus-tcp-connect))
       (display "FAIL modbus-tests modbus-tcp-connect is bound but is not a procedure\n"))
      (else (run-subsys "modbus-tests.scm")))
(cond ((not (defined? 'llip-aes-gcm-encrypt))
       (display "SKIPPED crypto-tests (AES-GCM binding not built)\n"))
      ((not (procedure? llip-aes-gcm-encrypt))
       (display "FAIL crypto-tests llip-aes-gcm-encrypt is bound but is not a procedure\n"))
      (else (run-subsys "crypto-tests.scm")))
(define subsys-llip-auth-ok #f)
(if (not (file-exists? "llip-auth.scm"))
  (display "SKIPPED llip-auth-tests (llip-auth.scm not on this target)\n")
  (begin
    (guard (e (#t (display "FAIL llip-auth.scm load-error -- file IS present, load aborted\n")))
      (load "llip-auth.scm" 0)
      (set! subsys-llip-auth-ok #t))
    (if subsys-llip-auth-ok (run-subsys "llip-auth-tests.scm"))))
(define subsys-llip-server-ok #f)
(if (not (file-exists? "llip-server.scm"))
  (display "SKIPPED llip-server-tests (llip-server.scm not on this target)\n")
  (begin
    (guard (e (#t (display "FAIL llip-server.scm load-error -- file IS present, load aborted\n")))
      (load "llip-server.scm" 0)
      (set! subsys-llip-server-ok #t))
    (if subsys-llip-server-ok (run-subsys "llip-server-tests.scm"))))
(when (string=? lamb-board "Freenove-4WD-Car-Kit-ESP32")
  (run-subsys "hardware-tests.scm"))
(display "--- subsystem done ---") (newline)
;;; Copyright 2026 by Frobenius Norm LLC 2026-05-16
(define (check name expected actual)
  (if (equal? expected actual)
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a expected=~a got=~a\n" name expected actual)))
(define (check-true name actual)
  (if actual
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a expected=#t got=~a\n" name actual)))
(define (check-false name actual)
  (if (not actual)
      (printf "PASS ~a\n" name)
      (printf "FAIL ~a expected=#f got=~a\n" name actual)))
(printf "--- 1. basic pvar ---\n")
(define my-identity
  (syntax-rules ()
    ((_ x) x)))
(check "identity number"   42      (my-identity 42))
(check "identity #t"       #t      (my-identity #t))
(check "identity #f"       #f      (my-identity #f))
(check "identity string"   "hi"    (my-identity "hi"))
(check "identity quoted"   'foo    (my-identity 'foo))
(check "identity list"     '(1 2)  (my-identity '(1 2)))
(check "identity expr"     7       (my-identity (+ 3 4)))
(define my-list2
  (syntax-rules ()
    ((_ a b) (list a b))))
(check "two pvars"   '(1 2)    (my-list2 1 2))
(check "two exprs"   '(3 4)    (my-list2 (+ 1 2) (+ 2 2)))
(define my-list3
  (syntax-rules ()
    ((_ a b c) (list a b c))))
(check "three pvars"  '(1 2 3)  (my-list3 1 2 3))
(printf "--- 2. wildcard ---\n")
(define my-first
  (syntax-rules ()
    ((_ x _ ...) x)))
(check "wildcard one"    1  (my-first 1))
(check "wildcard many"   1  (my-first 1 2 3 4))
(define my-second
  (syntax-rules ()
    ((_ _ x _ ...) x)))
(check "wildcard skip"  2  (my-second 1 2 3))
(define const-42
  (syntax-rules ()
    ((_ _ _ _) 42)))
(check "all wildcards"  42  (const-42 1 2 3))
(printf "--- 3. literals ---\n")
(define my-cond
  (syntax-rules (else)
    ((_ (else e ...))           (begin e ...))
    ((_ (test e ...) rest ...)  (if test (begin e ...) (my-cond rest ...)))))
(check "cond first"   'a   (my-cond (#t 'a) (else 'b)))
(check "cond else"    'b   (my-cond (#f 'a) (else 'b)))
(check "cond chain"   'c   (my-cond (#f 'a) (#f 'b) (else 'c)))
(check "cond multi"    3   (my-cond (#t 1 2 3) (else 0)))
(define use-else
  (syntax-rules ()
    ((_ else x) x)))
(check "else as pvar"  42  (use-else else 42))
(printf "--- 4. datum patterns ---\n")
(define my-zero?
  (syntax-rules ()
    ((_ 0) 'zero)
    ((_ x) 'nonzero)))
(check "datum 0"       'zero     (my-zero? 0))
(check "datum other"   'nonzero  (my-zero? 1))
(check "datum #f"      'nonzero  (my-zero? #f))
(define my-true?
  (syntax-rules ()
    ((_ #t) 'yes)
    ((_ x)  'no)))
(check "datum #t yes"  'yes  (my-true? #t))
(check "datum #f no"   'no   (my-true? #f))
(check "datum val no"  'no   (my-true? 42))
(printf "--- 5. ellipsis ---\n")
(define my-list
  (syntax-rules ()
    ((_ e ...) (list e ...))))
(check "list zero"   '()        (my-list))
(check "list one"    '(1)       (my-list 1))
(check "list three"  '(1 2 3)   (my-list 1 2 3))
(check "list five"   '(1 2 3 4 5)  (my-list 1 2 3 4 5))
(define my-list-prefix
  (syntax-rules ()
    ((_ first rest ...) (list first rest ...))))
(check "ellipsis after fixed one"   '(1)      (my-list-prefix 1))
(check "ellipsis after fixed three" '(1 2 3)  (my-list-prefix 1 2 3))
(define my-let
  (syntax-rules ()
    ((_ ((var init) ...) body ...)
     ((lambda (var ...) body ...) init ...))))
(check "let one"         5  (my-let ((x 5)) x))
(check "let two"        12  (my-let ((x 3) (y 4)) (* x y)))
(check "let multi-body"  7  (my-let ((x 3) (y 4)) (+ x 0) (+ x y)))
(define my-begin
  (syntax-rules ()
    ((_ e)         e)
    ((_ e1 e2 ...) (let ((ignore e1)) (my-begin e2 ...)))))
(check "begin one"    3   (my-begin 3))
(check "begin two"   'b   (my-begin 'a 'b))
(check "begin three" 'c   (my-begin 'a 'b 'c))
(printf "--- 6. multiple patterns ---\n")
(define my-and
  (syntax-rules ()
    ((_)           #t)
    ((_ e)         e)
    ((_ e1 e2 ...) (let ((t e1)) (if t (my-and e2 ...) #f)))))
(check "and empty"      #t  (my-and))
(check "and single"     42  (my-and 42))
(check "and single #f"  #f  (my-and #f))
(check "and two true"    2  (my-and 1 2))
(check "and short"      #f  (my-and 1 #f 3))
(check "and all false"  #f  (my-and #f #f #f))
(check "and returns last" 3 (my-and 1 2 3))
(define my-or
  (syntax-rules ()
    ((_)           #f)
    ((_ e)         e)
    ((_ e1 e2 ...) (let ((t e1)) (if t t (my-or e2 ...))))))
(check "or empty"       #f  (my-or))
(check "or single"      99  (my-or 99))
(check "or single #f"   #f  (my-or #f))
(check "or first true"   1  (my-or 1 2 3))
(check "or first false" 42  (my-or #f 42))
(check "or all false"   #f  (my-or #f #f #f))
(printf "--- 7. recursive ---\n")
(define my-when
  (syntax-rules ()
    ((_ test body ...)
     (if test (begin body ...) (if #f #f)))))
(define my-unless
  (syntax-rules ()
    ((_ test body ...)
     (if test (if #f #f) (begin body ...)))))
(check "when true"     'yes       (my-when   #t 'yes))
(check "when false"    (if #f #f) (my-when   #f 'yes))
(check "unless false"  'yes       (my-unless #f 'yes))
(check "unless true"   (if #f #f) (my-unless #t 'yes))
(define my-while
  (syntax-rules ()
    ((_ test body ...)
     (let loop ()
       (when test body ... (loop))))))
(check "while basic"  10
  (let ((i 0) (sum 0))
    (my-while (< i 5)
      (set! sum (+ sum i))
      (set! i (+ i 1)))
    sum))
(printf "--- 8. hygiene ---\n")
(check "or hygiene"
  99
  (let ((t 99)) (my-or #f t)))
(check "and hygiene"
  3
  (let ((t 99)) (my-and 1 2 3)))
(define swap!
  (syntax-rules ()
    ((_ a b)
     (let ((tmp a))
       (set! a b)
       (set! b tmp)))))
(check "swap! basic"
  '(2 1)
  (let ((x 1) (y 2))
    (swap! x y)
    (list x y)))
(check "swap! hygiene tmp"
  '(2 1 99)
  (let ((tmp 99) (x 1) (y 2))
    (swap! x y)
    (list x y tmp)))
(check "while hygiene loop"
  '(10 999)
  (let ((loop 999) (i 0) (sum 0))
    (my-while (< i 5)
      (set! sum (+ sum i))
      (set! i (+ i 1)))
    (list sum loop)))
(check "nested or hygiene"
  42
  (let ((t 99))
    (my-or #f (my-or #f 42))))
(define my-letone
  (syntax-rules ()
    ((_ x body ...)
     (let ((v x)) body ...))))
(check "let hygiene"
  99
  (let ((v 99))
    (my-letone 1 v)))
(printf "--- 9. falsy values ---\n")
(define use-val
  (syntax-rules ()
    ((_ v) (list v v))))
(check "pvar #f"   '(#f #f)  (use-val #f))
(check "pvar 0"    '(0 0)    (use-val 0))
(check "pvar nil"  '(() ())  (use-val '()))
(define use-vals
  (syntax-rules ()
    ((_ v ...) (list v ...))))
(check "ellipsis #f"    '(#f)      (use-vals #f))
(check "ellipsis 0"     '(0)       (use-vals 0))
(check "ellipsis nil"   '(())      (use-vals '()))
(check "ellipsis mixed" '(1 #f 3)  (use-vals 1 #f 3))
(check "or #f first"   2   (my-or #f 2))
(check "or 0 truthy"   0   (my-or 0 2))
(check "or nil truthy" '() (my-or '() 2))
(printf "--- 10. dotted patterns ---\n")
(define my-lambda
  (syntax-rules ()
    ((_ formals body ...)
     (lambda formals body ...))))
(check "lambda fixed"    3      ((my-lambda (x y) (+ x y)) 1 2))
(check "lambda rest"     '(2 3) ((my-lambda (x . rest) rest) 1 2 3))
(check "lambda vararg"   '(1 2) ((my-lambda args args) 1 2))
(check "lambda multi"    3      ((my-lambda (x y) (+ x 0) (+ x y)) 1 2))
(printf "--- 11. binding macros ---\n")
(define my-named-let
  (syntax-rules ()
    ((_ name ((var init) ...) body ...)
     (letrec ((name (lambda (var ...) body ...)))
       (name init ...)))))
(check "named-let countdown"  0
  (my-named-let loop ((n 5))
    (if (= n 0) n (loop (- n 1)))))
(check "named-let sum"  15
  (my-named-let loop ((i 5) (acc 0))
    (if (= i 0) acc (loop (- i 1) (+ acc i)))))
(check "named-let fib"  55
  (my-named-let fib ((n 10) (a 0) (b 1))
    (if (= n 0) a (fib (- n 1) b (+ a b)))))
(define my-let*
  (syntax-rules ()
    ((_ () body ...)
     (begin body ...))
    ((_ ((var init) rest ...) body ...)
     (let ((var init))
       (my-let* (rest ...) body ...)))))
(check "let* sequential"  6
  (my-let* ((x 1) (y (+ x 1)) (z (+ y 1)))
    (+ x y z)))
(printf "--- 12. case ---\n")
(define my-case
  (syntax-rules (else)
    ((_ val (else e ...))
     (begin e ...))
    ((_ val ((datum ...) e ...) rest ...)
     (if (memv val '(datum ...))
         (begin e ...)
         (my-case val rest ...)))))
(check "case match"    'yes  (my-case 2 ((1 2 3) 'yes) (else 'no)))
(check "case no match" 'no   (my-case 5 ((1 2 3) 'yes) (else 'no)))
(check "case else"     'def  (my-case 99 (else 'def)))
(check "case multi"    'b    (my-case 3 ((1 2) 'a) ((3 4) 'b) (else 'c)))
(printf "--- 13. ellipsis lockstep ---\n")
(define zip-lists
  (syntax-rules ()
    ((_ (a ...) (b ...))
     (list (list a b) ...))))
(check "zip two"    '((1 4) (2 5) (3 6))  (zip-lists (1 2 3) (4 5 6)))
(check "zip one"    '((1 4))               (zip-lists (1) (4)))
(printf "--- 14. composing ---\n")
(define my-nor
  (syntax-rules ()
    ((_ x ...) (my-unless (my-or x ...) #t))))
(check "nor all false"  #t          (my-nor #f #f #f))
(check "nor one true"   (if #f #f)  (my-nor #f 1 #f))
(define my-nand
  (syntax-rules ()
    ((_ x ...) (my-unless (my-and x ...) #t))))
(check "nand all true"   (if #f #f)  (my-nand 1 2 3))
(check "nand one false"  #t          (my-nand 1 #f 3))
(define my-defconst
  (syntax-rules ()
    ((_ name val) (define name val))))
(my-defconst pi 3.14159)
(check "defconst"  3.14159  pi)
(my-defconst greeting "hello")
(check "defconst string"  "hello"  greeting)
(printf "--- 15. do ---\n")
(define my-do
  (syntax-rules ()
    ((_ ((var init step) ...)
        (test result ...)
        body ...)
     (let loop ((var init) ...)
       (if test
           (begin result ...)
           (begin body ... (loop step ...)))))))
(check "do sum"  10
  (my-do ((i 0 (+ i 1))
          (sum 0 (+ sum i)))
         ((= i 5) sum)))
(check "do list"  '(4 3 2 1 0)
  (my-do ((i 0 (+ i 1))
          (acc '() (cons i acc)))
         ((= i 5) acc)))
(check "do vector"  '#(0 1 2 3 4)
  (let ((v (make-vector 5)))
    (my-do ((i 0 (+ i 1)))
           ((= i 5) v)
      (vector-set! v i i))))
(printf "--- 16. and-let* ---\n")
(define my-and-let*
  (syntax-rules ()
    ((_ () body ...)
     (begin body ...))
    ((_ ((var expr) rest ...) body ...)
     (let ((var expr))
       (if var
           (my-and-let* (rest ...) body ...)
           #f)))))
(check "and-let* true"   6   (my-and-let* ((x 2) (y (* x 3))) y))
(check "and-let* false"  #f  (my-and-let* ((x #f) (y 99)) y))
(define b314-mA #f)
(define b314-mB #f)
(let ((helper (lambda (x) (list 'A x))))
  (define-syntax mA (syntax-rules () ((_ v) (helper v))))
  (set! b314-mA (lambda (v) (mA v))))
(let ((helper (lambda (x) (list 'B x))))
  (define-syntax mB (syntax-rules () ((_ v) (helper v))))
  (set! b314-mB (lambda (v) (mB v))))
(check "B314 alias/scope A" '(A 1) (b314-mA 1))
(check "B314 alias/scope B" '(B 2) (b314-mB 2))
(printf "--- done ---\n")
;;; Copyright 2026 by Frobenius Norm LLC 2026-05-26 00:00:00
(define ll-esc (string (integer->char #x1b)))
(define chez-scheme?
  (guard (exn (#t #t))
    (eval 'syslog)
    #f))
(define (%u8t-fmt color fmt . args)
  (when color (display color))
  (let loop ((chars (string->list fmt)) (args args))
    (cond
      ((null? chars) (values))
      ((and (char=? (car chars) #\~)
            (pair? (cdr chars))
            (char=? (cadr chars) #\a))
       (display (if (null? args) "?" (car args)))
       (loop (cddr chars) (if (null? args) '() (cdr args))))
      (else
       (display (string (car chars)))
       (loop (cdr chars) args))))
  (when color (display (string-append ll-esc "[0m"))))
(define (u8-news fmt . args) (apply %u8t-fmt (string-append ll-esc "[32m") fmt args))
(define (u8-warn fmt . args) (apply %u8t-fmt (string-append ll-esc "[33m") fmt args))
(define *pass* 0)
(define *fail* 0)
(define (check name expected actual)
  (if (equal? expected actual)
    (begin (set! *pass* (+ *pass* 1)) (u8-news "PASS ~a\n" name))
    (begin (set! *fail* (+ *fail* 1)) (u8-warn "FAIL ~a  expected=~a  got=~a\n" name expected actual))))
(define (check-true name val)
  (if val
    (begin (set! *pass* (+ *pass* 1)) (u8-news "PASS ~a\n" name))
    (begin (set! *fail* (+ *fail* 1)) (u8-warn "FAIL ~a  expected=#t  got=~a\n" name val))))
(define (check-false name val)
  (if (not val)
    (begin (set! *pass* (+ *pass* 1)) (u8-news "PASS ~a\n" name))
    (begin (set! *fail* (+ *fail* 1)) (u8-warn "FAIL ~a  expected=#f  got=~a\n" name val))))
(define (check-error name thunk32)
  (let ((r (guard (e (#t 'caught)) (thunk32) 'no-error)))
    (if (eq? r 'caught)
      (begin (set! *pass* (+ *pass* 1)) (u8-news "PASS ~a\n" name))
      (begin (set! *fail* (+ *fail* 1)) (u8-warn "FAIL ~a  expected error, got none\n" name)))))
(u8-news "\n--- 1. #\\xNNNN character literal notation ---\n")
(check "charlit/ascii-a"    97      (char->integer #\x61))
(check "charlit/ascii-0"    48      (char->integer #\x30))
(check "charlit/latin1-e"   #x00E9  (char->integer #\xE9))
(check "charlit/latin1-cap" #x00C0  (char->integer #\xC0))
(check "charlit/greek-lam"  #x03BB  (char->integer #\x03BB))
(check "charlit/greek-cap"  #x039B  (char->integer #\x039B))
(check "charlit/hiragana"   #x3042  (char->integer #\x3042))
(check "charlit/emoji"      #x1F600 (char->integer #\x1F600))
(u8-news "\n--- 2. String literal \\xNNNN; hex escape sequences ---\n")
(check-true "str-esc/ascii-eq"  (string=? "abc" "\x61;\x62;\x63;"))
(check "str-esc/ascii-len"   3  (string-length "\x61;\x62;\x63;"))
(check "str-esc/greek-u8"
       (bytevector #xCE #xBB)
       (string->utf8 "\x03BB;"))
(check "str-esc/greek-len"   1  (string-length "\x03BB;"))
(check "str-esc/emoji-u8"
       (bytevector #xF0 #x9F #x98 #x80)
       (string->utf8 "\x1F600;"))
(u8-news "\n--- 3. char->integer / integer->char ---\n")
(check "c->i/ascii"        97      (char->integer #\a))
(check "c->i/latin1"       #x00E9  (char->integer (integer->char #x00E9)))
(check "c->i/greek-lo"     #x03BB  (char->integer (integer->char #x03BB)))
(check "c->i/greek-up"     #x039B  (char->integer (integer->char #x039B)))
(check "c->i/hiragana"     #x3042  (char->integer (integer->char #x3042)))
(check "c->i/emoji"        #x1F600 (char->integer (integer->char #x1F600)))
(check "c->i/max"          #x10FFFF (char->integer (integer->char #x10FFFF)))
(check-error "i->c/surrogate-lo"  (lambda () (integer->char #xD800)))
(check-error "i->c/surrogate-mid" (lambda () (integer->char #xDC00)))
(check-error "i->c/surrogate-hi"  (lambda () (integer->char #xDFFF)))
(check-error "i->c/out-of-range"  (lambda () (integer->char #x110000)))
(u8-news "\n--- 4. Char ordering by Unicode codepoint ---\n")
(check-true  "char<?/bmp"    (char<? #\a (integer->char #x03BB)))
(check-true  "char>?/bmp"    (char>? (integer->char #x03BB) #\a))
(check-true  "char=?/nonascii" (char=? (integer->char #x03BB) (integer->char #x03BB)))
(check-false "char=?/differ"   (char=? (integer->char #x03BB) (integer->char #x03BC)))
(check-true  "char<?/bmp-smp"  (char<? (integer->char #x03BB) (integer->char #x1F600)))
(u8-news "\n--- 5a. char-alphabetic? ---\n")
(check-true  "alpha?/a"       (char-alphabetic? #\a))
(check-true  "alpha?/Z"       (char-alphabetic? #\Z))
(check-false "alpha?/0"       (char-alphabetic? #\0))
(check-false "alpha?/space"   (char-alphabetic? #\space))
(check-true  "alpha?/e-acute" (char-alphabetic? (integer->char #x00E9)))
(check-true  "alpha?/A-grave" (char-alphabetic? (integer->char #x00C0)))
(check-true  "alpha?/greek-lo" (char-alphabetic? (integer->char #x03BB)))
(check-true  "alpha?/greek-up" (char-alphabetic? (integer->char #x039B)))
(check-true  "alpha?/hiragana" (char-alphabetic? (integer->char #x3042)))
(u8-news "\n--- 5b. char-upper-case? / char-lower-case? ---\n")
(check-true  "upper?/A"       (char-upper-case? #\A))
(check-false "upper?/a"       (char-upper-case? #\a))
(check-true  "lower?/a"       (char-lower-case? #\a))
(check-false "lower?/A"       (char-lower-case? #\A))
(check-true  "upper?/A-grave" (char-upper-case? (integer->char #x00C0)))
(check-true  "lower?/e-acute" (char-lower-case? (integer->char #x00E9)))
(u8-news "\n--- 5c. char-whitespace? ---\n")
(check-true  "ws?/space"    (char-whitespace? #\space))
(check-true  "ws?/newline"  (char-whitespace? #\newline))
(check-true  "ws?/tab"      (char-whitespace? #\tab))
(check-false "ws?/a"        (char-whitespace? #\a))
(check-true  "ws?/nbsp"     (char-whitespace? (integer->char #x00A0)))
(check-true  "ws?/linesep"  (char-whitespace? (integer->char #x2028)))
(check-true  "ws?/parasep"  (char-whitespace? (integer->char #x2029)))
(u8-news "\n--- 5d. char-numeric? ---\n")
(check-true  "numeric?/0"    (char-numeric? #\0))
(check-true  "numeric?/9"    (char-numeric? #\9))
(check-false "numeric?/a"    (char-numeric? #\a))
(check-true  "numeric?/arab" (char-numeric? (integer->char #x0664)))
(u8-news "\n--- 5e. digit-value ---\n")
(check "dv/0"       0  (digit-value #\0))
(check "dv/5"       5  (digit-value #\5))
(check "dv/9"       9  (digit-value #\9))
(check "dv/a"      #f  (digit-value #\a))
(check "dv/arab-0"  0  (digit-value (integer->char #x0660)))
(check "dv/arab-4"  4  (digit-value (integer->char #x0664)))
(check "dv/deva-0"  0  (digit-value (integer->char #x0966)))
(u8-news "\n--- 5f. char-upcase / char-downcase ---\n")
(check "upcase/a"    #\A  (char-upcase #\a))
(check "downcase/A"  #\a  (char-downcase #\A))
(check "upcase/e-acute"   (integer->char #x00C9) (char-upcase  (integer->char #x00E9)))
(check "downcase/E-acute" (integer->char #x00E9) (char-downcase (integer->char #x00C9)))
(check "upcase/a-grave"   (integer->char #x00C0) (char-upcase  (integer->char #x00E0)))
(check "upcase/greek-lo"   (integer->char #x039B) (char-upcase  (integer->char #x03BB)))
(check "downcase/greek-up" (integer->char #x03BB) (char-downcase (integer->char #x039B)))
(u8-news "\n--- 6. string-length ---\n")
(check "strlen/ascii"    5  (string-length "hello"))
(check "strlen/empty"    0  (string-length ""))
(check "strlen/greek"    1  (string-length "\x03BB;"))
(check "strlen/emoji"    1  (string-length "\x1F600;"))
(check "strlen/mixed"    3  (string-length "\x61;\x03BB;\x62;"))
(u8-news "\n--- 7. string-ref ---\n")
(check "strref/ascii-0"   #\h  (string-ref "hello" 0))
(check "strref/ascii-4"   #\o  (string-ref "hello" 4))
(check "strref/greek-0"   (integer->char #x03BB)  (string-ref "\x03BB;" 0))
(check "strref/mixed-1"   (integer->char #x03BB)  (string-ref "\x61;\x03BB;\x62;" 1))
(check "strref/mixed-2"   #\b                     (string-ref "\x61;\x03BB;\x62;" 2))
(u8-news "\n--- 8. string / list->string / string->list ---\n")
(check "string/ascii"    "hi"  (string #\h #\i))
(check "l->s/ascii"      "hi"  (list->string (list #\h #\i)))
(check "s->l/ascii"      (list #\h #\i) (string->list "hi"))
(check-true "string/greek-utf8"
  (equal? (bytevector #xCE #xBB)
          (string->utf8 (string (integer->char #x03BB)))))
(check-true "l->s/greek-utf8"
  (equal? (bytevector #xCE #xBB)
          (string->utf8 (list->string (list (integer->char #x03BB))))))
(check "s->l/greek"
  (list (integer->char #x03BB))
  (string->list "\x03BB;"))
(check "s->l/greek-slice"
  (list (integer->char #x03BB))
  (string->list "\x03BB;" 0 1))
(u8-news "\n--- 9. string->utf8 / utf8->string ---\n")
(check "s->u8/ascii"   (bytevector 104 101 108 108 111) (string->utf8 "hello"))
(check "u8->s/ascii"   "hello"  (utf8->string (bytevector 104 101 108 108 111)))
(check "u8->s/slice"   "el"     (utf8->string (bytevector 104 101 108 108 111) 1 3))
(check "s->u8/greek"   (bytevector #xCE #xBB)           (string->utf8 "\x03BB;"))
(check "s->u8/emoji"   (bytevector #xF0 #x9F #x98 #x80) (string->utf8 "\x1F600;"))
(check-true "u8->s/roundtrip-greek"
  (equal? (bytevector #xCE #xBB)
          (string->utf8 (utf8->string (bytevector #xCE #xBB)))))
(check "u8->s/strlen-greek"  1  (string-length (utf8->string (bytevector #xCE #xBB))))
(check "u8->s/ref-greek"
  (integer->char #x03BB)
  (string-ref (utf8->string (bytevector #xCE #xBB)) 0))
(u8-news "\n=== UTF-8 / Unicode TEST SUMMARY: ~a passed, ~a failed ===\n" *pass* *fail*)
(if (= *fail* 0)
  (u8-news "ALL TESTS PASSED\n")
  (u8-warn "~a TESTS FAILED (see B27 in proposal_bug_registry_P88.md)\n" *fail*))
(define utf8-pass *pass*)
(define utf8-fail *fail*)
;;; Copyright 2026 by Frobenius Norm LLC 2026-10-14
(define pass-count 0)
(define fail-count 0)
(define (check name expected actual)
  (if (equal? expected actual)
      (begin (set! pass-count (+ pass-count 1)) (printf "PASS ~a\n" name))
      (begin (set! fail-count (+ fail-count 1)) (printf "FAIL ~a expected=~a got=~a\n" name expected actual))))
(if (file-exists? "watcher.scm")
    (load "watcher.scm" 0)
    (printf "FAIL watcher.scm is not on this filesystem -- nothing below can run\n"))
(define watcher-tests-ready (defined? 'watcher-note!))
(check "watcher.scm loaded" #t watcher-tests-ready)
(define events (list))
(set! watcher-on-event (lambda (ev g conf) (set! events (cons (list ev g conf) events))))
(define (events-reset!) (set! events (list)))
(define (events-count) (length events))
(define (reset-all!) (watcher-reset!) (events-reset!)
  (vision-poll-group 'animal) (vision-poll-group 'person) (vision-poll-group 'vehicle))
(define ANIMAL (watcher-group-index 'animal))
(define PERSON (watcher-group-index 'person))
(printf "--- group indices ---\n")
(check "animal index"  0 ANIMAL)
(check "person index"  1 PERSON)
(check "vehicle index" 2 (watcher-group-index 'vehicle))
(check "a species group counts as animal" 0 (watcher-group-index 'deer))
(check "an unseen group counts as animal" 0 (watcher-group-index 'dog))
(printf "--- frame geometry ---\n")
(printf "cam_size is ~a, frame ~a\n" (watcher-cam-size) (watcher-frame-wh))
(check "frame is a two-element list" 2 (length (watcher-frame-wh)))
(printf "--- whole-frame classification, both arms ---\n")
(define wh (watcher-frame-wh))
(define frame-known (> (car wh) 0))
(if frame-known
    (begin
      (check "96% of the frame is suspect"  #t (watcher-whole-frame? 1567 1176))
      (check "0.8% of the frame is not"     #f (watcher-whole-frame? 119 135))
      (check "a hair over the threshold"     #t (watcher-whole-frame? 1518 1140))
      (check "just under the threshold"     #f (watcher-whole-frame? 1480 1110)))
    (printf "SKIP whole-frame: this target's cam_size is not in the geometry table\n"))
(printf "--- the per-group return channel ---\n")
(reset-all!)
(hud-car-handle-line! "(vision-id animal \"animal\" 72 100 100 200 180)")
(hud-car-handle-line! "(vision-id vehicle \"vehicle\" 26 18 0 1567 1176)")
(define got-animal (vision-poll-group 'animal))
(check "animal survives a later vehicle" 'animal (vision-group got-animal))
(check "animal confidence parsed"        72      (vision-conf  got-animal))
(check "animal box parsed"    (list 100 100 200 180) (vision-box got-animal))
(check "vehicle is still there"  'vehicle (vision-group (vision-poll-group 'vehicle)))
(check "animal slot is consumed"  #f (vision-poll-group 'animal))
(check "person was never set"     #f (vision-poll-group 'person))
(hud-car-handle-line! "(vision-id deer \"white-tailed deer\" 88 40 50 60 70)")
(define got-deer (vision-poll-group 'animal))
(check "a species record reaches the animal slot" 'deer (vision-group got-deer))
(check "the common name survives" "white-tailed deer" (vision-name got-deer))
(check "the species confidence survives" 88 (vision-conf got-deer))
(check "the species box survives" (list 40 50 60 70) (vision-box got-deer))
(check "a species record is not a person"  #f (vision-poll-group 'person))
(check "a species record is not a vehicle" #f (vision-poll-group 'vehicle))
(hud-car-handle-line! "(vision-id)")
(check "a groupless record files nowhere" #f (vision-poll-group 'animal))
(hud-car-handle-line! "(vision-id animal 72 10 10 20")
(check "a truncated line is ignored" #f (vision-poll-group 'animal))
(printf "--- the confidence floor, both arms ---\n")
(reset-all!)
(define below (- (watcher-min-conf) 1))
(define above (+ (watcher-min-conf) 1))
(watcher-note! ANIMAL (list 'vision-id 'animal "animal" below 10 10 20 20) 1000)
(check "weak record counted"      1 (watcher-get ANIMAL watcher-f-records))
(check "weak record is not a hit" 0 (watcher-get ANIMAL watcher-f-hits))
(check "weak record raises no event" 0 (events-count))
(watcher-note! ANIMAL (list 'vision-id 'animal "animal" above 10 10 20 20) 1100)
(check "strong record counted"    2 (watcher-get ANIMAL watcher-f-records))
(check "strong record is a hit"   1 (watcher-get ANIMAL watcher-f-hits))
(printf "--- confirmation, at n-1 and at n ---\n")
(reset-all!)
(define N (watcher-confirm-n))
(let loop ((k 1))
  (when (< k N)
    (watcher-note! ANIMAL (list 'vision-id 'animal "animal" 80 10 10 20 20) (* k 100))
    (loop (+ k 1))))
(check "n-1 sightings: not present" #f (watcher-present? ANIMAL))
(check "n-1 sightings: no event"    0  (events-count))
(watcher-note! ANIMAL (list 'vision-id 'animal "animal" 85 10 10 20 20) (* N 100))
(check "n sightings: present"       #t (watcher-present? ANIMAL))
(check "n sightings: one arrival"   1  (watcher-get ANIMAL watcher-f-arrivals))
(check "n sightings: one event"     1  (events-count))
(check "the event is an arrival" 'arrived (car (car events)))
(check "the event names the group" 'animal (cadr (car events)))
(check "best confidence is the best, not the last" 85 (watcher-get ANIMAL watcher-f-best))
(watcher-note! ANIMAL (list 'vision-id 'animal "animal" 90 10 10 20 20) (* N 200))
(check "still one arrival" 1 (watcher-get ANIMAL watcher-f-arrivals))
(check "still one event"   1 (events-count))
(printf "--- departure is a timeout, both arms ---\n")
(define t-last (watcher-get ANIMAL watcher-f-last))
(watcher-age! ANIMAL (+ t-last (- (watcher-clear-ms) 1)))
(check "inside the window: still present" #t (watcher-present? ANIMAL))
(check "inside the window: no new event"  1  (events-count))
(watcher-age! ANIMAL (+ t-last (watcher-clear-ms)))
(check "past the window: departed"       #f (watcher-present? ANIMAL))
(check "past the window: an event fired"  2 (events-count))
(check "the event is a departure" 'departed (car (car events)))
(check "hits reset by the lapse" 0 (watcher-get ANIMAL watcher-f-hits))
(printf "--- the whole-frame artefact does not confirm ---\n")
(when frame-known
  (reset-all!)
  (let loop ((k 0))
    (when (< k (+ N 3))
      (watcher-note! ANIMAL (list 'vision-id 'animal "animal" 95 18 0 1567 1176) (* (+ k 1) 100))
      (loop (+ k 1))))
  (check "artefacts counted as records" (+ N 3) (watcher-get ANIMAL watcher-f-records))
  (check "artefacts counted as suspect" (+ N 3) (watcher-get ANIMAL watcher-f-suspect))
  (check "artefacts are not hits"       0  (watcher-get ANIMAL watcher-f-hits))
  (check "artefacts do not arrive"      #f (watcher-present? ANIMAL))
  (check "artefacts raise no event"     0  (events-count)))
(printf "--- groups are independent ---\n")
(reset-all!)
(let loop ((k 0))
  (when (< k N)
    (watcher-note! PERSON (list 'vision-id 'person "person" 80 10 10 20 20) (* (+ k 1) 100))
    (loop (+ k 1))))
(check "person arrived" #t (watcher-present? PERSON))
(check "animal did not" #f (watcher-present? ANIMAL))
(check "animal has no records" 0 (watcher-get ANIMAL watcher-f-records))
(printf "--- the report names every group ---\n")
(define rep (watcher-report))
(check "report is a list" #t (list? rep))
(check "report is tagged" 'watcher (car rep))
(reset-all!)
(printf "Total: ~a pass, ~a fail\n" pass-count fail-count)
(printf "--- the next check is [B855]: on an affected board the runtime stops HERE ---\n")
(hud-car-handle-line! "(vision-id animal \"anim")
(check "an unterminated string literal is ignored [B855]" #f (vision-poll-group 'animal))
(printf "B855 total: ~a pass, ~a fail\n" pass-count fail-count)
